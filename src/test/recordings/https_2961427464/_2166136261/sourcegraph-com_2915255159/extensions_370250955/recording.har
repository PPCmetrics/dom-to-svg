InSublime.open.file\\\",\\n        \\\"commandArguments\\\": [\\n          \\\"${resource.uri}\\\"\\n        ],\\n        \\\"id\\\": \\\"openInSublime.open.file\\\",\\n        \\\"title\\\": \\\"Open file in Sublime Text\\\"\\n      }\\n    ],\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"openInSublime.basePath\\\": {\\n          \\\"description\\\": \\\"The absolute path on the machine to the folder that is expected to contain all repositories.\\\",\\n          \\\"format\\\": \\\"regex\\\",\\n          \\\"pattern\\\": \\\"^[^~]+\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        }\\n      }\\n    },\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [\\n        {\\n          \\\"action\\\": \\\"openInSublime.open.file\\\",\\n          \\\"when\\\": \\\"resource.type === 'textDocument'\\\"\\n        }\\n      ],\\n      \\\"editor/title\\\": [\\n        {\\n          \\\"action\\\": \\\"openInSublime.open.file\\\",\\n          \\\"when\\\": \\\"resource.type === 'textDocument'\\\"\\n        }\\n      ]\\n    }\\n  },\\n  \\\"description\\\": \\\"Open the current file in Sublime Text\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/eslint-config\\\": \\\"^0.20.0\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^4.0.1\\\",\\n    \\\"@types/node\\\": \\\"14.0.27\\\",\\n    \\\"eslint\\\": \\\"^7.6.0\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^1.0.4\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.12.4\\\",\\n    \\\"sourcegraph\\\": \\\"^24.7.0\\\",\\n    \\\"typescript\\\": \\\"^3.9.7\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/open-in-sublime\\\",\\n  \\\"icon\\\": \\\"data:image/svg+xml,%3Csvg viewBox='26.6 26.6 446.8 446.7' xmlns='http://www.w3.org/2000/svg' width='64' height='64'%3E%3ClinearGradient id='a' gradientUnits='userSpaceOnUse' x1='136.178' x2='372.681' y1='369.638' y2='287.81'%3E%3Cstop offset='.233' stop-color='%23f89822'/%3E%3Cstop offset='1' stop-color='%23c27818'/%3E%3C/linearGradient%3E%3Cpath d='M456.1 473.3H43.9c-9.5 0-17.3-7.8-17.3-17.3V43.9c0-9.5 7.8-17.3 17.3-17.3h412.2c9.5 0 17.3 7.8 17.3 17.3v412.2c-.1 9.5-7.8 17.2-17.3 17.2z' fill='%234d4d4e'/%3E%3Cpath d='M129.6 161.5l233.8-74.2s16.6-8.7 12.6 7.4l.6 71.5s2.9 10.5-11.5 13.1l-95 29.7z' fill='%23f89820'/%3E%3Cpath d='M129.6 161.5s-9.2 2.2-6.5 17.9l-.5 68.9s-.8 8.7 15.7 12.2L370 335.1s7.8 3.1 6.9-6.5l.1-76.8s2.2-7.9-12.2-13.1L270.1 209z' fill='%23f89820'/%3E%3Cpath d='M231.7 290.5l-98.6 30.1s-11.9.4-10.5 22.7-.1 67.2-.1 67.2 1 8.3 12.4 3.5l233.8-74.6s8.3-2.1 1.3-4.4c-7-2.2-138.3-44.5-138.3-44.5z' fill='url(%23a)'/%3E%3C/svg%3E\\\",\\n  \\\"license\\\": \\\"Apache-2.0\\\",\\n  \\\"main\\\": \\\"dist/open-in-sublime.js\\\",\\n  \\\"name\\\": \\\"open-in-sublime\\\",\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Open in Sublime Sourcegraph extension\\\\n\\\\nAdds a button at the top of files in both Sourcegraph app and code hosts like GitHub (when the Sourcegraph browser extension is installed) that will open the current file in Sublime Text.\\\\n\\\\n\\\\u003cpicture\\\\u003e\\\\n\\\\u003csource srcset=\\\\\\\"https://user-images.githubusercontent.com/37420160/96816775-e9760400-13eb-11eb-812f-85046bd4db6d.png\\\\\\\" media=\\\\\\\"(prefers-color-scheme: dark)\\\\\\\" /\\\\u003e\\\\n\\\\u003csource srcset=\\\\\\\"https://user-images.githubusercontent.com/37420160/96816847-0ad6f000-13ec-11eb-9ef8-b1c3b2009a4d.png\\\\\\\" media=\\\\\\\"(prefers-color-scheme: light)\\\\\\\" /\\\\u003e\\\\n\\\\u003cimg src=\\\\\\\"https://user-images.githubusercontent.com/37420160/96816847-0ad6f000-13ec-11eb-9ef8-b1c3b2009a4d.png\\\\\\\" alt=\\\\\\\"Screenshot\\\\\\\" /\\\\u003e\\\\n\\\\u003c/picture\\\\u003e\\\\n\\\\n## Settings\\\\n\\\\n- `openInSublime.basePath`: The absolute path on your computer where your git repositories live. This extension requires all git repos to be already cloned under this path with their original names. `\\\\\\\"/Users/yourusername/src\\\\\\\"` is a valid absolute path, while `\\\\\\\"~/src\\\\\\\"` is not.\\\\n\\\\nSublime Text requires a URL handler installed such as [this one for macOS](https://github.com/inopinatus/sublime_url).\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/sourcegraph/sourcegraph-open-in-sublime\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/open-in-sublime.js src/open-in-sublime.ts\\\",\\n    \\\"eslint\\\": \\\"eslint 'src/**/*.ts'\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --out-file dist/open-in-sublime.js src/open-in-sublime.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run typecheck \\\\u0026\\\\u0026 yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"mkdirp dist \\\\u0026\\\\u0026 lnfs ./package.json ./dist/package.json\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"tags\\\": [\\n    \\\"sublime\\\",\\n    \\\"editor\\\",\\n    \\\"open\\\"\\n  ],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/8880-sourcegraph-open-in-sublime.js?c6kcyurst11k--sourcegraph-open-in-sublime\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\",\\n  \\\"wip\\\": false\\n}\",\"description\":\"Open the current file in Sublime Text\"},\"createdAt\":\"2020-10-22T02:26:25Z\",\"updatedAt\":\"2020-10-22T02:26:25Z\",\"url\":\"/extensions/sourcegraph/open-in-sublime\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyOTd9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjIyMDc=\",\"name\":\"medical-home\",\"displayName\":\"Medical Home Associates \",\"url\":\"/organizations/medical-home\"},\"extensionID\":\"medical-home/medicalhome\",\"extensionIDWithoutRegistry\":\"medical-home/medicalhome\",\"name\":\"medicalhome\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9216-medical-home-medicalhome.js?c7aarfsadwug--medical-home-medicalhome\\\"\\n}\",\"description\":null},\"createdAt\":\"2020-10-23T01:12:25Z\",\"updatedAt\":\"2020-10-23T01:12:34Z\",\"url\":\"/extensions/medical-home/medicalhome\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjozMDJ9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjoyMTMyNg==\",\"username\":\"kadirselcuk\",\"displayName\":\"devturks-team\",\"url\":\"/users/kadirselcuk\"},\"extensionID\":\"kadirselcuk/devturks\",\"extensionIDWithoutRegistry\":\"kadirselcuk/devturks\",\"name\":\"devturks\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/8928-kadirselcuk-devturks.js?c6r6u4w6vpyw--kadirselcuk-devturks\\\"\\n}\",\"description\":null},\"createdAt\":\"2020-10-27T21:41:58Z\",\"updatedAt\":\"2020-10-27T21:41:58Z\",\"url\":\"/extensions/kadirselcuk/devturks\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjozMDR9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjoyMTMyNg==\",\"username\":\"kadirselcuk\",\"displayName\":\"devturks-team\",\"url\":\"/users/kadirselcuk\"},\"extensionID\":\"kadirselcuk/DevTurks-Team\",\"extensionIDWithoutRegistry\":\"kadirselcuk/DevTurks-Team\",\"name\":\"DevTurks-Team\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/8926-kadirselcuk-DevTurks-Team.js?c6powrb9vznk--kadirselcuk-DevTurks-Team\\\"\\n}\",\"description\":null},\"createdAt\":\"2020-10-29T21:24:05Z\",\"updatedAt\":\"2020-10-29T21:24:05Z\",\"url\":\"/extensions/kadirselcuk/DevTurks-Team\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjozMTF9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjoyNTc5OA==\",\"username\":\"vonhayden154\",\"displayName\":null,\"url\":\"/users/vonhayden154\"},\"extensionID\":\"vonhayden154/PortaProxyHTML\",\"extensionIDWithoutRegistry\":\"vonhayden154/PortaProxyHTML\",\"name\":\"PortaProxyHTML\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9142-vonhayden154-PortaProxyHTML.js?c6yxo3gs4luo--vonhayden154-PortaProxyHTML\\\"\\n}\",\"description\":null},\"createdAt\":\"2020-11-09T18:04:43Z\",\"updatedAt\":\"2020-11-09T18:04:43Z\",\"url\":\"/extensions/vonhayden154/PortaProxyHTML\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjozMjJ9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjoyNjAzMA==\",\"username\":\"1982kevin\",\"displayName\":\"1982kevin\",\"url\":\"/users/1982kevin\"},\"extensionID\":\"1982kevin/cocolo2\",\"extensionIDWithoutRegistry\":\"1982kevin/cocolo2\",\"name\":\"cocolo2\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9214-1982kevin-cocolo2.js?c79hho4bcg74--1982kevin-cocolo2\\\"\\n}\",\"description\":null},\"createdAt\":\"2020-11-22T02:11:16Z\",\"updatedAt\":\"2020-11-22T02:11:16Z\",\"url\":\"/extensions/1982kevin/cocolo2\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjozMjR9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjoyNjI3MQ==\",\"username\":\"tar27005\",\"displayName\":null,\"url\":\"/users/tar27005\"},\"extensionID\":\"tar27005/tartar27005\",\"extensionIDWithoutRegistry\":\"tar27005/tartar27005\",\"name\":\"tartar27005\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9218-tar27005-tartar27005.js?c7f8n2aao1mg--tar27005-tartar27005\\\"\\n}\",\"description\":null},\"createdAt\":\"2020-11-28T22:08:24Z\",\"updatedAt\":\"2020-11-28T22:09:00Z\",\"url\":\"/extensions/tar27005/tartar27005\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjozNn0=\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/code-discussions\",\"extensionIDWithoutRegistry\":\"sourcegraph/code-discussions\",\"name\":\"code-discussions\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [\\n      {\\n        \\\"actionItem\\\": {\\n          \\\"description\\\": \\\"${config.discussions.decorations.inline \\\\u0026\\\\u0026 \\\\\\\"Hide\\\\\\\" || \\\\\\\"Show\\\\\\\"} inline discussions\\\",\\n          \\\"label\\\": \\\"Discussions\\\",\\n          \\\"pressed\\\": \\\"config.discussions.decorations.inline\\\"\\n        },\\n        \\\"category\\\": \\\"Discussions\\\",\\n        \\\"command\\\": \\\"updateConfiguration\\\",\\n        \\\"commandArguments\\\": [\\n          [\\n            \\\"discussions.decorations.inline\\\"\\n          ],\\n          \\\"${!config.discussions.decorations.inline}\\\",\\n          null,\\n          \\\"json\\\"\\n        ],\\n        \\\"id\\\": \\\"discussions.decorations.toggle\\\",\\n        \\\"title\\\": \\\"${config.discussions.decorations.inline \\\\u0026\\\\u0026 \\\\\\\"Hide\\\\\\\" || \\\\\\\"Show\\\\\\\"} inline discussions on file\\\"\\n      }\\n    ],\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"discussions.decorations.inline\\\": {\\n          \\\"default\\\": true,\\n          \\\"description\\\": \\\"Whether or not to display discussions inline.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"discussions.hideDiscussionsButton\\\": {\\n          \\\"default\\\": false,\\n          \\\"description\\\": \\\"Whether to hide the discussions item in the toolbar (in a button labeled \\\\\\\"inline discussions\\\\\\\").\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Code discussions settings\\\"\\n    },\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [\\n        {\\n          \\\"action\\\": \\\"discussions.decorations.toggle\\\",\\n          \\\"when\\\": \\\"resource\\\"\\n        },\\n        {\\n          \\\"action\\\": \\\"discussions.link.fileList\\\",\\n          \\\"when\\\": \\\"resource \\\\u0026\\\\u0026 get(context, `discussions.fileURL.${resource.uri}`)\\\"\\n        },\\n        {\\n          \\\"action\\\": \\\"discussions.help\\\"\\n        }\\n      ],\\n      \\\"editor/title\\\": [\\n        {\\n          \\\"action\\\": \\\"discussions.decorations.toggle\\\",\\n          \\\"alt\\\": \\\"discussions.link.fileList\\\",\\n          \\\"when\\\": \\\"resource \\\\u0026\\\\u0026 !config.discussions.hideDiscussionsButton\\\"\\n        }\\n      ],\\n      \\\"help\\\": [\\n        {\\n          \\\"action\\\": \\\"discussions.help\\\"\\n        }\\n      ]\\n    }\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"@types/date-fns\\\": \\\"^2.6.0\\\",\\n    \\\"date-fns\\\": \\\"^1.29.0\\\"\\n  },\\n  \\\"description\\\": \\\"Lets you write comments on code while browsing, discover discussions while browsing on GitHub, review code continuously, and share knowledge with your team.\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/prettierrc\\\": \\\"^2.1.1\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^4.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^12.3.1\\\",\\n    \\\"get-graphql-schema\\\": \\\"^2.1.1\\\",\\n    \\\"gql2ts\\\": \\\"^1.8.2\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^0.5.1\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.12.4\\\",\\n    \\\"prettier\\\": \\\"1.16.4\\\",\\n    \\\"sourcegraph\\\": \\\"^23.0.0\\\",\\n    \\\"tslint\\\": \\\"^5.10.0\\\",\\n    \\\"typescript\\\": \\\"^3.3.3333\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/code-discussions\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"code-discussions\\\",\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Sourcegraph code discussions\\\\n\\\\nDiscuss code contextually, review code continuously.\\\\n\\\\n- 🖥️ Write comments on code while browsing on Sourcegraph.com.\\\\n- 🧠 Discover discussions and existing knowledge on GitHub \\\\u0026 Sourcegraph while browsing code.\\\\n- 🤔 Review code continuously, not just in Pull Requests.\\\\n- 🤲 Share knowledge \\\\u0026 help unblock team members.\\\\n\\\\n## ⚡ Experimental warning\\\\n\\\\nCode discussions is an experiment [by Sourcegraph](https://about.sourcegraph.com/about). It is not yet ready for widespread production use.\\\\n\\\\nIf you're as excited about improving how code is discussed as much as we are, then please try it out, [give us feedback and file issues](https://github.com/sourcegraph/issues/issues), and reach out to us (hi@sourcegraph.com). We'd love to hear from you!\\\\n\\\\n## GitHub integration\\\\n\\\\nThis shows how you can view previously created discussions on GitHub.com while browsing code:\\\\n\\\\n![demo](https://github.com/sourcegraph/sourcegraph-extension-discussions/raw/master/demo.gif)\\\\n\\\\n\\\\u003e Note: Clicking them will bring you to Sourcegraph, it is not yet possible to create or reply to discussions on GitHub itself. We hope to support this soon.\\\\n\\\\n## Getting started\\\\n\\\\n1.  [Set up a Sourcegraph server](https://about.sourcegraph.com/docs) (soon you will be able to use this on open source repositories via Sourcegraph.com).\\\\n2.  Visit the **extensions** page (link in the top right / navbar of Sourcegraph) and enable this extension.\\\\n3.  Visit any file in any repository, select a line by clicking it and then create a discussion by clicking the chat icon that appears.\\\\n\\\\nFor the GitHub integration:\\\\n\\\\n1.  Install [Sourcegraph for Chrome](https://chrome.google.com/webstore/detail/sourcegraph/dgjhfomjieaadpoljlnidmbgkdffpack) or [Sourcegraph for Firefox](https://addons.mozilla.org/en-US/firefox/addon/sourcegraph/)\\\\n2.  Open the Sourcegraph for Chrome/Firefox extension options page (by clicking the Sourcegraph icon in the browser toolbar)\\\\n3.  Check the box labeled **Use Sourcegraph extensions** (required while this feature is in alpha)\\\\n\\\\n## Coming soon: Visual Studio Code integration\\\\n\\\\nThis shows how you can view, create, and reply to discussions right from your editor:\\\\n\\\\n![demo-vscode](https://user-images.githubusercontent.com/3173176/45849482-f85acb80-bce6-11e8-89a6-dd6d72a78383.gif)\\\\n\\\\n\\\\u003e Note: This integration is not yet released. See [sourcegraph/sourcegraph-vscode#15](https://github.com/sourcegraph/sourcegraph-vscode/pull/15) for tracking this integration.\\\\n\\\",\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"graphql\\\": \\\"get-graphql-schema https://sourcegraph.com/.api/graphql --json | gql2ts -n SourcegraphGQL -o src/typings/SourcegraphGQL.d.ts\\\",\\n    \\\"prettier\\\": \\\"prettier \\\\\\\"**/*.{ts,js,json,md}\\\\\\\" --list-different --write\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"parcel build src/extension.ts\\\",\\n    \\\"symlink-package\\\": \\\"mkdirp dist \\\\u0026\\\\u0026 lnfs ./package.json ./dist/package.json\\\",\\n    \\\"tslint\\\": \\\"tslint \\\\\\\"src/**.ts\\\\\\\" --project tsconfig.json --config tslint.json\\\",\\n    \\\"watch\\\": \\\"tsc -w -p .\\\"\\n  },\\n  \\\"title\\\": \\\"Code discussions — discuss code contextually, review code continuously.\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/6287-sourcegraph-code-discussions.js?c2o6lcecasq8--sourcegraph-code-discussions\\\",\\n  \\\"wip\\\": true\\n}\",\"description\":\"Lets you write comments on code while browsing, discover discussions while browsing on GitHub, review code continuously, and share knowledge with your team.\"},\"createdAt\":\"2018-09-20T20:21:41Z\",\"updatedAt\":\"2018-09-20T20:21:41Z\",\"url\":\"/extensions/sourcegraph/code-discussions\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjozN30=\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjoyMTIw\",\"username\":\"chris\",\"displayName\":\"Chris Wendt\",\"url\":\"/users/chris\"},\"extensionID\":\"chris/graphql\",\"extensionIDWithoutRegistry\":\"chris/graphql\",\"name\":\"graphql\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"dependencies\\\": {\\n    \\\"@sourcegraph/prettierrc\\\": \\\"^2.2.0\\\",\\n    \\\"rxjs\\\": \\\"^6.3.2\\\",\\n    \\\"vscode-ws-jsonrpc\\\": \\\"^0.0.1-alpha.5\\\"\\n  },\\n  \\\"description\\\": \\\"GraphQL code intelligence.\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"parcel-bundler\\\": \\\"^1.10.0\\\",\\n    \\\"sourcegraph\\\": \\\"^20.1.0\\\",\\n    \\\"typescript\\\": \\\"^3.0.3\\\"\\n  },\\n  \\\"extensionID\\\": \\\"chris/graphql\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"graphql\\\",\\n  \\\"publisher\\\": \\\"chris\\\",\\n  \\\"readme\\\": \\\"# GraphQL Sourcegraph Extension\\\\n\\\\nA [Sourcegraph extension](https://docs.sourcegraph.com/extensions) for GraphQL code intelligence.\\\\n\\\\n[**➕ Add to Sourcegraph**](https://sourcegraph.com/extensions/chris/graphql)\\\\n\\\\nYou'll also need the server to be running on your machine: https://github.com/chrismwendt/graphql-ws-langserver\\\\n\\\\nSource code on GitHub: https://github.com/sourcegraph/sourcegraph-graphql\\\\n\\\\n![demo](https://user-images.githubusercontent.com/1387653/45993536-44d63c00-c044-11e8-8ac7-814165d3aecf.gif)\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/sourcegraph/sourcegraph-graphql.git\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"sourcegraph:prepublish\\\": \\\"parcel build src/extension.ts\\\"\\n  },\\n  \\\"title\\\": \\\"WIP: GraphQL\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/2881-chris-graphql.js?bv9u6vsv14qw--chris-graphql\\\"\\n}\",\"description\":\"GraphQL code intelligence.\"},\"createdAt\":\"2018-09-25T00:38:54Z\",\"updatedAt\":\"2018-09-25T00:38:54Z\",\"url\":\"/extensions/chris/graphql\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo0MX0=\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjozMDYw\",\"username\":\"seppestas\",\"displayName\":null,\"url\":\"/users/seppestas\"},\"extensionID\":\"seppestas/kicad-fileviewer\",\"extensionIDWithoutRegistry\":\"seppestas/kicad-fileviewer\",\"name\":\"kicad-fileviewer\",\"manifest\":null,\"createdAt\":\"2018-10-02T13:44:43Z\",\"updatedAt\":\"2018-10-02T13:44:43Z\",\"url\":\"/extensions/seppestas/kicad-fileviewer\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo0NH0=\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjozNDE0\",\"username\":\"liamzebedee\",\"displayName\":null,\"url\":\"/users/liamzebedee\"},\"extensionID\":\"liamzebedee/talkthrough\",\"extensionIDWithoutRegistry\":\"liamzebedee/talkthrough\",\"name\":\"talkthrough\",\"manifest\":null,\"createdAt\":\"2018-10-15T18:56:48Z\",\"updatedAt\":\"2018-10-15T18:56:48Z\",\"url\":\"/extensions/liamzebedee/talkthrough\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo0NX0=\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjozMzkz\",\"username\":\"Shobeir\",\"displayName\":null,\"url\":\"/users/Shobeir\"},\"extensionID\":\"Shobeir/AVA\",\"extensionIDWithoutRegistry\":\"Shobeir/AVA\",\"name\":\"AVA\",\"manifest\":null,\"createdAt\":\"2018-10-15T22:08:44Z\",\"updatedAt\":\"2018-10-15T22:09:36Z\",\"url\":\"/extensions/Shobeir/AVA\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo3NH0=\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjozNTcw\",\"username\":\"stackflow1\",\"displayName\":null,\"url\":\"/users/stackflow1\"},\"extensionID\":\"stackflow1/javqa\",\"extensionIDWithoutRegistry\":\"stackflow1/javqa\",\"name\":\"javqa\",\"manifest\":null,\"createdAt\":\"2018-10-28T19:06:07Z\",\"updatedAt\":\"2018-10-28T19:06:07Z\",\"url\":\"/extensions/stackflow1/javqa\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo4Mn0=\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/python-imports-search\",\"extensionIDWithoutRegistry\":\"sourcegraph/python-imports-search\",\"name\":\"python-imports-search\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [],\\n    \\\"configuration\\\": {},\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [],\\n      \\\"editor/title\\\": []\\n    }\\n  },\\n  \\\"dependencies\\\": {},\\n  \\\"description\\\": \\\"Lets you easily search for all files using a python module. Adds a new operator `py.imports:` for all import statements of the module passed to the operator. This extension also adds a \\\\\\\"See all usages\\\\\\\" link at the end of import statement lines, which will execute the `py.imports` search for the relevant module.\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/prettierrc\\\": \\\"^3.0.1\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^4.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^13.4.0\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^0.5.1\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.10.3\\\",\\n    \\\"rxjs\\\": \\\"^6.5.3\\\",\\n    \\\"sourcegraph\\\": \\\"23.0.1\\\",\\n    \\\"tslint\\\": \\\"^5.11.0\\\",\\n    \\\"typescript\\\": \\\"^3.7.3\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/python-imports-search\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/python-imports-search.js\\\",\\n  \\\"name\\\": \\\"python-imports-search\\\",\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Python imports search\\\\n\\\\nLets you easily search for all files using a python module. Adds a new operator `py.imports:` for all import statements of the module passed to the operator.\\\\n\\\\nNOTE: regular expression search mode is required for the `py.imports` keyword to work. The extension automatically appends `patternType:regexp` to queries containing `py.imports`.\\\\n\\\\nThis extension also adds a \\\\\\\\\\\\\\\"See all usages\\\\\\\\\\\\\\\" link at the end of import statement lines, which will execute the `py.imports` search for the relevant module. To enable \\\\\\\"See all usages\\\\\\\" links, add `\\\\\\\"pyImports.showAllUsagesLinks\\\\\\\": true` to your user settings.\\\\n\\\\n## Prerequisites\\\\n\\\\nSourcegraph extensions are written in TypeScript and are distributed as bundled JavaScript files that run on the client. For creation, publishing, and viewing, you need:\\\\n\\\\n-   **Creation**: Install [Node.js](https://nodejs.org).\\\\n-   **Publishing**: Install the [Sourcegraph CLI (`src`)](https://github.com/sourcegraph/src-cli#installation) and create a [Sourcegraph.com account](https://sourcegraph.com/sign-up).\\\\n-   **Viewing**: Install the Sourcegraph extension for [Chrome](https://chrome.google.com/webstore/detail/sourcegraph/dgjhfomjieaadpoljlnidmbgkdffpack) or [Firefox](https://addons.mozilla.org/en-US/firefox/addon/sourcegraph/).\\\\n\\\\n## Set up\\\\n\\\\n```\\\\nnpm install\\\\n```\\\\n\\\\n## Lint and type check\\\\n\\\\n```\\\\nnpm run tslint\\\\nnpm run typecheck\\\\n```\\\\n\\\\n## Publish\\\\n\\\\n```\\\\nsrc extensions publish\\\\n```\\\\n\\\\n## Sourecgraph extension API\\\\n\\\\nVisit the [Sourcegraph extension documentation](https://github.com/sourcegraph/sourcegraph-extension-docs) and check out some [Sourcegraph extension samples](https://github.com/sourcegraph/sourcegraph-extension-samples).\\\\n\\\",\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/python-imports-search.js src/python-imports-search.ts\\\",\\n    \\\"serve\\\": \\\"npm run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --out-file dist/python-imports-search.js src/python-imports-search.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run build\\\",\\n    \\\"symlink-package\\\": \\\"mkdirp dist \\\\u0026\\\\u0026 lnfs ./package.json ./dist/package.json\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"title\\\": \\\"WIP: Python imports search\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/3221-sourcegraph-python-imports-search.js?bz9mgwaym1nk--sourcegraph-python-imports-search\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Lets you easily search for all files using a python module. Adds a new operator `py.imports:` for all import statements of the module passed to the operator. This extension also adds a \\\"See all usages\\\" link at the end of import statement lines, which will execute the `py.imports` search for the relevant module.\"},\"createdAt\":\"2018-10-29T22:51:45Z\",\"updatedAt\":\"2018-10-29T22:51:45Z\",\"url\":\"/extensions/sourcegraph/python-imports-search\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo5MH0=\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjozNzEz\",\"username\":\"drbh\",\"displayName\":null,\"url\":\"/users/drbh\"},\"extensionID\":\"drbh/pii\",\"extensionIDWithoutRegistry\":\"drbh/pii\",\"name\":\"pii\",\"manifest\":null,\"createdAt\":\"2018-11-02T06:48:13Z\",\"updatedAt\":\"2018-11-02T06:48:13Z\",\"url\":\"/extensions/drbh/pii\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo5NX0=\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjozOTIx\",\"username\":\"kevdev\",\"displayName\":null,\"url\":\"/users/kevdev\"},\"extensionID\":\"kevdev/pqsql\",\"extensionIDWithoutRegistry\":\"kevdev/pqsql\",\"name\":\"pqsql\",\"manifest\":null,\"createdAt\":\"2018-11-12T16:14:56Z\",\"updatedAt\":\"2018-11-12T16:14:56Z\",\"url\":\"/extensions/kevdev/pqsql\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxMDF9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjo0MDE0\",\"username\":\"rajat80036\",\"displayName\":null,\"url\":\"/users/rajat80036\"},\"extensionID\":\"rajat80036/rajat800\",\"extensionIDWithoutRegistry\":\"rajat80036/rajat800\",\"name\":\"rajat800\",\"manifest\":null,\"createdAt\":\"2018-11-16T11:36:42Z\",\"updatedAt\":\"2018-11-16T11:36:42Z\",\"url\":\"/extensions/rajat80036/rajat800\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxMTJ9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjozNTAw\",\"username\":\"tsenart\",\"displayName\":\"Tomás Senart\",\"url\":\"/users/tsenart\"},\"extensionID\":\"tsenart/wip-tsenart-graphql\",\"extensionIDWithoutRegistry\":\"tsenart/wip-tsenart-graphql\",\"name\":\"wip-tsenart-graphql\",\"manifest\":{\"raw\":\"{\\\"nyc\\\": {\\\"cache\\\": true, \\\"exclude\\\": [\\\"**/*.d.ts\\\", \\\"**/*.test.ts\\\", \\\"**/*.js\\\"], \\\"reporter\\\": [\\\"text\\\", \\\"lcovonly\\\"], \\\"extension\\\": [\\\".ts\\\"]}, \\\"url\\\": \\\"http://localhost:1234/extension.js\\\", \\\"main\\\": \\\"dist/extension.js\\\", \\\"name\\\": \\\"wip-tsenart-graphql\\\", \\\"files\\\": [\\\"dist\\\"], \\\"title\\\": \\\"[WIP] GraphQL code intelligence\\\", \\\"readme\\\": \\\"# Basic code intelligence for Sourcegraph\\\\n\\\\nA [Sourcegraph extension](https://docs.sourcegraph.com/extensions) that provides code intelligence (go-to-definition and find-references) for all languages using text-search-based heuristics.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/sourcegraph-basic-code-intel)\\\\n\\\\n[**➕ Add to Sourcegraph**](https://sourcegraph.com/extensions/sourcegraph/basic-code-intel)\\\\n\\\\nFeatures:\\\\n\\\\n- Toggle between **Precise** and **Fuzzy** code intelligence (in precise mode, this extension is disabled, and only precise results from language servers are used)\\\\n- **Go to definition**\\\\n- **Find references**\\\\n\\\\n\\\", \\\"license\\\": \\\"MIT\\\", \\\"scripts\\\": {\\\"test\\\": \\\"TS_NODE_COMPILER_OPTIONS='{\\\\\\\"module\\\\\\\":\\\\\\\"commonjs\\\\\\\"}' mocha --require ts-node/register --require source-map-support/register --opts mocha.opts\\\", \\\"build\\\": \\\"parcel build --no-minify --detailed-report --out-file extension.js src/extension.ts\\\", \\\"cover\\\": \\\"TS_NODE_COMPILER_OPTIONS='{\\\\\\\"module\\\\\\\":\\\\\\\"commonjs\\\\\\\"}' nyc --require ts-node/register --require source-map-support/register --all mocha --opts mocha.opts --timeout 10000\\\", \\\"serve\\\": \\\"parcel serve --no-hmr --out-file extension.js src/extension.ts\\\", \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\", \\\"prettier\\\": \\\"prettier '**/*.{js?(on),ts}' --write --list-different\\\", \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\", \\\"watch:test\\\": \\\"npm run test -- -w\\\", \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\", \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\", \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\"}, \\\"version\\\": \\\"0.0.0-development\\\", \\\"publisher\\\": \\\"tsenart\\\", \\\"contributes\\\": {\\\"configuration\\\": {\\\"title\\\": \\\"GraphQL code intelligence settings\\\", \\\"properties\\\": {}}}, \\\"description\\\": \\\"Provides code intelligence on GraphQL queries\\\", \\\"extensionID\\\": \\\"tsenart/wip-tsenart-graphql\\\", \\\"sideEffects\\\": false, \\\"browserslist\\\": [\\\"last 1 Chrome versions\\\", \\\"last 1 Firefox versions\\\", \\\"last 1 Edge versions\\\", \\\"last 1 Safari versions\\\"], \\\"dependencies\\\": {}, \\\"devDependencies\\\": {\\\"nyc\\\": \\\"^12.0.2\\\", \\\"mocha\\\": \\\"^5.2.0\\\", \\\"tslint\\\": \\\"^5.11.0\\\", \\\"ts-node\\\": \\\"^7.0.1\\\", \\\"prettier\\\": \\\"^1.14.2\\\", \\\"typescript\\\": \\\"^2.9.2\\\", \\\"@types/node\\\": \\\"^10.9.4\\\", \\\"sourcegraph\\\": \\\"^17.1.0\\\", \\\"@types/mocha\\\": \\\"^5.2.3\\\", \\\"parcel-bundler\\\": \\\"^1.10.0\\\", \\\"source-map-support\\\": \\\"^0.5.9\\\", \\\"tslint-language-service\\\": \\\"^0.9.9\\\"}, \\\"activationEvents\\\": [\\\"*\\\"]}\",\"description\":\"Provides code intelligence on GraphQL queries\"},\"createdAt\":\"2018-11-29T00:46:20Z\",\"updatedAt\":\"2018-11-29T00:46:20Z\",\"url\":\"/extensions/tsenart/wip-tsenart-graphql\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxMTN9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjo0\",\"username\":\"dadlerj\",\"displayName\":\"Dan Adler\",\"url\":\"/users/dadlerj\"},\"extensionID\":\"dadlerj/sourcegraph-contributors-extension\",\"extensionIDWithoutRegistry\":\"dadlerj/sourcegraph-contributors-extension\",\"name\":\"sourcegraph-contributors-extension\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [\\n      {\\n        \\\"actionItem\\\": {\\n          \\\"description\\\": \\\"Show top contributors to this file\\\",\\n          \\\"label\\\": \\\"Contributors\\\"\\n        },\\n        \\\"category\\\": \\\"Contributors\\\",\\n        \\\"command\\\": \\\"openPanel\\\",\\n        \\\"commandArguments\\\": [\\n          \\\"contributors.panel\\\"\\n        ],\\n        \\\"id\\\": \\\"contributors.openPanel\\\",\\n        \\\"title\\\": \\\"Show contributors\\\"\\n      }\\n    ],\\n    \\\"configuration\\\": {},\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [\\n        {\\n          \\\"action\\\": \\\"contributors.openPanel\\\",\\n          \\\"when\\\": \\\"resource\\\"\\n        }\\n      ],\\n      \\\"directory/page\\\": [\\n        {\\n          \\\"action\\\": \\\"contributors.openPanel\\\",\\n          \\\"when\\\": \\\"resource\\\"\\n        }\\n      ],\\n      \\\"editor/title\\\": [\\n        {\\n          \\\"action\\\": \\\"contributors.openPanel\\\",\\n          \\\"when\\\": \\\"resource \\\\u0026\\\\u0026 config.contributors.showInEditorTitle\\\"\\n        }\\n      ]\\n    },\\n    \\\"views\\\": {\\n      \\\"window/panel\\\": [\\n        {\\n          \\\"id\\\": \\\"contributors.panel\\\"\\n        }\\n      ]\\n    }\\n  },\\n  \\\"description\\\": \\\"Displays a bar chart showing the top contributors to a file.\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^3.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^12.1.0\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.10.3\\\",\\n    \\\"sourcegraph\\\": \\\"^19.2.0\\\",\\n    \\\"tslint\\\": \\\"^5.11.0\\\",\\n    \\\"typescript\\\": \\\"^3.1.6\\\"\\n  },\\n  \\\"extensionID\\\": \\\"dadlerj/sourcegraph-contributors-extension\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/sourcegraph-contributors-extension.js\\\",\\n  \\\"name\\\": \\\"sourcegraph-contributors-extension\\\",\\n  \\\"publisher\\\": \\\"dadlerj\\\",\\n  \\\"readme\\\": \\\"# Contributors Chart Demo\\\\n\\\\nRenders a chart showing top contributors to a file in a new panel.\\\\n\\\\n## Prerequisites\\\\n\\\\nSourcegraph extensions are written in TypeScript and are distributed as bundled JavaScript files that run on the client. For creation, publishing, and viewing, you need:\\\\n\\\\n- **Creation**: Install [Node.js](https://nodejs.org).\\\\n- **Publishing**: Install the [Sourcegraph CLI (`src`)](https://github.com/sourcegraph/src-cli#installation) and create a [Sourcegraph.com account](https://sourcegraph.com/sign-up).\\\\n- **Viewing**: Install the Sourcegraph extension for [Chrome](https://chrome.google.com/webstore/detail/sourcegraph/dgjhfomjieaadpoljlnidmbgkdffpack) or [Firefox](https://addons.mozilla.org/en-US/firefox/addon/sourcegraph/).\\\\n\\\\n## Set up\\\\n\\\\n```\\\\nnpm install\\\\n```\\\\n\\\\n## Lint and type check\\\\n\\\\n```\\\\nnpm run tslint\\\\nnpm run typecheck\\\\n```\\\\n\\\\n## Publish\\\\n\\\\n```\\\\nsrc extensions publish\\\\n```\\\\n\\\\n## Sourecgraph extension API\\\\n\\\\nVisit the [Sourcegraph extension documentation](https://github.com/sourcegraph/sourcegraph-extension-docs) and check out some [Sourcegraph extension samples](https://github.com/sourcegraph/sourcegraph-extension-samples).\\\\n\\\",\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/sourcegraph-contributors-extension.js src/sourcegraph-contributors-extension.ts\\\",\\n    \\\"serve\\\": \\\"parcel serve --no-hmr --out-file dist/sourcegraph-contributors-extension.js src/sourcegraph-contributors-extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run build\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"title\\\": \\\"WIP: File contributors\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/1188-dadlerj-sourcegraph-contributors-extension.js?bq5kj0tjjao8--dadlerj-sourcegraph-contributors-extension\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Displays a bar chart showing the top contributors to a file.\"},\"createdAt\":\"2018-11-29T03:45:13Z\",\"updatedAt\":\"2018-11-29T03:45:13Z\",\"url\":\"/extensions/dadlerj/sourcegraph-contributors-extension\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdmin