raph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Code analysis\\\",\\n    \\\"Reports and stats\\\",\\n    \\\"Linters\\\",\\n    \\\"Insights\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [],\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"eslint.insight.repository\\\": {\\n          \\\"description\\\": \\\"The repository to query on global insights\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        },\\n        \\\"eslint.insight.step\\\": {\\n          \\\"description\\\": \\\"The time duration between two data points on the X axis.\\\",\\n          \\\"properties\\\": {\\n            \\\"days\\\": {\\n              \\\"type\\\": \\\"number\\\"\\n            },\\n            \\\"hours\\\": {\\n              \\\"type\\\": \\\"number\\\"\\n            },\\n            \\\"minutes\\\": {\\n              \\\"type\\\": \\\"number\\\"\\n            },\\n            \\\"months\\\": {\\n              \\\"type\\\": \\\"number\\\"\\n            },\\n            \\\"seconds\\\": {\\n              \\\"type\\\": \\\"number\\\"\\n            },\\n            \\\"weeks\\\": {\\n              \\\"type\\\": \\\"number\\\"\\n            },\\n            \\\"years\\\": {\\n              \\\"type\\\": \\\"number\\\"\\n            }\\n          },\\n          \\\"type\\\": \\\"object\\\"\\n        }\\n      },\\n      \\\"type\\\": \\\"object\\\"\\n    },\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [],\\n      \\\"editor/title\\\": []\\n    }\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"date-fns\\\": \\\"^2.14.0\\\",\\n    \\\"lodash\\\": \\\"^4.17.15\\\",\\n    \\\"rxjs\\\": \\\"^6.5.5\\\",\\n    \\\"tagged-template-noop\\\": \\\"^2.1