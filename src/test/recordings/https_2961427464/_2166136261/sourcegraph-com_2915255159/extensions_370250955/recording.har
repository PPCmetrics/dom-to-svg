true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyNTd9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/sourcegraph-test-leaderboard\",\"extensionIDWithoutRegistry\":\"sourcegraph/sourcegraph-test-leaderboard\",\"name\":\"sourcegraph-test-leaderboard\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/main/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Reports and stats\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [],\\n    \\\"configuration\\\": {},\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [],\\n      \\\"editor/title\\\": []\\n    }\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"rxjs\\\": \\\"^6.5.5\\\"\\n  },\\n  \\\"description\\\": \\\"Who writes the most tests? (In each repository and subdirectory.)\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/eslint-config\\\": \\\"^0.16.2\\\",\\n    \\\"@sourcegraph/prettierrc\\\": \\\"^3.0.3\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^4.0.1\\\",\\n    \\\"eslint\\\": \\\"^6.8.0\\\",\\n    \\\"get-graphql-schema\\\": \\\"^2.1.2\\\",\\n    \\\"gql2ts\\\": \\\"^1.10.1\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^1.0.4\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.12.4\\\",\\n    \\\"prettier\\\": \\\"^2.0.5\\\",\\n    \\\"sourcegraph\\\": \\\"^24.1.0\\\",\\n    \\\"typescript\\\": \\\"^3.8.3\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/sourcegraph-test-leaderboard\\\",\\n  \\\"icon\\\": \\\"data:image/svg+xml,\\\\u003csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22\\\\u003e\\\\u003ctext y=%22.9em%22 font-size=%2290%22\\\\u003e🏆\\\\u003c/text\\\\u003e\\\\u003c/svg\\\\u003e\\\",\\n  \\\"license\\\": \\\"Apache-2.0\\\",\\n  \\\"main\\\": \\\"dist/sourcegraph-test-leaderboard.js\\\",\\n  \\\"name\\\": \\\"sourcegraph-test-leaderboard\\\",\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# sourcegraph-test-leaderboard (Sourcegraph extension)\\\\n\\\\nWho writes the most tests? (In each repository and subdirectory.).\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/sourcegraph/sourcegraph-test-leaderboard\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/sourcegraph-test-leaderboard.js src/sourcegraph-test-leaderboard.ts\\\",\\n    \\\"eslint\\\": \\\"eslint 'src/**/*.ts'\\\",\\n    \\\"graphql\\\": \\\"get-graphql-schema https://sourcegraph.com/.api/graphql --json | gql2ts -o src/sourcegraph.graphql.d.ts\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --out-file dist/sourcegraph-test-leaderboard.js src/sourcegraph-test-leaderboard.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run typecheck \\\\u0026\\\\u0026 yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"mkdirp dist \\\\u0026\\\\u0026 lnfs ./package.json ./dist/package.json\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"tags\\\": [],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/8627-sourcegraph-sourcegraph-test-leaderboard.js?c60mbvdbykk0--sourcegraph-sourcegraph-test-leaderboard\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\",\\n  \\\"wip\\\": true\\n}\",\"description\":\"Who writes the most tests? (In each repository and subdirectory.)\"},\"createdAt\":\"2020-05-02T20:21:42Z\",\"updatedAt\":\"2020-05-02T20:21:42Z\",\"url\":\"/extensions/sourcegraph/sourcegraph-test-leaderboard\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyNTh9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjo1\",\"username\":\"beyang\",\"displayName\":\"Beyang Liu\",\"url\":\"/users/beyang\"},\"extensionID\":\"beyang/codenav-bash\",\"extensionIDWithoutRegistry\":\"beyang/codenav-bash\",\"name\":\"codenav-bash\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [],\\n    \\\"configuration\\\": {},\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [],\\n      \\\"editor/title\\\": []\\n    }\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"@sourcegraph/extension-api-stubs\\\": \\\"^1.1.0\\\",\\n    \\\"babel-polyfill\\\": \\\"^6.26.0\\\",\\n    \\\"mock-require\\\": \\\"^3.0.3\\\",\\n    \\\"node\\\": \\\"^13.10.1\\\",\\n    \\\"path-browserify\\\": \\\"^1.0.1\\\",\\n    \\\"tagged-template-noop\\\": \\\"^2.1.1\\\",\\n    \\\"tree-sitter\\\": \\\"^0.16.0\\\",\\n    \\\"web-tree-sitter\\\": \\\"^0.16.2\\\"\\n  },\\n  \\\"description\\\": \\\"Provides tooltips and navigation capabilities in Bash scripts\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^4.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^13.4.0\\\",\\n    \\\"@types/chai\\\": \\\"^4.2.11\\\",\\n    \\\"@types/mocha\\\": \\\"^7.0.2\\\",\\n    \\\"@types/mock-require\\\": \\\"^2.0.0\\\",\\n    \\\"@types/node\\\": \\\"^13.9.0\\\",\\n    \\\"chai\\\": \\\"^4.2.0\\\",\\n    \\\"isomorphic-fetch\\\": \\\"^2.2.1\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^1.0.3\\\",\\n    \\\"mocha\\\": \\\"^7.2.0\\\",\\n    \\\"nyc\\\": \\\"^15.0.1\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.12.4\\\",\\n    \\\"sourcegraph\\\": \\\"^23.1.0\\\",\\n    \\\"ts-node\\\": \\\"^8.10.1\\\",\\n    \\\"tslint\\\": \\\"^6.0.0\\\",\\n    \\\"typescript\\\": \\\"^3.8.3\\\"\\n  },\\n  \\\"extensionID\\\": \\\"beyang/codenav-bash\\\",\\n  \\\"license\\\": \\\"UNLICENSED\\\",\\n  \\\"main\\\": \\\"dist/codenav-bash.js\\\",\\n  \\\"name\\\": \\\"codenav-bash\\\",\\n  \\\"publisher\\\": \\\"beyang\\\",\\n  \\\"readme\\\": \\\"# codenav-bash\\\\n\\\\nSourcegraph extension that provides tooltips and navigation capabilities in Bash scripts.\\\\n\\\\n## Development\\\\n\\\\n1. Install dependencies: `yarn install`\\\\n1. Update the web-tree-sitter dependency with a special customization: `yarn pre:publish`\\\\n1. Serve the extension on https://localhost:1234: `yarn serve`\\\\n1. Navigate to your Sourcegraph instance. Open the browser JavaScript console and run `localStorage.debug=true;location.reload()`\\\\n1. Click on the `EXT` button in the lower right of the screen, click `Load extension`, enter `http://localhost:1234`\\\\n1. Refresh the page and navigate to a Bash file. You should see hovers.\\\\n\\\\n### Tests\\\\n\\\\nTo run tests, do the following:\\\\n1. Run `yarn pre:test` (note that this will break the extension if you're currently running it on a Sourcegraph instance)\\\\n1. Run `yarn test`\\\\n\\\\nNote that because `yarn pre:test` breaks the extension, after running tests, you'll have to run\\\\n`yarn pre:publish \\\\u0026\\\\u0026 yarn serve` again to unbreak the extension if you're using it on a Sourcegraph\\\\ninstance.\\\\n\\\\n### Publish\\\\n\\\\n1. Run `yarn pre:publish \\\\u0026\\\\u0026 yarn build`\\\\n1. Using the [`src` CLI](https://github.com/sourcegraph/src-cli), run `src ext publish`\\\\n\\\\n### Advanced\\\\n\\\\nThe extension fetches 2 WASM files over the network:\\\\n- `tree-sitter.wasm`, which executes tree-sitter\\\\n- `tree-sitter-bash.wasm`, which contains the tree-sitter grammar for Bash\\\\n\\\\nYou can optionally fetch these from localhost by doing the following:\\\\n- Kill `yarn serve` if it is currently running\\\\n- Run `yarn pre:localhost`\\\\n- Update calls to `initializeParser` to passing \\\\\\\"http://localhost:8000/tree-sitter-bash.wasm\\\\\\\" as the argument.\\\\n- Serve the files: `cd hacks \\\\u0026\\\\u0026 go run serve.go`\\\\n- Run `yarn serve`. You can verify the files are being fetched from the localhost server by looking at its standard output (it will print the name of each file it serves).\\\\n\\\\n### Resources\\\\n\\\\n* [Sourcegraph extension docs](https://docs.sourcegraph.com/extensions/authoring)\\\\n\\\",\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/codenav-bash.js src/codenav-bash.ts\\\",\\n    \\\"pre:localhost\\\": \\\"cp hacks/tree-sitter-localhost.js ./node_modules/web-tree-sitter/tree-sitter.js\\\",\\n    \\\"pre:publish\\\": \\\"cp hacks/tree-sitter-gcp.js ./node_modules/web-tree-sitter/tree-sitter.js\\\",\\n    \\\"pre:test\\\": \\\"cp hacks/tree-sitter-test.js ./node_modules/web-tree-sitter/tree-sitter.js\\\",\\n    \\\"serve\\\": \\\"npm run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --out-file dist/codenav-bash.js src/codenav-bash.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run typecheck \\\\u0026\\\\u0026 npm run build\\\",\\n    \\\"symlink-package\\\": \\\"mkdirp dist \\\\u0026\\\\u0026 lnfs ./package.json ./dist/package.json\\\",\\n    \\\"test\\\": \\\"nyc --reporter=lcov mocha '**/*.test.ts'\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"tags\\\": [],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/6901-beyang-codenav-bash.js?c3jr2rtu502o--beyang-codenav-bash\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\",\\n  \\\"wip\\\": true\\n}\",\"description\":\"Provides tooltips and navigation capabilities in Bash scripts\"},\"createdAt\":\"2020-05-05T04:53:22Z\",\"updatedAt\":\"2020-05-05T04:53:22Z\",\"url\":\"/extensions/beyang/codenav-bash\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyNTl9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/search-insights\",\"extensionIDWithoutRegistry\":\"sourcegraph/search-insights\",\"name\":\"search-insights\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Reports and stats\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [],\\n    \\\"configuration\\\": {\\n      \\\"patternProperties\\\": {\\n        \\\"^searchInsights\\\\\\\\.insight\\\\\\\\.\\\": {\\n          \\\"anyOf\\\": [\\n            {\\n              \\\"enum\\\": [\\n                \\\"null\\\",\\n                \\\"false\\\"\\n              ]\\n            },\\n            {\\n              \\\"additionalProperties\\\": false,\\n              \\\"properties\\\": {\\n                \\\"repositories\\\": {\\n                  \\\"default\\\": \\\"current\\\",\\n                  \\\"description\\\": \\\"The repositories to query. Can be \\\\\\\"current\\\\\\\" to query only the current repository (default), \\\\\\\"all\\\\\\\" to query all repositories, or a list of regular expression patterns.\\\",\\n                  \\\"oneOf\\\": [\\n                    {\\n                      \\\"enum\\\": [\\n                        \\\"current\\\",\\n                        \\\"all\\\"\\n                      ]\\n                    },\\n                    {\\n                      \\\"items\\\": {\\n                        \\\"format\\\": \\\"regex\\\",\\n                        \\\"type\\\": \\\"string\\\"\\n                      },\\n                      \\\"type\\\": \\\"array\\\"\\n                    }\\n                  ]\\n                },\\n                \\\"series\\\": {\\n                  \\\"description\\\": \\\"Each query will be represented by one line on the chart.\\\",\\n                  \\\"items\\\": {\\n                    \\\"additionalProperties\\\": false,\\n                    \\\"properties\\\": {\\n                      \\\"name\\\": {\\n                        \\\"type\\\": \\\"string\\\"\\n                      },\\n                      \\\"query\\\": {\\n                        \\\"description\\\": \\\"The search query, without the repo filter.\\\",\\n                        \\\"type\\\": \\\"string\\\"\\n                      },\\n                      \\\"stroke\\\": {\\n                        \\\"description\\\": \\\"The color of the line for the series.\\\",\\n                        \\\"type\\\": \\\"string\\\"\\n                      }\\n                    },\\n                    \\\"required\\\": [\\n                      \\\"name\\\",\\n                      \\\"query\\\"\\n                    ],\\n                    \\\"type\\\": \\\"object\\\"\\n                  },\\n                  \\\"type\\\": \\\"array\\\"\\n                },\\n                \\\"step\\\": {\\n                  \\\"description\\\": \\\"The time duration between two data points on the X axis.\\\",\\n                  \\\"properties\\\": {\\n                    \\\"days\\\": {\\n                      \\\"type\\\": \\\"number\\\"\\n                    },\\n                    \\\"hours\\\": {\\n                      \\\"type\\\": \\\"number\\\"\\n                    },\\n                    \\\"minutes\\\": {\\n                      \\\"type\\\": \\\"number\\\"\\n                    },\\n                    \\\"months\\\": {\\n                      \\\"type\\\": \\\"number\\\"\\n                    },\\n                    \\\"seconds\\\": {\\n                      \\\"type\\\": \\\"number\\\"\\n                    },\\n                    \\\"weeks\\\": {\\n                      \\\"type\\\": \\\"number\\\"\\n                    },\\n                    \\\"years\\\": {\\n                      \\\"type\\\": \\\"number\\\"\\n                    }\\n                  },\\n                  \\\"type\\\": \\\"object\\\"\\n                },\\n                \\\"subtitle\\\": {\\n                  \\\"type\\\": \\\"string\\\"\\n                },\\n                \\\"title\\\": {\\n                  \\\"type\\\": \\\"string\\\"\\n                }\\n              },\\n              \\\"required\\\": [\\n                \\\"title\\\",\\n                \\\"series\\\"\\n              ],\\n              \\\"type\\\": \\\"object\\\"\\n            }\\n          ]\\n        }\\n      }\\n    },\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [],\\n      \\\"editor/title\\\": []\\n    }\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"date-fns\\\": \\\"^2.12.0\\\",\\n    \\\"lodash\\\": \\\"^4.17.15\\\",\\n    \\\"rxjs\\\": \\\"^6.5.5\\\",\\n    \\\"tagged-template-noop\\\": \\\"^2.1.1\\\"\\n  },\\n  \\\"description\\\": \\\"Provides code insights from code searches\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/eslint-config\\\": \\\"^0.16.3\\\",\\n    \\\"@sourcegraph/prettierrc\\\": \\\"^3.0.3\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^4.0.1\\\",\\n    \\\"@types/lodash\\\": \\\"^4.14.150\\\",\\n    \\\"eslint\\\": \\\"^6.8.0\\\",\\n    \\\"graphql\\\": \\\"^15.0.0\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^1.0.4\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.12.4\\\",\\n    \\\"sourcegraph\\\": \\\"^24.7.0\\\",\\n    \\\"ts-graphql-plugin\\\": \\\"^1.12.0\\\",\\n    \\\"typescript\\\": \\\"^3.8.3\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/search-insights\\\",\\n  \\\"icon\\\": \\\"data:image/svg+xml,\\\\u003csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22\\\\u003e\\\\u003ctext y=%22.9em%22 font-size=%2290%22\\\\u003e🔍\\\\u003c/text\\\\u003e\\\\u003c/svg\\\\u003e\\\",\\n  \\\"license\\\": \\\"Apache-2.0\\\",\\n  \\\"main\\\": \\\"dist/search-insights.js\\\",\\n  \\\"name\\\": \\\"search-insights\\\",\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"Provides interactive code insights on Sourcegraph directory pages from configurable [code searches](https://docs.sourcegraph.com/user/search).\\\\nThe insight shows the development of the number of matches over time for a configurable time frame up to now.\\\\nEach data point links to a [diff search](https://docs.sourcegraph.com/user/search#commit-diff-search) between that data point and the previous to explain the changes between the two datapoints.\\\\n\\\\n\\\\u003cp\\\\u003e\\\\n\\\\u003cpicture\\\\u003e\\\\n\\\\u003csource srcset=\\\\\\\"https://user-images.githubusercontent.com/10532611/81548701-f80cb980-937d-11ea-99c6-4ef2d0c0278e.gif\\\\\\\" media=\\\\\\\"(prefers-color-scheme: dark)\\\\\\\" /\\\\u003e\\\\n\\\\u003csource srcset=\\\\\\\"https://user-images.githubusercontent.com/10532611/81548695-f642f600-937d-11ea-8e22-6f809a861b5d.gif\\\\\\\" media=\\\\\\\"(prefers-color-scheme: light)\\\\\\\" /\\\\u003e\\\\n\\\\u003cimg src=\\\\\\\"https://user-images.githubusercontent.com/10532611/81548701-f80cb980-937d-11ea-99c6-4ef2d0c0278e.gif\\\\\\\" alt=\\\\\\\"Screenshot\\\\\\\" /\\\\u003e\\\\n\\\\u003c/picture\\\\u003e\\\\n\\\\u003c/p\\\\u003e\\\\n\\\\n## Configuration\\\\n\\\\nTo add a search insight, add an object like this to your user, organization or global settings:\\\\n\\\\n```jsonc\\\\n// Choose any name - only the prefix \\\\\\\"searchInsights.insight.\\\\\\\" is mandatory.\\\\n\\\\\\\"searchInsights.insight.reactFunctionComponentMigration\\\\\\\": {\\\\n  // Shown as the title of the insight.\\\\n  \\\\\\\"title\\\\\\\": \\\\\\\"Migration to React function components\\\\\\\",\\\\n  // The lines of the chart.\\\\n  \\\\\\\"series\\\\\\\": [\\\\n    {\\\\n      // Name shown in the legend and tooltip.\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"Function components\\\\\\\",\\\\n      // The search query that will be run for the interval defined in \\\\\\\"step\\\\\\\".\\\\n      // Do not include the \\\\\\\"repo:\\\\\\\" filter as it will be added automatically for the current repsitory.\\\\n      \\\\\\\"query\\\\\\\": \\\\\\\"patternType:regexp const\\\\\\\\\\\\\\\\s\\\\\\\\\\\\\\\\w+:\\\\\\\\\\\\\\\\s(React\\\\\\\\\\\\\\\\.)?FunctionComponent\\\\\\\",\\\\n      // An optional color for the line.\\\\n      // Can be any hex color code, rgb(), hsl(),\\\\n      // or reference color variables from the OpenColor palette (recommended): https://yeun.github.io/open-color/\\\\n      // The semantic colors var(--danger), var(--warning) and var(--info) are also available.\\\\n      \\\\\\\"stroke\\\\\\\": \\\\\\\"var(--oc-teal-7)\\\\\\\"\\\\n    },\\\\n    {\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"Class components\\\\\\\",\\\\n      \\\\\\\"query\\\\\\\": \\\\\\\"patternType:regexp extends\\\\\\\\\\\\\\\\s(React\\\\\\\\\\\\\\\\.)?(Pure)?Component\\\\\\\",\\\\n      \\\\\\\"stroke\\\\\\\": \\\\\\\"var(--oc-indigo-7)\\\\\\\"\\\\n    }\\\\n  ],\\\\n  // The step between two data points. Supports days, months, hours, etc.\\\\n  \\\\\\\"step\\\\\\\": {\\\\n    \\\\\\\"weeks\\\\\\\": 2\\\\n  }\\\\n}\\\\n```\\\\n\\\\nMultiple search insights can be defined by adding more objects under different keys, as long as they are prefixed with `searchInsights.insight.`.\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/sourcegraph/sourcegraph-search-insights\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/search-insights.js src/search-insights.ts\\\",\\n    \\\"eslint\\\": \\\"eslint 'src/**/*.ts'\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --out-file dist/search-insights.js src/search-insights.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run typecheck \\\\u0026\\\\u0026 yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"mkdirp dist \\\\u0026\\\\u0026 lnfs ./package.json ./dist/package.json\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"tags\\\": [],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/8620-sourcegraph-search-insights.js?c5v1tw4srk0g--sourcegraph-search-insights\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\",\\n  \\\"wip\\\": true\\n}\",\"description\":\"Provides code insights from code searches\"},\"createdAt\":\"2020-05-06T13:12:07Z\",\"updatedAt\":\"2020-05-06T13:12:07Z\",\"url\":\"/extensions/sourcegraph/search-insights\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyNjJ9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjoyMDQ1OA==\",\"username\":\"isaiahfrantz\",\"displayName\":\"Isaiah Frantz\",\"url\":\"/users/isaiahfrantz\"},\"extensionID\":\"isaiahfrantz/puppet\",\"extensionIDWithoutRegistry\":\"isaiahfrantz/puppet\",\"name\":\"puppet\",\"manifest\":null,\"createdAt\":\"2020-05-20T19:41:10Z\",\"updatedAt\":\"2020-05-20T19:41:10Z\",\"url\":\"/extensions/isaiahfrantz/puppet\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyNjR9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/code-stats-insights\",\"extensionIDWithoutRegistry\":\"sourcegraph/code-stats-insights\",\"name\":\"code-stats-insights\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Code analysis\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [],\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"codeStatsInsights.otherThreshold\\\": {\\n          \\\"default\\\": 0.03,\\n          \\\"description\\\": \\\"The threshold below which a language is counted as part of 'Other'\\\",\\n          \\\"maximum\\\": 1,\\n          \\\"minimum\\\": 0,\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeStatsInsights.query\\\": {\\n          \\\"description\\\": \\\"The repo query to use on the insights page\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        },\\n        \\\"codeStatsInsights.title\\\": {\\n          \\\"description\\\": \\\"The title for the insight\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        }\\n      },\\n      \\\"type\\\": \\\"object\\\"\\n    },\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [],\\n      \\\"editor/title\\\": []\\n    }\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"linguist-languages\\\": \\\"^7.9.0\\\",\\n    \\\"lodash\\\": \\\"^4.17.15\\\",\\n    \\\"open-color\\\": \\\"^1.7.0\\\",\\n    \\\"rxjs\\\": \\\"^6.5.5\\\"\\n  },\\n  \\\"description\\\": \\\"Provides insights from code statistics (languages, lines of code)\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/eslint-config\\\": \\\"^0.19.2\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^4.0.1\\\",\\n    \\\"@types/lodash\\\": \\\"^4.14.155\\\",\\n    \\\"eslint\\\": \\\"^7.2.0\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^1.0.4\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.12.4\\\",\\n    \\\"sourcegraph\\\": \\\"^24.7.0\\\",\\n    \\\"tagged-template-noop\\\": \\\"^2.1.1\\\",\\n    \\\"ts-graphql-plugin\\\": \\\"^1.12.0\\\",\\n    \\\"typescript\\\": \\\"^3.9.5\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/code-stats-insights\\\",\\n  \\\"icon\\\": \\\"data:image/svg+xml,\\\\u003csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22\\\\u003e\\\\u003ctext y=%22.9em%22 font-size=%2290%22\\\\u003e📊\\\\u003c/text\\\\u003e\\\\u003c/svg\\\\u003e\\\",\\n  \\\"license\\\": \\\"Apache-2.0\\\",\\n  \\\"main\\\": \\\"dist/code-stats-insights.js\\\",\\n  \\\"name\\\": \\\"code-stats-insights\\\",\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# code-stats-insights (Sourcegraph extension)\\\\n\\\\nProvides insights from code statistics (languages, lines of code).\\\\n\\\\n\\\\u003cp\\\\u003e\\\\n\\\\u003cpicture\\\\u003e\\\\n\\\\u003csource srcset=\\\\\\\"https://user-images.githubusercontent.com/10532611/84433599-d168c980-ac2e-11ea-918a-a210241683da.png\\\\\\\" media=\\\\\\\"(prefers-color-scheme: dark)\\\\\\\" /\\\\u003e\\\\n\\\\u003csource srcset=\\\\\\\"https://user-images.githubusercontent.com/10532611/84433583-cf066f80-ac2e-11ea-81ac-7b005fd288d7.png\\\\\\\" media=\\\\\\\"(prefers-color-scheme: light)\\\\\\\" /\\\\u003e\\\\n\\\\u003cimg src=\\\\\\\"https://user-images.githubusercontent.com/10532611/84433583-cf066f80-ac2e-11ea-81ac-7b005fd288d7.png\\\\\\\" alt=\\\\\