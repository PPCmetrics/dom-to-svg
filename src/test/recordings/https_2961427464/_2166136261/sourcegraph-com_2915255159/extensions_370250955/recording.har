          "headersSize": 590,
          "httpVersion": "HTTP/1.1",
          "method": "POST",
          "postData": {
            "mimeType": "application/json",
            "params": [],
            "text": "{\"query\":\"\\n    query RegistryExtensions($query: String, $prioritizeExtensionIDs: [String!]!) {\\n        extensionRegistry {\\n            extensions(query: $query, prioritizeExtensionIDs: $prioritizeExtensionIDs) {\\n                nodes {\\n                    ...RegistryExtensionFieldsForList\\n                }\\n                error\\n            }\\n        }\\n    }\\n    fragment RegistryExtensionFieldsForList on RegistryExtension {\\n        id\\n        publisher {\\n            __typename\\n            ... on User {\\n                id\\n                username\\n                displayName\\n                url\\n            }\\n            ... on Org {\\n                id\\n                name\\n                displayName\\n                url\\n            }\\n        }\\n        extensionID\\n        extensionIDWithoutRegistry\\n        name\\n        manifest {\\n            raw\\n            description\\n        }\\n        createdAt\\n        updatedAt\\n        url\\n        remoteURL\\n        registryName\\n        isLocal\\n        isWorkInProgress\\n        viewerCanAdminister\\n    }\\n\",\"variables\":{\"query\":\"\",\"prioritizeExtensionIDs\":[\"sourcegraph/clojure\",\"sourcegraph/cobol\",\"sourcegraph/cpp\",\"sourcegraph/csharp\",\"sourcegraph/cuda\",\"sourcegraph/dart\",\"sourcegraph/elixir\",\"sourcegraph/erlang\",\"sourcegraph/git-extras\",\"sourcegraph/go\",\"sourcegraph/graphql\",\"sourcegraph/groovy\",\"sourcegraph/haskell\",\"sourcegraph/java\",\"sourcegraph/jsonnet\",\"sourcegraph/kotlin\",\"sourcegraph/lisp\",\"sourcegraph/lua\",\"sourcegraph/ocaml\",\"sourcegraph/pascal\",\"sourcegraph/perl\",\"sourcegraph/php\",\"sourcegraph/powershell\",\"sourcegraph/protobuf\",\"sourcegraph/python\",\"sourcegraph/r\",\"sourcegraph/ruby\",\"sourcegraph/rust\",\"sourcegraph/scala\",\"sourcegraph/shell\",\"sourcegraph/swift\",\"sourcegraph/tcl\",\"sourcegraph/thrift\",\"sourcegraph/typescript\",\"sourcegraph/verilog\",\"sourcegraph/vhdl\"]}}"
          },
          "queryString": [
            {
              "name": "RegistryExtensions",
              "value": null
            }
          ],
          "url": "https://sourcegraph.com/.api/graphql?RegistryExtensions"
        },
        "response": {
          "bodySize": 1693355,
          "content": {
            "mimeType": "application/json",
            "size": 1693355,
            "text": "{\"data\":{\"extensionRegistry\":{\"extensions\":{\"nodes\":[{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo3Nn0=\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/git-extras\",\"extensionIDWithoutRegistry\":\"sourcegraph/git-extras\",\"name\":\"git-extras\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/main/client/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Code analysis\\\"\\n  ],\\n  \\\"commitlint\\\": {\\n    \\\"extends\\\": [\\n      \\\"@commitlint/config-conventional\\\"\\n    ]\\n  },\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [\\n      {\\n        \\\"actionItem\\\": {\\n          \\\"description\\\": \\\"${(config.git.blame.decorations === 'line' \\\\u0026\\\\u0026 'Show Git blame line annotations for the whole file') || (config.git.blame.decorations === 'file' \\\\u0026\\\\u0026 'Hide Git blame line annotations') || 'Show Git blame line annotations on selected lines'}\\\",\\n          \\\"iconURL\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph-git-extras/63dd95962c43b95b3f3a9ea2aa0165d6b38a958c/icon/git_logo.svg?sanitize=true\\\",\\n          \\\"label\\\": \\\"Blame\\\",\\n          \\\"pressed\\\": \\\"(config.git.blame.decorations === 'line') || (config.git.blame.decorations === 'file')\\\"\\n        },\\n        \\\"category\\\": \\\"Git\\\",\\n        \\\"command\\\": \\\"updateConfiguration\\\",\\n        \\\"commandArguments\\\": [\\n          [\\n            \\\"git.blame.decorations\\\"\\n          ],\\n          \\\"${(config.git.blame.decorations === 'line' \\\\u0026\\\\u0026 'file') || (config.git.blame.decorations === 'file' \\\\u0026\\\\u0026 'none') || 'line'}\\\",\\n          null\\n        ],\\n        \\\"id\\\": \\\"git.blame.toggle\\\",\\n        \\\"title\\\": \\\"${(config.git.blame.decorations === 'line' \\\\u0026\\\\u0026 'Show blame for the whole file') || (config.git.blame.decorations === 'file' \\\\u0026\\\\u0026 'Hide blame') || 'Show blame for selected lines'}\\\"\\n      }\\n    ],\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"git.blame.decorations\\\": {\\n          \\\"default\\\": \\\"none\\\",\\n          \\\"description\\\": \\\"Whether to decorate all lines in a file, only selected lines, or none at all.\\\",\\n          \\\"enum\\\": [\\n            \\\"none\\\",\\n            \\\"line\\\",\\n            \\\"file\\\"\\n          ],\\n          \\\"type\\\": \\\"string\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Git extras\\\"\\n    },\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [\\n        {\\n          \\\"action\\\": \\\"git.blame.toggle\\\",\\n          \\\"when\\\": \\\"resource\\\"\\n        }\\n      ],\\n      \\\"editor/title\\\": [\\n        {\\n          \\\"action\\\": \\\"git.blame.toggle\\\",\\n          \\\"when\\\": \\\"resource \\\\u0026\\\\u0026 clientApplication.isSourcegraph\\\"\\n        }\\n      ]\\n    }\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"date-fns\\\": \\\"^2.0.0-alpha.24\\\",\\n    \\\"rxjs\\\": \\\"^6.4.0\\\",\\n    \\\"tagged-template-noop\\\": \\\"^2.1.0\\\"\\n  },\\n  \\\"description\\\": \\\"A Sourcegraph extension that adds useful features when viewing files in a Git repository on Sourcegraph, GitHub, GitLab, and other supported code hosts.\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@commitlint/cli\\\": \\\"^11.0.0\\\",\\n    \\\"@commitlint/config-conventional\\\": \\\"^11.0.0\\\",\\n    \\\"@sourcegraph/prettierrc\\\": \\\"^2.2.0\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^4.0.1\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^13.4.0\\\",\\n    \\\"@types/expect\\\": \\\"1.20.4\\\",\\n    \\\"@types/lodash\\\": \\\"4.14.165\\\",\\n    \\\"@types/mocha\\\": \\\"5.2.7\\\",\\n    \\\"@types/node\\\": \\\"13.13.5\\\",\\n    \\\"@types/sinon\\\": \\\"7.0.13\\\",\\n    \\\"expect\\\": \\\"^24.1.0\\\",\\n    \\\"husky\\\": \\\"^1.3.1\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"lodash\\\": \\\"^4.17.11\\\",\\n    \\\"mkdirp\\\": \\\"^0.5.1\\\",\\n    \\\"mocha\\\": \\\"^6.1.4\\\",\\n    \\\"nyc\\\": \\\"^13.3.0\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.12.4\\\",\\n    \\\"prettier\\\": \\\"^1.19.1\\\",\\n    \\\"sinon\\\": \\\"^7.3.2\\\",\\n    \\\"source-map-support\\\": \\\"^0.5.12\\\",\\n    \\\"sourcegraph\\\": \\\"^24.7.0\\\",\\n    \\\"ts-node\\\": \\\"^8.3.0\\\",\\n    \\\"tslint\\\": \\\"^5.11.0\\\",\\n    \\\"typescript\\\": \\\"^3.9.3\\\",\\n    \\\"vscode-languageserver-types\\\": \\\"^3.14.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/git-extras\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"husky\\\": {\\n    \\\"hooks\\\": {\\n      \\\"commit-msg\\\": \\\"commitlint -e $HUSKY_GIT_PARAMS\\\"\\n    }\\n  },\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/sourcegraph-git-extras.js\\\",\\n  \\\"name\\\": \\\"git-extras\\\",\\n  \\\"nyc\\\": {\\n    \\\"exclude\\\": [\\n      \\\"**/*.test.ts?(x)\\\",\\n      \\\"src/util/stubs.ts\\\"\\n    ],\\n    \\\"extension\\\": [\\n      \\\".tsx\\\",\\n      \\\".ts\\\"\\n    ],\\n    \\\"include\\\": [\\n      \\\"src/**/*.ts?(x)\\\"\\n    ]\\n  },\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# sourcegraph-git-extras\\\\n\\\\n[![build](https://travis-ci.org/sourcegraph/sourcegraph-git-extras.svg?branch=master)](https://travis-ci.org/sourcegraph/sourcegraph-git-extras)\\\\n[![codecov](https://codecov.io/gh/sourcegraph/sourcegraph-git-extras/branch/master/graph/badge.svg?token=c3KpMf1MaY)](https://codecov.io/gh/sourcegraph/sourcegraph-git-extras)\\\\n[![code style: prettier](https://img.shields.io/badge/code_style-prettier-ff69b4.svg)](https://github.com/prettier/prettier)\\\\n\\\\nA [Sourcegraph extension](https://docs.sourcegraph.com/extensions) that adds useful features when viewing files in a Git repository on [Sourcegraph](https://sourcegraph.com), GitHub, GitLab, and other [supported code hosts](https://docs.sourcegraph.com/extensions):\\\\n\\\\n- **Git: Show/hide blame**: toggles Git blame annotations with each line's last commit, author, date, etc.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/sourcegraph-git-extras)\\\\n\\\\n[**➕ Add to Sourcegraph**](https://sourcegraph.com/extensions/sourcegraph/git-extras)\\\\n\\\\n![screenshot from 2018-10-28 17-55-20](https://user-images.githubusercontent.com/1976/47624533-f3a1e800-dada-11e8-81d9-3d4bd67fc08a.png)\\\\n![screenshot from 2018-10-28 17-55-02](https://user-images.githubusercontent.com/1976/47624534-f3a1e800-dada-11e8-9c08-9ce307653b20.png)\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/sourcegraph/sourcegraph-git-extras.git\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --no-minify --out-file sourcegraph-git-extras.js src/extension.ts\\\",\\n    \\\"cover\\\": \\\"TS_NODE_COMPILER_OPTIONS='{\\\\\\\"module\\\\\\\":\\\\\\\"commonjs\\\\\\\"}' nyc --require ts-node/register --require source-map-support/register --all mocha --opts mocha.opts --timeout 10000\\\",\\n    \\\"prettier\\\": \\\"prettier '**/*.{js?(on),ts?(x),scss,yml,md}' --write --list-different\\\",\\n    \\\"prettier-check\\\": \\\"npm run prettier -- --write=false\\\",\\n    \\\"serve\\\": \\\"npm run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --out-file sourcegraph-git-extras.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn typecheck \\\\u0026\\\\u0026 yarn test \\\\u0026\\\\u0026 yarn build\\\",\\n    \\\"symlink-package\\\": \\\"mkdirp dist \\\\u0026\\\\u0026 lnfs ./package.json ./dist/package.json\\\",\\n    \\\"test\\\": \\\"TS_NODE_COMPILER_OPTIONS='{\\\\\\\"module\\\\\\\":\\\\\\\"commonjs\\\\\\\"}' mocha --require ts-node/register --require source-map-support/register --opts mocha.opts\\\",\\n    \\\"tslint\\\": \\\"tslint -c tslint.json -p tsconfig.json './src/*.ts?(x)' './*.ts?(x)'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p .\\\"\\n  },\\n  \\\"tags\\\": [\\n    \\\"blame\\\",\\n    \\\"github\\\",\\n    \\\"gitlab\\\",\\n    \\\"code host\\\",\\n    \\\"author\\\"\\n  ],\\n  \\\"title\\\": \\\"Git extras\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9176-sourcegraph-git-extras.js?c6ztfhra5y8w--sourcegraph-git-extras\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"A Sourcegraph extension that adds useful features when viewing files in a Git repository on Sourcegraph, GitHub, GitLab, and other supported code hosts.\"},\"createdAt\":\"2018-10-29T01:39:47Z\",\"updatedAt\":\"2018-10-29T01:39:47Z\",\"url\":\"/extensions/sourcegraph/git-extras\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxMzB9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/python\",\"extensionIDWithoutRegistry\":\"sourcegraph/python\",\"name\":\"python\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:python\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for Python using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/python\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"python\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Python\\\\n\\\\nThis extension provides Python code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/python` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/python) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/python`, and enable it.\\\\n1. Visit any Python code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using python on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"Python code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9179-sourcegraph-python.js?c6zthrg2yc3c--sourcegraph-python\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for Python using the Sourcegraph search API\"},\"createdAt\":\"2018-12-07T05:21:41Z\",\"updatedAt\":\"2018-12-07T05:21:41Z\",\"url\":\"/extensions/sourcegraph/python\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxNjh9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/typescript\",\"extensionIDWithoutRegistry\":\"sourcegraph/typescript\",\"name\":\"typescript\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:typescript\\\",\\n    \\\"onLanguage:javascript\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [\\n      {\\n        \\\"actionItem\\\": {\\n          \\\"label\\\": \\\"${config.typescript.showExternalReferences \\\\u0026\\\\u0026 \\\\\\\"Hide references from other repositories\\\\\\\" || \\\\\\\"Show references from other repositories\\\\\\\"}\\\"\\n        },\\n        \\\"command\\\": \\\"updateConfiguration\\\",\\n        \\\"commandArguments\\\": [\\n          [\\n            \\\"typescript.showExternalReferences\\\"\\n          ],\\n          \\\"${!config.typescript.showExternalReferences}\\\",\\n          null,\\n          \\\"json\\\"\\n        ],\\n        \\\"id\\\": \\\"externalReferences.toggle\\\",\\n        \\\"title\\\": \\\"${config.typescript.showExternalReferences \\\\u0026\\\\u0026 \\\\\\\"Hide references from other repositories\\\\\\\" || \\\\\\\"Show references from other repositories\\\\\\\"}\\\"\\n      }\\n    ],\\n    \\\"configuration\\\": {\\n      \\\"additionalProperties\\\": false,\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"typescript.accessToken\\\": {\\n          \\\"description\\\": \\\"The access token for the language server to use to fetch files from the Sourcegraph API. The extension will create this token and save it in your settings automatically.\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        },\\n        \\\"typescript.diagnostics.enable\\\": {\\n          \\\"description\\\": \\\"Whether to show compile errors on lines (Default: false)\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"typescript.langserver.log\\\": {\\n          \\\"description\\\": \\\"The log level to pass to the TypeScript language server. Logs will be forwarded to the browser console with the prefix [langserver].\\\",\\n          \\\"enum\\\": [\\n            false,\\n            \\\"log\\\",\\n            \\\"info\\\",\\n            \\\"warn\\\",\\n            \\\"error\\\"\\n          ]\\n        },\\n        \\\"typescript.maxExternalReferenceRepos\\\": {\\n          \\\"description\\\": \\\"The maximum number of dependent packages to look in when searching for external references for a symbol (defaults to 20).\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"typescript.npmrc\\\": {\\n          \\\"description\\\": \\\"Settings to be written into an npmrc in key/value format. Can be used to specify custom registries and tokens.\\\",\\n          \\\"type\\\": \\\"object\\\"\\n        },\\n        \\\"typescript.progress\\\": {\\n          \\\"description\\\": \\\"Whether to report progress while fetching sources, installing dependencies etc. (Default: true)\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"typescript.restartAfterDependencyInstallation\\\": {\\n          \\\"description\\\": \\\"Whether to restart the language server after dependencies were installed (default true)\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"typescript.serverUrl\\\": {\\n          \\\"description\\\": \\\"The address of the WebSocket language server to connect to (e.g. ws://host:8080).\\\",\\n          \\\"format\\\": \\\"url\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        },\\n        \\\"typescript.showExternalReferences\\\": {\\n          \\\"description\\\": \\\"Whether or not a second references provider for external references will be registered (defaults to false).\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"typescript.sourcegraphUrl\\\": {\\n          \\\"description\\\": \\\"The address of the Sourcegraph instance from the perspective of the TypeScript language server.\\\",\\n          \\\"format\\\": \\\"url\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        },\\n        \\\"typescript.tsserver.log\\\": {\\n          \\\"description\\\": \\\"The log level to pass to tsserver. Logs will be forwarded to the browser console with the prefix [tsserver].\\\",\\n          \\\"enum\\\": [\\n            false,\\n            \\\"terse\\\",\\n            \\\"normal\\\",\\n            \\\"requestTime\\\",\\n            \\\"verbose\\\"\\n          ]\\n        }\\n      },\\n      \\\"title\\\": \\\"Settings\\\",\\n      \\\"type\\\": \\\"object\\\"\\n    },\\n    \\\"menus\\\": {\\n      \\\"panel/toolbar\\\": [\\n        {\\n          \\\"action\\\": \\\"externalReferences.toggle\\\",\\n          \\\"when\\\": \\\"panel.activeView.id == 'references'\\\"\\n        }\\n      ]\\n    }\\n  },\\n  \\\"description\\\": \\\"TypeScript/JavaScript code intelligence\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/typescript\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"typescript\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for TypeScript/JavaScript\\\\n\\\\nThis extension provides TypeScript/JavaScript code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/typescript)\\\\n\\\\n![TypeScript code intelligence](https://user-images.githubusercontent.com/133014/63376874-a92c7900-c343-11e9-98bb-631016f1eff7.gif)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/typescript` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/typescript) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/typescript`, and enable it.\\\\n1. Visit any TypeScript code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\\n## Language server\\\\n\\\\nThis extension communicates with a language server over WebSockets. On Sourcegraph.com, this extension is already configured. If you are running a\\\\nprivate Sourcegraph instance, you should run your own language server. The server is available as a Docker image `sourcegraph/lang-typescript` from Docker Hub.\\\\n\\\\n### 🔐 Secure deployment 🔐\\\\n\\\\nIf you have private code, we recommend deploying the language server behind an\\\\nauth proxy (such as the example below using HTTP basic authentication in NGINX), a firewall, or a VPN.\\\\n\\\\n### HTTP basic authentication\\\\n\\\\nYou can prevent unauthorized access to the language server by enforcing HTTP basic authentication in nginx, which comes with the sourcegraph/server image. At a high level, you'll create a secret then put it in both the nginx config and in your Sourcegraph global settings so that logged-in users are authenticated when their browser makes requests to the TypeScript language server.\\\\n\\\\nHere's how to set it up:\\\\n\\\\nCreate an `.htpasswd` file in the Sourcegraph config directory with one entry:\\\\n\\\\n```\\\\n$ htpasswd -c ~/.sourcegraph/config/.htpasswd langserveruser\\\\nNew password:\\\\nRe-type new password:\\\\nAdding password for user langserveruser\\\\n```\\\\n\\\\nAdd a location directive the [nginx.conf](https://docs.sourcegraph.com/admin/nginx) that will route requests to the TypeScript language server:\\\\n\\\\n```nginx\\\\n...\\\\nhttp {\\\\n    ...\\\\n    server {\\\\n        ...\\\\n        location / {\\\\n            ...\\\\n        }\\\\n\\\\n        location /typescript {\\\\n            proxy_pass http://host.docker.internal:8080;\\\\n            proxy_http_version 1.1;\\\\n            proxy_set_header Upgrade $http_upgrade;\\\\n            proxy_set_header Connection \\\\\\\"Upgrade\\\\\\\";\\\\n\\\\n            auth_basic \\\\\\\"basic authentication is required to access the language server\\\\\\\";\\\\n            auth_basic_user_file /etc/sourcegraph/.htpasswd;\\\\n        }\\\\n    }\\\\n}\\\\n```\\\\n\\\\n- If you're running the quickstart on Linux, change `host.docker.internal` to the output of `ip addr show docker0 | grep -Po 'inet \\\\\\\\K[\\\\\\\\d.]+'`.\\\\n- If you're using [Kubernetes](#using-kubernetes) (e.g. [deploy-sourcegraph](https://github.com/sourcegraph/deploy-sourcegraph)), change `host.docker.internal` to `lang-typescript`.\\\\n\\\\nAdd these to your Sourcegraph global settings:\\\\n\\\\n    ```json\\\\n    \\\\\\\"typescript.serverUrl\\\\\\\": \\\\\\\"ws://langserveruser:PASSWORD@host.docker.internal:7080/typescript\\\\\\\",\\\\n    \\\\\\\"typescript.sourcegraphUrl\\\\\\\": \\\\\\\"http://host.docker.internal:7080\\\\\\\",\\\\n    ```\\\\n\\\\nFill in the `PASSWORD` that you created above.\\\\n\\\\n- If you're running the quickstart on Linux, change `host.docker.internal` to the output of `ip addr show docker0 | grep -Po 'inet \\\\\\\\K[\\\\\\\\d.]+'`.\\\\n- If you're using [Kubernetes](#using-kubernetes) (e.g. [deploy-sourcegraph](https://github.com/sourcegraph/deploy-sourcegraph)):\\\\n  - `typescript.serverUrl` is the address of the TypeScript language server from the perspective of a user's browser (e.g. https://sourcegraph.example.com/typescript)\\\\n  - `typescript.sourcegraphUrl` is the address of the Sourcegraph instance from the perspective of the TypeScript language server (e.g. http://sourcegraph-frontend:30080)\\\\n\\\\nFinally, restart the sourcegraph/server container (or nginx deployment if deployed to Kubernetes) to pick up the configuration change.\\\\n\\\\nAfter deploying the language server, unauthenticated access to `http://localhost:7080/typescript` (or https://sourcegraph.example.com/typescript) should be blocked, but code intelligence should work when you're logged in.\\\\n\\\\nYou can always revoke the `PASSWORD` by deleting the `.htpasswd` file and restarting nginx.\\\\n\\\\n### Using Docker\\\\n\\\\n1. Run the Go language server:\\\\n\\\\n   ```sh\\\\n   docker run -p 8080:8080 sourcegraph/lang-typescript\\\\n   ```\\\\n\\\\n   You can verify it's up and running with [`ws`](https://github.com/hashrocket/ws) (run this from the same machine your browser is running on):\\\\n\\\\n   ```sh\\\\n   $ go get -u github.com/hashrocket/ws\\\\n   $ ws ws://localhost:8080\\\\n   \\\\u003e\\\\n   ```\\\\n\\\\n1. Enable this extension on your Sourcegraph https://sourcegraph.example.com/extensions/sourcegraph/typescript\\\\n\\\\n1. Add these to your Sourcegraph settings in https://sourcegraph.example.com/site-admin/global-settings and make sure the port matches either the Docker command or your Kubernetes config:\\\\n\\\\n   ```json\\\\n   \\\\\\\"typescript.serverUrl\\\\\\\": \\\\\\\"ws://localhost:8080\\\\\\\"\\\\n   \\\\\\\"typescript.sourcegraphUrl\\\\\\\": \\\\\\\"http://host.docker.internal:7080\\\\\\\",\\\\n   ```\\\\n\\\\n   If you're running on Linux, change `go.sourcegraphUrl` to the IP given by:\\\\n\\\\n   ```bash\\\\n   ip addr show docker0 | grep -Po 'inet \\\\\\\\K[\\\\\\\\d.]+'\\\\n   ```\\\\n\\\\nNow visit a TypeScript file and you should see code intelligence!\\\\n\\\\n#### TLS in Docker\\\\n\\\\nTo enable the use of Websocket with SSL pass the key/certificate pair as environment variables to the docker container.\\\\n\\\\n```\\\\ndocker run -p 8080:8080 -e TLS_KEY=\\\\\\\"$(cat sourcegraph.example.com.key)\\\\\\\" -e TLS_CERT=\\\\\\\"$(cat sourcegraph.example.com.crt)\\\\\\\" sourcegraph/lang-typescript\\\\n```\\\\n\\\\nTo reuse the self-signed certificate created by following the steps [here](https://docs.sourcegraph.com/admin/nginx#tls-https) add these parameters to the run command above:\\\\n\\\\n```\\\\n-e NODE_EXTRA_CA_CERTS=/home/node/sourcegraph.example.com.crt -v ~/.sourcegraph/config:/home/node\\\\n```\\\\n\\\\nThe self signed certificate's `Common Name (CN)` should be the host name of your host. Also make sure you use Websocket with SSL in your Sourcegraph settings to connect to the language server:\\\\n\\\\n```json\\\\n\\\\\\\"typescript.serverUrl\\\\\\\": \\\\\\\"wss://localhost:8080\\\\\\\"\\\\n```\\\\n\\\\n### Authentication proxies and firewalls\\\\n\\\\nSome customers deploy Sourcegraph behind an authentication proxy or firewall. If you do this, we\\\\nrecommend deploying the language server behind the proxy so that it can issue requests directly to\\\\nSourcegraph without going through the proxy. (Otherwise, you will need to configure the language\\\\nserver to authenticate through your proxy.) Make sure you set `typescript.sourcegraphUrl` to the URL\\\\nthat the language server should use to reach Sourcegraph, which is likely different from the URL\\\\nthat end users use.\\\\n\\\\n### Using Kubernetes\\\\n\\\\nTo deploy the language server with Kubernetes, use a deployment like this:\\\\n\\\\n```yaml\\\\napiVersion: apps/v1\\\\nkind: Deployment\\\\nmetadata:\\\\n  name: lang-typescript\\\\nspec:\\\\n  replicas: 4 # adjust as needed\\\\n  selector:\\\\n    matchLabels:\\\\n      app: lang-typescript\\\\n  template:\\\\n    metadata:\\\\n      labels:\\\\n        app: lang-typescript\\\\n    spec:\\\\n      containers:\\\\n        - name: lang-typescript\\\\n          image: sourcegraph/lang-typescript\\\\n          ports:\\\\n            - containerPort: 8080\\\\n              name: wss\\\\n          env:\\\\n            # TLS certificate and key to secure the WebSocket connection (optional)\\\\n            - name: TLS_CERT\\\\n              value: ... your TLS certificate ...\\\\n            - name: TLS_KEY\\\\n              value: ... your TLS key ...\\\\n          # Resources to provision for the server (adjust as needed)\\\\n          resources:\\\\n            limits:\\\\n              cpu: '4'\\\\n              memory: 5Gi\\\\n            requests:\\\\n              cpu: 500m\\\\n              memory: 2Gi\\\\n          # Probes the server periodically to see if it is healthy\\\\n          livenessProbe:\\\\n            initialDelaySeconds: 30\\\\n            tcpSocket:\\\\n              port: wss\\\\n            timeoutSeconds: 5\\\\n          readinessProbe:\\\\n            tcpSocket:\\\\n              port: wss\\\\n```\\\\n\\\\nWith a corresponding service:\\\\n\\\\n```yaml\\\\napiVersion: v1\\\\nkind: Service\\\\nmetadata:\\\\n  labels:\\\\n    app: lang-typescript\\\\n    deploy: lang-typescript\\\\n  name: lang-typescript\\\\nspec:\\\\n  ports:\\\\n    - name: wss\\\\n      port: 443\\\\n      targetPort: wss\\\\n  selector:\\\\n    app: lang-typescript\\\\n  type: LoadBalancer\\\\n```\\\\n\\\\n#### TLS\\\\n\\\\nTo enable TLS, set the `TLS_KEY` and `TLS_CERT` environment variables. TLS optional but **strongly recommended** for production deployments.\\\\n\\\\n#### Enabling Prometheus metrics\\\\n\\\\nThe server exposes metrics on port 6060 that can be scraped by Prometheus.\\\\n\\\\n#### Improving performance with an SSD\\\\n\\\\nTo improve performance of dependency installation, the server can be configured to use a mounted SSD at a given directory by setting the `CACHE_DIR` environment variable. The instructions for how to mount a SSD depend on your deployment environment.\\\\n\\\\n1. Add a volume for the mount path of the SSD:\\\\n\\\\n   ```diff\\\\n     spec:\\\\n   + volumes:\\\\n   +   - hostPath:\\\\n   +       path: /path/to/mounted/ssd\\\\n   +     name: cache-ssd\\\\n   ```\\\\n\\\\n   For example, Google Cloud Platform mounts the first SSD disk to `/mnt/disks/ssd0`.\\\\n\\\\n2. Add a volume mount to the container spec:\\\\n\\\\n   ```diff\\\\n     image: sourcegraph/lang-typescript\\\\n   + volumeMounts:\\\\n   +   - mountPath: /mnt/cache\\\\n   +     name: cache-ssd\\\\n   ```\\\\n\\\\n3. Tell the language server to use the mount as the root for temporary directories:\\\\n\\\\n   ```diff\\\\n     env:\\\\n   +   - name: CACHE_DIR\\\\n   +     value: /mnt/cache\\\\n   ```\\\\n\\\\n#### Improving performance with an npm registry proxy\\\\n\\\\nTo further speed up dependency installation, all npm registry requests can be proxied through a cache running on the same node.\\\\n\\\\nExample deployment for Kubernetes:\\\\n\\\\n```yaml\\\\napiVersion: apps/v1\\\\nkind: Deployment\\\\nmetadata:\\\\n  name: npm-proxy\\\\nspec:\\\\n  minReadySeconds: 10\\\\n  replicas: 1\\\\n  revisionHistoryLimit: 10\\\\n  strategy:\\\\n    rollingUpdate:\\\\n      maxSurge: 1\\\\n      maxUnavailable: 1\\\\n    type: RollingUpdate\\\\n  template:\\\\n    metadata:\\\\n      labels:\\\\n        app: npm-proxy\\\\n    spec:\\\\n      containers:\\\\n        - image: sourcegraph/npm-proxy:latest\\\\n          name: npm-proxy\\\\n          ports:\\\\n            - containerPort: 8080\\\\n              name: http\\\\n          resources:\\\\n            limits:\\\\n              cpu: '1'\\\\n              memory: 1Gi\\\\n          volumeMounts:\\\\n            - mountPath: /cache\\\\n              name: npm-proxy-cache\\\\n      volumes:\\\\n        - name: npm-proxy-cache\\\\n          persistentVolumeClaim:\\\\n            claimName: npm-proxy\\\\n---\\\\napiVersion: v1\\\\nkind: PersistentVolumeClaim\\\\nmetadata:\\\\n  annotations:\\\\n    volume.beta.kubernetes.io/storage-class: default\\\\n  name: npm-proxy\\\\nspec:\\\\n  accessModes:\\\\n    - ReadWriteOnce\\\\n  resources:\\\\n    requests:\\\\n      storage: 100Gi\\\\n---\\\\napiVersion: v1\\\\nkind: Service\\\\nmetadata:\\\\n  labels:\\\\n    app: npm-proxy\\\\n  name: npm-proxy\\\\nspec:\\\\n  ports:\\\\n    - name: http\\\\n      port: 8080\\\\n      targetPort: http\\\\n  selector:\\\\n    app: npm-proxy\\\\n  type: ClusterIP\\\\n```\\\\n\\\\nThen define a `.yarnrc` as a config map that points to the proxy:\\\\n\\\\n```yaml\\\\napiVersion: v1\\\\ndata:\\\\n  .yarnrc: |\\\\n    # THIS IS AN AUTOGENERATED FILE. DO NOT EDIT THIS FILE DIRECTLY.\\\\n    # yarn lockfile v1\\\\n\\\\n\\\\n    https-proxy \\\\\\\"http://npm-proxy:8080\\\\\\\"\\\\n    proxy \\\\\\\"http://npm-proxy:8080\\\\\\\"\\\\n    strict-ssl false\\\\nkind: ConfigMap\\\\nmetadata:\\\\n  name: yarn-config\\\\n```\\\\n\\\\nand mount it into the container:\\\\n\\\\n```diff\\\\n  name: lang-typescript\\\\n+ volumeMounts:\\\\n+  - mountPath: /yarn-config\\\\n+    name: yarn-config\\\\n```\\\\n\\\\n```diff\\\\n  spec:\\\\n+   volumes:\\\\n+     - configMap:\\\\n+         name: yarn-config\\\\n+       name: yarn-config\\\\n```\\\\n\\\\n## Support for dependencies on private packages and git repositories\\\\n\\\\nDependencies on private npm packages and private registries is supported by setting the `typescript.npmrc` setting.\\\\nIt contains the same key/value settings as your `.npmrc` file in your home folder, and therefor supports the same scoping to registries and package scopes.\\\\nSee https://docs.npmjs.com/misc/config#config-settings for more information on what is possible to configure in `.npmrc`.\\\\n\\\\nExample:\\\\n\\\\n```json\\\\n\\\\\\\"typescript.npmrc\\\\\\\": {\\\\n  \\\\\\\"//registry.npmjs.org/:_authToken\\\\\\\": \\\\\\\"asfdh21e-1234-asdn-123v-1234asdb2\\\\\\\"\\\\n}\\\\n```\\\\n\\\\nFor dependencies on private git repositories, mount an SSH key into `~/.ssh`.\\\\n\\\\n## Viewing communication between the browser and language server\\\\n\\\\nThis extension communicates from your browser to the language server that you deployed over WebSockets. This means that when you're viewing a code file on Sourcegraph, you can open the browser developer tools and refresh the page to capture the WebSocket connection and view the messages being sent and received:\\\\n\\\\n![image](https://user-images.githubusercontent.com/1387653/53431623-c0e30000-39a5-11e9-963d-42260ca12de3.png)\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/typescript\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts \\\\u0026\\\\u0026 ../../node_modules/.bin/dot-json dist/extension.map sourceRoot https://sourcegraph.com/github.com/sourcegraph/sourcegraph-typescript@$(git rev-parse HEAD)/-/raw/extension/src/\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o src/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"typescript\\\",\\n    \\\"javascript\\\",\\n    \\\"cross-repository\\\",\\n    \\\"language-server\\\",\\n    \\\"react\\\",\\n    \\\"jsx\\\"\\n  ],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9199-sourcegraph-typescript.js?c6zthubm11g0--sourcegraph-typescript\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"TypeScript/JavaScript code intelligence\"},\"createdAt\":\"2019-01-26T03:39:17Z\",\"updatedAt\":\"2019-01-26T03:39:17Z\",\"url\":\"/extensions/sourcegraph/typescript\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxNjl9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/go\",\"extensionIDWithoutRegistry\":\"sourcegraph/go\",\"name\":\"go\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:go\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [\\n      {\\n        \\\"actionItem\\\": {\\n          \\\"label\\\": \\\"${config.go.showExternalReferences \\\\u0026\\\\u0026 \\\\\\\"Hide references from other repositories\\\\\\\" || \\\\\\\"Show references from other repositories\\\\\\\"}\\\"\\n        },\\n        \\\"command\\\": \\\"updateConfiguration\\\",\\n        \\\"commandArguments\\\": [\\n          [\\n            \\\"go.showExternalReferences\\\"\\n          ],\\n          \\\"${!config.go.showExternalReferences}\\\",\\n          null,\\n          \\\"json\\\"\\n        ],\\n        \\\"id\\\": \\\"externalReferences.toggle\\\",\\n        \\\"title\\\": \\\"${config.go.showExternalReferences \\\\u0026\\\\u0026 \\\\\\\"Hide references from other repositories\\\\\\\" || \\\\\\\"Show references from other repositories\\\\\\\"}\\\"\\n      }\\n    ],\\n    \\\"configuration\\\": {\\n      \\\"additionalProperties\\\": false,\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"go.accessToken\\\": {\\n          \\\"description\\\": \\\"The access token for the language server to use to fetch files from the Sourcegraph API. The extension will create this token and save it in your settings automatically.\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        },\\n        \\\"go.corsAnywhereURL\\\": {\\n          \\\"description\\\": \\\"Address of a cors-anywhere service. This will cause the extension to send GDDO requests to this service instead of directly to api.godoc.org. For example: https://cors-anywhere.sourcegraph.com/https://api.godoc.org/importersgithub.com/sourcegraph/go-lsp. This would not be necessary if godoc.org set CORS headers.\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        },\\n        \\\"go.gddoURL\\\": {\\n          \\\"description\\\": \\\"The address to Go Doc Dot Org or a proxy that speaks the same API (only used on Sourcegraph.com).\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        },\\n        \\\"go.maxExternalReferenceRepos\\\": {\\n          \\\"description\\\": \\\"The maximum number of repositories to look in when searching for external references for a symbol (defaults to 20).\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"go.serverUrl\\\": {\\n          \\\"description\\\": \\\"The address of the WebSocket language server to connect to (e.g. ws://host:4389).\\\",\\n          \\\"format\\\": \\\"url\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        },\\n        \\\"go.showExternalReferences\\\": {\\n          \\\"description\\\": \\\"Whether or not a second references provider for external references will be registered (defaults to false).\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"go.sourcegraphUrl\\\": {\\n          \\\"description\\\": \\\"The address of the Sourcegraph instance from the perspective of the Go language server.\\\",\\n          \\\"format\\\": \\\"url\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Settings\\\",\\n      \\\"type\\\": \\\"object\\\"\\n    },\\n    \\\"menus\\\": {\\n      \\\"panel/toolbar\\\": [\\n        {\\n          \\\"action\\\": \\\"externalReferences.toggle\\\",\\n          \\\"when\\\": \\\"panel.activeView.id == 'references'\\\"\\n        }\\n      ]\\n    }\\n  },\\n  \\\"description\\\": \\\"Go code intelligence\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/go\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"go\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Go\\\\n\\\\nThis extension provides Go code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/go)\\\\n\\\\n![Go code intelligence](https://user-images.githubusercontent.com/1387653/49856504-ce281f80-fda4-11e8-933b-f8fc67c98daf.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/go` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/go) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/go`, and enable it.\\\\n1. Visit any Go code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\\n## Language server\\\\n\\\\nThis extension communicates with a language server over WebSockets. On Sourcegraph.com, this extension is already configured. If you are running a\\\\nprivate Sourcegraph instance, you should run your own language server. The server is available as a Docker image `sourcegraph/lang-go` from Docker Hub.\\\\n\\\\n### 🔐 Secure deployment 🔐\\\\n\\\\nIf you have private code, we recommend deploying the language server behind an\\\\nauth proxy (such as the example below using HTTP basic authentication in NGINX), a firewall, or a VPN.\\\\n\\\\n### HTTP basic authentication\\\\n\\\\nYou can prevent unauthorized access to the language server by enforcing HTTP basic authentication in nginx, which comes with the sourcegraph/server image. At a high level, you'll create a secret then put it in both the nginx config and in your Sourcegraph global settings so that logged-in users are authenticated when their browser makes requests to the Go language server.\\\\n\\\\nHere's how to set it up:\\\\n\\\\nCreate an `.htpasswd` file in the Sourcegraph config directory with one entry:\\\\n\\\\n```\\\\n$ htpasswd -c ~/.sourcegraph/config/.htpasswd langserveruser\\\\nNew password:\\\\nRe-type new password:\\\\nAdding password for user langserveruser\\\\n```\\\\n\\\\nAdd a location directive the [nginx.conf](https://docs.sourcegraph.com/admin/nginx) that will route requests to the Go language server:\\\\n\\\\n```nginx\\\\n...\\\\nhttp {\\\\n    ...\\\\n    server {\\\\n        ...\\\\n        location / {\\\\n            ...\\\\n        }\\\\n\\\\n        location /go {\\\\n            proxy_pass http://host.docker.internal:4389;\\\\n            proxy_http_version 1.1;\\\\n            proxy_set_header Upgrade $http_upgrade;\\\\n            proxy_set_header Connection \\\\\\\"Upgrade\\\\\\\";\\\\n\\\\n            auth_basic \\\\\\\"basic authentication is required to access the language server\\\\\\\";\\\\n            auth_basic_user_file /etc/sourcegraph/.htpasswd;\\\\n        }\\\\n    }\\\\n}\\\\n```\\\\n\\\\n- If you're running the quickstart on Linux, change `host.docker.internal` to the output of `ip addr show docker0 | grep -Po 'inet \\\\\\\\K[\\\\\\\\d.]+'`.\\\\n- If you're using [Kubernetes](#using-kubernetes) (e.g. [deploy-sourcegraph](https://github.com/sourcegraph/deploy-sourcegraph)), change `host.docker.internal` to `lang-go`.\\\\n\\\\nAdd these to your Sourcegraph global settings:\\\\n\\\\n```\\\\n  \\\\\\\"go.serverUrl\\\\\\\": \\\\\\\"ws://langserveruser:PASSWORD@example.host.docker.internal:7080/go\\\\\\\",\\\\n  \\\\\\\"go.sourcegraphUrl\\\\\\\": \\\\\\\"http://example.host.docker.internal:7080\\\\\\\",\\\\n```\\\\n\\\\nFill in the `PASSWORD` that you created above.\\\\n\\\\n- If you're running the quickstart on macOS, change `example.host.docker.internal` to `host.docker.internal`.\\\\n- If you're running the quickstart on Linux, change `example.host.docker.internal` to the output of `ip addr show docker0 | grep -Po 'inet \\\\\\\\K[\\\\\\\\d.]+'`.\\\\n- If you're using [Kubernetes](#using-kubernetes) (e.g. [deploy-sourcegraph](https://github.com/sourcegraph/deploy-sourcegraph)):\\\\n  - `go.serverUrl` is the address of the Go language server from the perspective of a user's browser (e.g. https://sourcegraph.example.com/go)\\\\n  - `go.sourcegraphUrl` is the address of the Sourcegraph instance from the perspective of the Go language server (e.g. http://sourcegraph-frontend:30080)\\\\n\\\\nFinally, restart the sourcegraph/server container (or nginx deployment if deployed to Kubernetes) to pick up the configuration change.\\\\n\\\\nAfter deploying the language server, unauthenticated access to `http://localhost:7080/go` (or https://sourcegraph.example.com/go) should be blocked, but code intelligence should work when you're logged in.\\\\n\\\\nYou can always revoke the `PASSWORD` by deleting the `.htpasswd` file and restarting nginx.\\\\n\\\\n### Using Docker\\\\n\\\\n1. Run the Go language server:\\\\n\\\\n   ```sh\\\\n   docker run --rm --name lang-go -p 4389:4389 sourcegraph/lang-go \\\\\\\\\\\\n     go-langserver -mode=websocket -addr=:4389 -usebuildserver -usebinarypkgcache=false -freeosmemory=false\\\\n   ```\\\\n\\\\n   You can verify it's up and running with [`ws`](https://github.com/hashrocket/ws) (run this from the same machine your browser is running on):\\\\n\\\\n   ```sh\\\\n   $ go get -u github.com/hashrocket/ws\\\\n   $ ws ws://localhost:4389\\\\n   \\\\u003e\\\\n   ```\\\\n\\\\n1. Enable this extension on your Sourcegraph https://sourcegraph.example.com/extensions/sourcegraph/go\\\\n\\\\n1. Add these to your Sourcegraph settings in https://sourcegraph.example.com/site-admin/global-settings and make sure the port matches either the Docker command or your Kubernetes config:\\\\n\\\\n   ```sh\\\\n   \\\\\\\"go.serverUrl\\\\\\\": \\\\\\\"ws://localhost:4389\\\\\\\",\\\\n   \\\\\\\"go.sourcegraphUrl\\\\\\\": \\\\\\\"http://host.docker.internal:7080\\\\\\\",\\\\n   ```\\\\n\\\\n   If you're running on Linux, change `go.sourcegraphUrl` to the IP given by:\\\\n\\\\n   ```bash\\\\n   ip addr show docker0 | grep -Po 'inet \\\\\\\\K[\\\\\\\\d.]+'\\\\n   ```\\\\n\\\\nNow visit a Go file and you should see code intelligence!\\\\n\\\\n### Using Kubernetes\\\\n\\\\nTo deploy the language server with Kubernetes, use a deployment like this:\\\\n\\\\n```yaml\\\\napiVersion: extensions/v1beta1\\\\nkind: Deployment\\\\nmetadata:\\\\n  annotations:\\\\n    description: Go code intelligence provided by lang-go\\\\n  name: lang-go\\\\n  namespace: prod\\\\nspec:\\\\n  minReadySeconds: 10\\\\n  replicas: 1\\\\n  revisionHistoryLimit: 10\\\\n  strategy:\\\\n    rollingUpdate:\\\\n      maxSurge: 1\\\\n      maxUnavailable: 1\\\\n    type: RollingUpdate\\\\n  template:\\\\n    metadata:\\\\n      labels:\\\\n        app: lang-go\\\\n    spec:\\\\n      containers:\\\\n        - args:\\\\n            - go-langserver\\\\n            - -mode=websocket\\\\n            - -addr=:4389\\\\n            - -usebuildserver\\\\n            - -usebinarypkgcache=false\\\\n            - -cachedir=$(CACHE_DIR)\\\\n            - -freeosmemory=false\\\\n          env:\\\\n            # TLS is optional\\\\n            - name: TLS_CERT\\\\n              valueFrom:\\\\n                secretKeyRef:\\\\n                  key: cert\\\\n                  name: tls\\\\n            - name: TLS_KEY\\\\n              valueFrom:\\\\n                secretKeyRef:\\\\n                  key: key\\\\n                  name: tls\\\\n            - name: POD_NAME\\\\n              valueFrom:\\\\n                fieldRef:\\\\n                  fieldPath: metadata.name\\\\n            - name: CACHE_DIR\\\\n              value: /mnt/cache/$(POD_NAME)\\\\n          image: sourcegraph/lang-go:latest\\\\n          livenessProbe:\\\\n            initialDelaySeconds: 5\\\\n            tcpSocket:\\\\n              port: lsp\\\\n            timeoutSeconds: 5\\\\n          name: lang-go\\\\n          ports:\\\\n            - containerPort: 4389\\\\n              name: lsp\\\\n            - containerPort: 6060\\\\n              name: debug\\\\n          readinessProbe:\\\\n            tcpSocket:\\\\n              port: 4389\\\\n          resources:\\\\n            limits:\\\\n              cpu: '8'\\\\n              memory: 10G\\\\n            requests:\\\\n              cpu: '1'\\\\n              memory: 10G\\\\n          volumeMounts:\\\\n            - mountPath: /mnt/cache\\\\n              name: cache-ssd\\\\n      volumes:\\\\n        - hostPath:\\\\n            path: /mnt/disks/ssd0/pod-tmp\\\\n          name: cache-ssd\\\\n```\\\\n\\\\nWith a corresponding service:\\\\n\\\\n```yaml\\\\napiVersion: v1\\\\nkind: Service\\\\nmetadata:\\\\n  annotations:\\\\n    prometheus.io/port: '6060'\\\\n    prometheus.io/scrape: 'true'\\\\n  labels:\\\\n    app: lang-go\\\\n  name: lang-go\\\\n  namespace: prod\\\\nspec:\\\\n  loadBalancerIP: your.static.ip.address\\\\n  ports:\\\\n    - name: debug\\\\n      port: 6060\\\\n      targetPort: debug\\\\n    - name: lsp\\\\n      port: 443\\\\n      targetPort: lsp\\\\n  selector:\\\\n    app: lang-go\\\\n  type: LoadBalancer\\\\n```\\\\n\\\\n#### TLS\\\\n\\\\nTo enable TLS, set the `TLS_KEY` and `TLS_CERT` environment variables. TLS optional but **strongly recommended** for production deployments.\\\\n\\\\n#### Scaling out by increasing the replica count\\\\n\\\\nTo run multiple instances of the go-langserver and distribute connections between them in Kubernetes, set `spec.replicas` in the deployment YAML:\\\\n\\\\n```diff\\\\n spec:\\\\n   minReadySeconds: 10\\\\n-  replicas: 1\\\\n+  replicas: 5\\\\n   revisionHistoryLimit: 10\\\\n```\\\\n\\\\n## Support for dependencies on private git repositories\\\\n\\\\n🚨 Before mounting your credentials into the language server, make sure the language server is hidden behind an auth proxy or firewall. 🚨\\\\n\\\\n### Private dependencies via `.netrc`\\\\n\\\\nMake sure your `$HOME/.netrc` contains:\\\\n\\\\n```\\\\nmachine codeload.github.com\\\\nlogin \\\\u003cyour username\\\\u003e\\\\npassword \\\\u003cyour password OR access token\\\\u003e\\\\n```\\\\n\\\\nMount it into the container:\\\\n\\\\n```\\\\ndocker run ... -v \\\\\\\"$HOME/.netrc\\\\\\\":/root/.netrc ...\\\\n```\\\\n\\\\nVerify fetching works:\\\\n\\\\n```\\\\n$ docker exec -ti lang-go sh\\\\n# curl -n https://codeload.github.com/you/your-private-repo/zip/master\\\\nHTTP/1.1 200 OK\\\\n...\\\\n```\\\\n\\\\n### Private dependencies via SSH keys\\\\n\\\\nMake sure your `~/.gitconfig` contains these lines:\\\\n\\\\n```\\\\n[url \\\\\\\"git@github.com:\\\\\\\"]\\\\n    insteadOf = https://github.com/\\\\n```\\\\n\\\\nMount that and your SSH keys into the container:\\\\n\\\\n```\\\\ndocker run ... -v \\\\\\\"$HOME/.gitconfig\\\\\\\":/root/.gitconfig -v \\\\\\\"$HOME/.ssh\\\\\\\":/root/.ssh ...\\\\n```\\\\n\\\\nVerify cloning works:\\\\n\\\\n```\\\\n$ docker exec -ti lang-go sh\\\\n# git clone https://github.com/you/your-private-repo\\\\nCloning into 'your-private-repo'...\\\\n```\\\\n\\\\n## Viewing communication between the browser and language server\\\\n\\\\nThis extension communicates from your browser to the language server that you deployed over WebSockets. This means that when you're viewing a code file on Sourcegraph, you can open the browser developer tools and refresh the page to capture the WebSocket connection and view the messages being sent and received:\\\\n\\\\n![image](https://user-images.githubusercontent.com/1387653/53431623-c0e30000-39a5-11e9-963d-42260ca12de3.png)\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/go\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts \\\\u0026\\\\u0026 ../../node_modules/.bin/dot-json dist/extension.map sourceRoot https://sourcegraph.com/github.com/sourcegraph/sourcegraph-go@$(git rev-parse HEAD)/-/raw/extension/src/\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o src/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"go\\\",\\n    \\\"cross-repository\\\",\\n    \\\"language-server\\\"\\n  ],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9178-sourcegraph-go.js?c6zthr75n9qo--sourcegraph-go\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Go code intelligence\"},\"createdAt\":\"2019-01-26T03:40:55Z\",\"updatedAt\":\"2019-01-26T03:40:55Z\",\"url\":\"/extensions/sourcegraph/go\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxNzF9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/cpp\",\"extensionIDWithoutRegistry\":\"sourcegraph/cpp\",\"name\":\"cpp\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:cpp\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for C++ using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/cpp\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"cpp\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for C++\\\\n\\\\nThis extension provides C++ code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/cpp` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/cpp) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/cpp`, and enable it.\\\\n1. Visit any C++ code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using cpp on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"C++ code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9198-sourcegraph-cpp.js?c6zthu9grbgw--sourcegraph-cpp\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for C++ using the Sourcegraph search API\"},\"createdAt\":\"2019-01-29T07:02:57Z\",\"updatedAt\":\"2019-01-29T07:02:57Z\",\"url\":\"/extensions/sourcegraph/cpp\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxNzJ9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/r\",\"extensionIDWithoutRegistry\":\"sourcegraph/r\",\"name\":\"r\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:r\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for R using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/r\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"r\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for R\\\\n\\\\nThis extension provides R code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/r` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/r) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/r`, and enable it.\\\\n1. Visit any R code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using r on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"R code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9183-sourcegraph-r.js?c6zthsiawwow--sourcegraph-r\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for R using the Sourcegraph search API\"},\"createdAt\":\"2019-01-29T07:03:17Z\",\"updatedAt\":\"2019-01-29T07:03:17Z\",\"url\":\"/extensions/sourcegraph/r\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxNzN9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/java\",\"extensionIDWithoutRegistry\":\"sourcegraph/java\",\"name\":\"java\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:java\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for Java using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/java\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"java\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Java\\\\n\\\\nThis extension provides Java code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/java` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/java) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/java`, and enable it.\\\\n1. Visit any Java code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using java on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"Java code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9197-sourcegraph-java.js?c6zthu8kgf9s--sourcegraph-java\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for Java using the Sourcegraph search API\"},\"createdAt\":\"2019-01-29T07:08:37Z\",\"updatedAt\":\"2019-01-29T07:08:37Z\",\"url\":\"/extensions/sourcegraph/java\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxNzR9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/ruby\",\"extensionIDWithoutRegistry\":\"sourcegraph/ruby\",\"name\":\"ruby\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:ruby\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for Ruby using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/ruby\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"ruby\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Ruby\\\\n\\\\nThis extension provides Ruby code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/ruby` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/ruby) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/ruby`, and enable it.\\\\n1. Visit any Ruby code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using ruby on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"Ruby code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9177-sourcegraph-ruby.js?c6zthq88tpgo--sourcegraph-ruby\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for Ruby using the Sourcegraph search API\"},\"createdAt\":\"2019-01-29T07:09:12Z\",\"updatedAt\":\"2019-01-29T07:09:12Z\",\"url\":\"/extensions/sourcegraph/ruby\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxNzV9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/php\",\"extensionIDWithoutRegistry\":\"sourcegraph/php\",\"name\":\"php\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:php\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for PHP using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/php\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"php\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for PHP\\\\n\\\\nThis extension provides PHP code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/php` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/php) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/php`, and enable it.\\\\n1. Visit any PHP code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using php on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"PHP code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9192-sourcegraph-php.js?c6zthtczy5ow--sourcegraph-php\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for PHP using the Sourcegraph search API\"},\"createdAt\":\"2019-01-29T07:09:33Z\",\"updatedAt\":\"2019-01-29T07:09:33Z\",\"url\":\"/extensions/sourcegraph/php\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxNzZ9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/csharp\",\"extensionIDWithoutRegistry\":\"sourcegraph/csharp\",\"name\":\"csharp\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:csharp\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for C# using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/csharp\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"csharp\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for C#\\\\n\\\\nThis extension provides C# code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/csharp` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/csharp) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/csharp`, and enable it.\\\\n1. Visit any C# code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using csharp on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"C# code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9206-sourcegraph-csharp.js?c6zthvg2tb9s--sourcegraph-csharp\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for C# using the Sourcegraph search API\"},\"createdAt\":\"2019-01-29T07:09:51Z\",\"updatedAt\":\"2019-01-29T07:09:51Z\",\"url\":\"/extensions/sourcegraph/csharp\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxNzd9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/shell\",\"extensionIDWithoutRegistry\":\"sourcegraph/shell\",\"name\":\"shell\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:shell\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for Shell using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/shell\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"shell\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Shell\\\\n\\\\nThis extension provides Shell code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/shell` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/shell) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/shell`, and enable it.\\\\n1. Visit any Shell code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using shell on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"Shell code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9209-sourcegraph-shell.js?c6zthwd6gkq8--sourcegraph-shell\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for Shell using the Sourcegraph search API\"},\"createdAt\":\"2019-01-29T07:10:09Z\",\"updatedAt\":\"2019-01-29T07:10:09Z\",\"url\":\"/extensions/sourcegraph/shell\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxNzh9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/scala\",\"extensionIDWithoutRegistry\":\"sourcegraph/scala\",\"name\":\"scala\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:scala\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for Scala using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/scala\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"scala\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Scala\\\\n\\\\nThis extension provides Scala code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/scala` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/scala) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/scala`, and enable it.\\\\n1. Visit any Scala code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using scala on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"Scala code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9190-sourcegraph-scala.js?c6zthsykvoq8--sourcegraph-scala\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for Scala using the Sourcegraph search API\"},\"createdAt\":\"2019-01-29T07:10:26Z\",\"updatedAt\":\"2019-01-29T07:10:26Z\",\"url\":\"/extensions/sourcegraph/scala\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxNzl9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/swift\",\"extensionIDWithoutRegistry\":\"sourcegraph/swift\",\"name\":\"swift\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:swift\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for Swift using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/swift\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"swift\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Swift\\\\n\\\\nThis extension provides Swift code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/swift` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/swift) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/swift`, and enable it.\\\\n1. Visit any Swift code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using swift on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"Swift code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9182-sourcegraph-swift.js?c6zths1f5ffc--sourcegraph-swift\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for Swift using the Sourcegraph search API\"},\"createdAt\":\"2019-01-29T07:10:46Z\",\"updatedAt\":\"2019-01-29T07:10:46Z\",\"url\":\"/extensions/sourcegraph/swift\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxODB9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/rust\",\"extensionIDWithoutRegistry\":\"sourcegraph/rust\",\"name\":\"rust\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:rust\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for Rust using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/rust\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"rust\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Rust\\\\n\\\\nThis extension provides Rust code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/rust` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/rust) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/rust`, and enable it.\\\\n1. Visit any Rust code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using rust on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"Rust code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9188-sourcegraph-rust.js?c6zthsw5lvsg--sourcegraph-rust\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for Rust using the Sourcegraph search API\"},\"createdAt\":\"2019-01-29T07:11:03Z\",\"updatedAt\":\"2019-01-29T07:11:03Z\",\"url\":\"/extensions/sourcegraph/rust\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxODF9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/kotlin\",\"extensionIDWithoutRegistry\":\"sourcegraph/kotlin\",\"name\":\"kotlin\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:kotlin\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for Kotlin using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/kotlin\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"kotlin\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Kotlin\\\\n\\\\nThis extension provides Kotlin code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/kotlin` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/kotlin) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/kotlin`, and enable it.\\\\n1. Visit any Kotlin code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using kotlin on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"Kotlin code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9186-sourcegraph-kotlin.js?c6zthsq7t600--sourcegraph-kotlin\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for Kotlin using the Sourcegraph search API\"},\"createdAt\":\"2019-01-29T07:11:20Z\",\"updatedAt\":\"2019-01-29T07:11:20Z\",\"url\":\"/extensions/sourcegraph/kotlin\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxODJ9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/elixir\",\"extensionIDWithoutRegistry\":\"sourcegraph/elixir\",\"name\":\"elixir\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:elixir\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for Elixir using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/elixir\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"elixir\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Elixir\\\\n\\\\nThis extension provides Elixir code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/elixir` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/elixir) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/elixir`, and enable it.\\\\n1. Visit any Elixir code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using elixir on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"Elixir code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9201-sourcegraph-elixir.js?c6zthujs76tc--sourcegraph-elixir\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for Elixir using the Sourcegraph search API\"},\"createdAt\":\"2019-01-29T07:11:38Z\",\"updatedAt\":\"2019-01-29T07:11:38Z\",\"url\":\"/extensions/sourcegraph/elixir\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxODN9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/perl\",\"extensionIDWithoutRegistry\":\"sourcegraph/perl\",\"name\":\"perl\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:perl\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for Perl using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/perl\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"perl\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Perl\\\\n\\\\nThis extension provides Perl code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/perl` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/perl) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/perl`, and enable it.\\\\n1. Visit any Perl code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using perl on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"Perl code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9193-sourcegraph-perl.js?c6zthtgvv70w--sourcegraph-perl\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for Perl using the Sourcegraph search API\"},\"createdAt\":\"2019-01-29T07:13:33Z\",\"updatedAt\":\"2019-01-29T07:13:33Z\",\"url\":\"/extensions/sourcegraph/perl\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxODR9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/lua\",\"extensionIDWithoutRegistry\":\"sourcegraph/lua\",\"name\":\"lua\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:lua\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for Lua using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/lua\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"lua\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Lua\\\\n\\\\nThis extension provides Lua code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/lua` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/lua) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/lua`, and enable it.\\\\n1. Visit any Lua code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using lua on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"Lua code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9180-sourcegraph-lua.js?c6zthrwi77hs--sourcegraph-lua\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for Lua using the Sourcegraph search API\"},\"createdAt\":\"2019-01-29T07:13:51Z\",\"updatedAt\":\"2019-01-29T07:13:51Z\",\"url\":\"/extensions/sourcegraph/lua\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxODV9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/clojure\",\"extensionIDWithoutRegistry\":\"sourcegraph/clojure\",\"name\":\"clojure\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:clojure\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for Clojure using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/clojure\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"clojure\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Clojure\\\\n\\\\nThis extension provides Clojure code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/clojure` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/clojure) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/clojure`, and enable it.\\\\n1. Visit any Clojure code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using clojure on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"Clojure code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9196-sourcegraph-clojure.js?c6zthu0sd0yg--sourcegraph-clojure\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for Clojure using the Sourcegraph search API\"},\"createdAt\":\"2019-01-29T07:14:10Z\",\"updatedAt\":\"2019-01-29T07:14:10Z\",\"url\":\"/extensions/sourcegraph/clojure\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxODZ9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/haskell\",\"extensionIDWithoutRegistry\":\"sourcegraph/haskell\",\"name\":\"haskell\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:haskell\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for Haskell using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/haskell\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"haskell\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Haskell\\\\n\\\\nThis extension provides Haskell code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/haskell` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/haskell) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/haskell`, and enable it.\\\\n1. Visit any Haskell code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using haskell on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"Haskell code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9185-sourcegraph-haskell.js?c6zthsj9xtfs--sourcegraph-haskell\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for Haskell using the Sourcegraph search API\"},\"createdAt\":\"2019-01-29T07:15:06Z\",\"updatedAt\":\"2019-01-29T07:15:06Z\",\"url\":\"/extensions/sourcegraph/haskell\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxODd9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/powershell\",\"extensionIDWithoutRegistry\":\"sourcegraph/powershell\",\"name\":\"powershell\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:powershell\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for PowerShell using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/powershell\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"powershell\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for PowerShell\\\\n\\\\nThis extension provides PowerShell code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/powershell` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/powershell) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/powershell`, and enable it.\\\\n1. Visit any PowerShell code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using powershell on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"PowerShell code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9184-sourcegraph-powershell.js?c6zthsij36ts--sourcegraph-powershell\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for PowerShell using the Sourcegraph search API\"},\"createdAt\":\"2019-01-29T07:15:23Z\",\"updatedAt\":\"2019-01-29T07:15:23Z\",\"url\":\"/extensions/sourcegraph/powershell\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxODh9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/lisp\",\"extensionIDWithoutRegistry\":\"sourcegraph/lisp\",\"name\":\"lisp\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:lisp\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for Lisp using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/lisp\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"lisp\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Lisp\\\\n\\\\nThis extension provides Lisp code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/lisp` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/lisp) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/lisp`, and enable it.\\\\n1. Visit any Lisp code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using lisp on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"Lisp code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9189-sourcegraph-lisp.js?c6zthsy9esj4--sourcegraph-lisp\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for Lisp using the Sourcegraph search API\"},\"createdAt\":\"2019-01-29T07:15:40Z\",\"updatedAt\":\"2019-01-29T07:15:40Z\",\"url\":\"/extensions/sourcegraph/lisp\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxODl9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/erlang\",\"extensionIDWithoutRegistry\":\"sourcegraph/erlang\",\"name\":\"erlang\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:erlang\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for Erlang using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/erlang\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"erlang\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Erlang\\\\n\\\\nThis extension provides Erlang code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/erlang` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/erlang) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/erlang`, and enable it.\\\\n1. Visit any Erlang code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using erlang on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"Erlang code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9204-sourcegraph-erlang.js?c6zthuxz4lmg--sourcegraph-erlang\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for Erlang using the Sourcegraph search API\"},\"createdAt\":\"2019-01-29T07:15:58Z\",\"updatedAt\":\"2019-01-29T07:15:58Z\",\"url\":\"/extensions/sourcegraph/erlang\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxOTB9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/dart\",\"extensionIDWithoutRegistry\":\"sourcegraph/dart\",\"name\":\"dart\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:dart\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for Dart using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/dart\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"dart\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Dart\\\\n\\\\nThis extension provides Dart code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/dart` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/dart) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/dart`, and enable it.\\\\n1. Visit any Dart code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using dart on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"Dart code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9203-sourcegraph-dart.js?c6zthuumb65c--sourcegraph-dart\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for Dart using the Sourcegraph search API\"},\"createdAt\":\"2019-01-29T07:16:17Z\",\"updatedAt\":\"2019-01-29T07:16:17Z\",\"url\":\"/extensions/sourcegraph/dart\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxOTF9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/ocaml\",\"extensionIDWithoutRegistry\":\"sourcegraph/ocaml\",\"name\":\"ocaml\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:ocaml\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for OCaml using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/ocaml\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"ocaml\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for OCaml\\\\n\\\\nThis extension provides OCaml code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/ocaml` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/ocaml) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/ocaml`, and enable it.\\\\n1. Visit any OCaml code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using ocaml on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"OCaml code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9195-sourcegraph-ocaml.js?c6zthtzejr34--sourcegraph-ocaml\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for OCaml using the Sourcegraph search API\"},\"createdAt\":\"2019-01-29T07:16:36Z\",\"updatedAt\":\"2019-01-29T07:16:36Z\",\"url\":\"/extensions/sourcegraph/ocaml\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyMjd9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/cuda\",\"extensionIDWithoutRegistry\":\"sourcegraph/cuda\",\"name\":\"cuda\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:cuda\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for CUDA using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/cuda\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"cuda\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for CUDA\\\\n\\\\nThis extension provides CUDA code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/cuda` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/cuda) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/cuda`, and enable it.\\\\n1. Visit any CUDA code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using cuda on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"CUDA code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9202-sourcegraph-cuda.js?c6zthumezheo--sourcegraph-cuda\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for CUDA using the Sourcegraph search API\"},\"createdAt\":\"2019-10-08T00:14:02Z\",\"updatedAt\":\"2019-10-08T00:14:02Z\",\"url\":\"/extensions/sourcegraph/cuda\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyMzN9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/pascal\",\"extensionIDWithoutRegistry\":\"sourcegraph/pascal\",\"name\":\"pascal\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:pascal\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for Pascal using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/pascal\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"pascal\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Pascal\\\\n\\\\nThis extension provides Pascal code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/pascal` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/pascal) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/pascal`, and enable it.\\\\n1. Visit any Pascal code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using pascal on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"Pascal code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9205-sourcegraph-pascal.js?c6zthuzb6qcg--sourcegraph-pascal\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for Pascal using the Sourcegraph search API\"},\"createdAt\":\"2020-01-28T23:07:36Z\",\"updatedAt\":\"2020-01-28T23:07:36Z\",\"url\":\"/extensions/sourcegraph/pascal\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyMzR9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/verilog\",\"extensionIDWithoutRegistry\":\"sourcegraph/verilog\",\"name\":\"verilog\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:verilog\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for Verilog using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/verilog\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"verilog\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Verilog\\\\n\\\\nThis extension provides Verilog code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/verilog` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/verilog) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/verilog`, and enable it.\\\\n1. Visit any Verilog code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using verilog on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"Verilog code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9181-sourcegraph-verilog.js?c6zths18rwb4--sourcegraph-verilog\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for Verilog using the Sourcegraph search API\"},\"createdAt\":\"2020-01-28T23:07:45Z\",\"updatedAt\":\"2020-01-28T23:07:45Z\",\"url\":\"/extensions/sourcegraph/verilog\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyMzV9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/vhdl\",\"extensionIDWithoutRegistry\":\"sourcegraph/vhdl\",\"name\":\"vhdl\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:vhdl\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for VHDL using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/vhdl\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"vhdl\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for VHDL\\\\n\\\\nThis extension provides VHDL code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/vhdl` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/vhdl) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/vhdl`, and enable it.\\\\n1. Visit any VHDL code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using vhdl on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"VHDL code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9210-sourcegraph-vhdl.js?c6zthwsbfupk--sourcegraph-vhdl\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for VHDL using the Sourcegraph search API\"},\"createdAt\":\"2020-01-28T23:07:56Z\",\"updatedAt\":\"2020-01-28T23:07:56Z\",\"url\":\"/extensions/sourcegraph/vhdl\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyMzZ9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/graphql\",\"extensionIDWithoutRegistry\":\"sourcegraph/graphql\",\"name\":\"graphql\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:graphql\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for GraphQL using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/graphql\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"graphql\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for GraphQL\\\\n\\\\nThis extension provides GraphQL code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/graphql` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/graphql) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/graphql`, and enable it.\\\\n1. Visit any GraphQL code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using graphql on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"GraphQL code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9208-sourcegraph-graphql.js?c6zthvug6jrc--sourcegraph-graphql\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for GraphQL using the Sourcegraph search API\"},\"createdAt\":\"2020-01-29T21:46:35Z\",\"updatedAt\":\"2020-01-29T21:46:35Z\",\"url\":\"/extensions/sourcegraph/graphql\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyMzd9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/groovy\",\"extensionIDWithoutRegistry\":\"sourcegraph/groovy\",\"name\":\"groovy\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:groovy\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for Groovy using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/groovy\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"groovy\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Groovy\\\\n\\\\nThis extension provides Groovy code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/groovy` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/groovy) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/groovy`, and enable it.\\\\n1. Visit any Groovy code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using groovy on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"Groovy code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9207-sourcegraph-groovy.js?c6zthvtvjvnc--sourcegraph-groovy\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for Groovy using the Sourcegraph search API\"},\"createdAt\":\"2020-01-30T21:20:44Z\",\"updatedAt\":\"2020-01-30T21:20:44Z\",\"url\":\"/extensions/sourcegraph/groovy\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyNDJ9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/protobuf\",\"extensionIDWithoutRegistry\":\"sourcegraph/protobuf\",\"name\":\"protobuf\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:protobuf\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for Protocol Buffers using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/protobuf\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"protobuf\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Protocol Buffers\\\\n\\\\nThis extension provides Protocol Buffers code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/protobuf` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/protobuf) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/protobuf`, and enable it.\\\\n1. Visit any Protocol Buffers code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using protobuf on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"Protocol Buffers code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9187-sourcegraph-protobuf.js?c6zthssfeaag--sourcegraph-protobuf\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for Protocol Buffers using the Sourcegraph search API\"},\"createdAt\":\"2020-02-19T16:39:37Z\",\"updatedAt\":\"2020-02-19T16:39:37Z\",\"url\":\"/extensions/sourcegraph/protobuf\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyNDh9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/jsonnet\",\"extensionIDWithoutRegistry\":\"sourcegraph/jsonnet\",\"name\":\"jsonnet\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:jsonnet\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for Jsonnet using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/jsonnet\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"jsonnet\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Jsonnet\\\\n\\\\nThis extension provides Jsonnet code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/jsonnet` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/jsonnet) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/jsonnet`, and enable it.\\\\n1. Visit any Jsonnet code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using jsonnet on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"Jsonnet code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9194-sourcegraph-jsonnet.js?c6zthtr69yq0--sourcegraph-jsonnet\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for Jsonnet using the Sourcegraph search API\"},\"createdAt\":\"2020-03-10T01:25:16Z\",\"updatedAt\":\"2020-03-10T01:25:16Z\",\"url\":\"/extensions/sourcegraph/jsonnet\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyNTB9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/thrift\",\"extensionIDWithoutRegistry\":\"sourcegraph/thrift\",\"name\":\"thrift\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:thrift\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for Thrift using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/thrift\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"thrift\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Thrift\\\\n\\\\nThis extension provides Thrift code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/thrift` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/thrift) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/thrift`, and enable it.\\\\n1. Visit any Thrift code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using thrift on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"Thrift code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9191-sourcegraph-thrift.js?c6zthtcmk9p4--sourcegraph-thrift\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for Thrift using the Sourcegraph search API\"},\"createdAt\":\"2020-03-11T15:49:59Z\",\"updatedAt\":\"2020-03-11T15:49:59Z\",\"url\":\"/extensions/sourcegraph/thrift\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyNjB9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/cobol\",\"extensionIDWithoutRegistry\":\"sourcegraph/cobol\",\"name\":\"cobol\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:cobol\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for Cobol using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/cobol\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"cobol\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Cobol\\\\n\\\\nThis extension provides Cobol code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/cobol` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/cobol) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/cobol`, and enable it.\\\\n1. Visit any Cobol code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using cobol on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"Cobol code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9200-sourcegraph-cobol.js?c6zthuf1buig--sourcegraph-cobol\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for Cobol using the Sourcegraph search API\"},\"createdAt\":\"2020-05-11T15:46:41Z\",\"updatedAt\":\"2020-05-11T15:46:41Z\",\"url\":\"/extensions/sourcegraph/cobol\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyNjF9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/tcl\",\"extensionIDWithoutRegistry\":\"sourcegraph/tcl\",\"name\":\"tcl\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"onLanguage:tcl\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Programming languages\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"basicCodeIntel.includeArchives\\\": {\\n          \\\"description\\\": \\\"Whether to include archived repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.includeForks\\\": {\\n          \\\"description\\\": \\\"Whether to include forked repositories in search results.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.indexOnly\\\": {\\n          \\\"description\\\": \\\"Whether to use only indexed requests to the search API.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"basicCodeIntel.unindexedSearchTimeout\\\": {\\n          \\\"description\\\": \\\"The timeout (in milliseconds) for un-indexed search requests.\\\",\\n          \\\"type\\\": \\\"number\\\"\\n        },\\n        \\\"codeIntel.disableRangeQueries\\\": {\\n          \\\"description\\\": \\\"Whether to fetch multiple precise definitions and references on hover.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codeIntel.lsif\\\": {\\n          \\\"description\\\": \\\"Whether to use pre-computed LSIF data for code intelligence (such as hovers, definitions, and references). See https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Basic code intelligence settings\\\"\\n    }\\n  },\\n  \\\"description\\\": \\\"Provides basic code intelligence for Tcl using the Sourcegraph search API\\\",\\n  \\\"engines\\\": {\\n    \\\"node\\\": \\\"\\\\u003e=11.1.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/tcl\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"tcl\\\",\\n  \\\"private\\\": true,\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code intelligence for Tcl\\\\n\\\\nThis extension provides Tcl code intelligence on Sourcegraph.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/code-intel-extensions/tree/master/extensions/template)\\\\n\\\\n![Python code intelligence](https://user-images.githubusercontent.com/1976/50882679-68768580-139a-11e9-8e58-a756c5bf4fb0.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/tcl` extension:\\\\n   - On Sourcegraph.com, visit the [extension page](https://sourcegraph.com/extensions/sourcegraph/tcl) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/tcl`, and enable it.\\\\n1. Visit any Tcl code file on Sourcegraph.\\\\n1. Hover over a token in the code file.\\\\n   - See a description of the token.\\\\n   - Click **Go to definition** (if available) to go to the token's definition.\\\\n   - Click **Find references** to see all references to the token.\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features to code files and diffs on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Follow the [usage steps](#usage) above to enable this extension.\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu. Then click the gear icon and enable _Experimental features: Use extensions_.\\\\n1. Visit any file on your code host and hover over a token to see a description of the token, a **Go to definition** action (if available), and a **Find references** action.\\\\n\\\\n![screenshot of using tcl on GitHub](https://user-images.githubusercontent.com/1976/50882271-0c5f3180-1399-11e9-9697-e4e4fa4e29e9.png)\\\\n\\\\n## Basic code intelligence\\\\n\\\\nThis extension comes with built-in code intelligence provided by [search-based heuristics](https://docs.sourcegraph.com/code_intelligence/explanations/basic_code_intelligence). Because this extension uses text-based heuristics, its definition and reference results are not precise:\\\\n\\\\n- \\\\\\\"Go to definition\\\\\\\" on a token goes to the definition found by [universal-ctags](https://github.com/universal-ctags/ctags), a cross-language parsing suite.\\\\n- \\\\\\\"Find references\\\\\\\" on a token finds all instances of token (with the same case) in the current repository and other repositories.\\\\n\\\\nThese heuristics work well for tokens with unique names, such as `render_to_view` or `TLSConfig`. They do not work well for ambiguous tokens, such as `open` or `file`.\\\\n\\\\n### Indexed and archived repositories\\\\n\\\\nTo include indexed and/or archived repositories in search results, add the following to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.includeForks\\\\\\\": true,\\\\n  \\\\\\\"basicCodeIntel.includeArchives\\\\\\\": true\\\\n```\\\\n\\\\n### Large repositories\\\\n\\\\nBasic code intelligence will perform a search query in the commit you are viewing. This may cause performance issues if the commit is not indexed and the repository is large. After a timeout period with no results, an index-only search will be performed. This type of query may return results for a commit other than the one you are currently viewing. The default timeout period is five seconds, but can be lowered by adding the following to your Sourcegraph global settings (units are milliseconds):\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.unindexedSearchTimeout\\\\\\\": 1000\\\\n```\\\\n\\\\nFor organizations that organize code in a monorepo, it may never be useful to perform an un-indexed search. To force only indexed search queries, add the following to your Sourcgraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"basicCodeIntel.indexOnly\\\\\\\": true\\\\n```\\\\n\\\\n## LSIF\\\\n\\\\nTo enable [LSIF support](https://docs.sourcegraph.com/code_intelligence/explanations/precise_code_intelligence), add these to your Sourcegraph global settings:\\\\n\\\\n```json\\\\n  \\\\\\\"codeIntel.lsif\\\\\\\": true\\\\n```\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"extensions/template\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"github:sourcegraph/code-intel-extensions\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../node_modules/.bin/tsc -b . \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"config-types\\\": \\\"../../node_modules/.bin/dot-json package.json contributes.configuration | ../../node_modules/.bin/json2ts --unreachableDefinitions --style.singleQuote --no-style.semi -o ../../shared/search/settings.ts\\\",\\n    \\\"publish\\\": \\\"yarn -s \\\\u0026\\\\u0026 src -config \\\\\\\"${SRC_CONFIG}\\\\\\\" ext publish\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 ../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"../../node_modules/.bin/mkdirp dist \\\\u0026\\\\u0026 ../../node_modules/.bin/lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"sideEffects\\\": false,\\n  \\\"tags\\\": [\\n    \\\"fuzzy\\\"\\n  ],\\n  \\\"title\\\": \\\"Tcl code intelligence\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9211-sourcegraph-tcl.js?c6zthx68qlkw--sourcegraph-tcl\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides basic code intelligence for Tcl using the Sourcegraph search API\"},\"createdAt\":\"2020-05-11T15:46:45Z\",\"updatedAt\":\"2020-05-11T15:46:45Z\",\"url\":\"/extensions/sourcegraph/tcl\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo0fQ==\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/codecov\",\"extensionIDWithoutRegistry\":\"sourcegraph/codecov\",\"name\":\"codecov\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"bugs\\\": {\\n    \\\"url\\\": \\\"https://github.com/codecov/sourcegraph-codecov/issues\\\"\\n  },\\n  \\\"categories\\\": [\\n    \\\"External services\\\",\\n    \\\"Reports and stats\\\",\\n    \\\"Insights\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [\\n      {\\n        \\\"actionItem\\\": {\\n          \\\"description\\\": \\\"${config.codecov.decorations.lineCoverage \\\\u0026\\\\u0026 \\\\\\\"Hide\\\\\\\" || \\\\\\\"Show\\\\\\\"} code coverage\\\\nCmd/Ctrl+Click: View on Codecov\\\",\\n          \\\"iconURL\\\": \\\"https://raw.githubusercontent.com/codecov/media/master/logos/codecov%20logo%20mark%20pink.svg?sanitize=true\\\",\\n          \\\"label\\\": \\\"Coverage: ${get(context, `codecov.coverageRatio.${resource.uri}`)}%\\\",\\n          \\\"pressed\\\": \\\"config.codecov.decorations.lineCoverage\\\"\\n        },\\n        \\\"category\\\": \\\"Codecov\\\",\\n        \\\"command\\\": \\\"updateConfiguration\\\",\\n        \\\"commandArguments\\\": [\\n          [\\n            \\\"codecov.decorations.lineCoverage\\\"\\n          ],\\n          \\\"${!config.codecov.decorations.lineCoverage}\\\",\\n          null,\\n          \\\"json\\\"\\n        ],\\n        \\\"id\\\": \\\"codecov.decorations.toggleCoverage\\\",\\n        \\\"title\\\": \\\"${config.codecov.decorations.lineCoverage \\\\u0026\\\\u0026 \\\\\\\"Hide\\\\\\\" || \\\\\\\"Show\\\\\\\"} line coverage on file${get(context, `codecov.coverageRatio.${resource.uri}`) \\\\u0026\\\\u0026 ` (${get(context, `codecov.coverageRatio.${resource.uri}`)}% coverage)` || \\\\\\\"\\\\\\\"}\\\"\\n      },\\n      {\\n        \\\"category\\\": \\\"Codecov\\\",\\n        \\\"command\\\": \\\"updateConfiguration\\\",\\n        \\\"commandArguments\\\": [\\n          [\\n            \\\"codecov.decorations.lineHitCounts\\\"\\n          ],\\n          \\\"${!config.codecov.decorations.lineHitCounts}\\\",\\n          null,\\n          \\\"json\\\"\\n        ],\\n        \\\"id\\\": \\\"codecov.decorations.toggleHits\\\",\\n        \\\"title\\\": \\\"${config.codecov.decorations.lineHitCounts \\\\u0026\\\\u0026 \\\\\\\"Hide\\\\\\\" || \\\\\\\"Show\\\\\\\"} line hit/branch counts\\\"\\n      },\\n      {\\n        \\\"category\\\": \\\"Codecov\\\",\\n        \\\"command\\\": \\\"updateConfiguration\\\",\\n        \\\"commandArguments\\\": [\\n          [\\n            \\\"codecov.hideCoverageButton\\\"\\n          ],\\n          \\\"${!config.codecov.hideCoverageButton}\\\",\\n          null,\\n          \\\"json\\\"\\n        ],\\n        \\\"id\\\": \\\"codecov.button.toggle\\\",\\n        \\\"title\\\": \\\"${config.codecov.hideCoverageButton \\\\u0026\\\\u0026 \\\\\\\"Show\\\\\\\" || \\\\\\\"Hide\\\\\\\"} coverage % button\\\"\\n      },\\n      {\\n        \\\"category\\\": \\\"Codecov\\\",\\n        \\\"command\\\": \\\"open\\\",\\n        \\\"commandArguments\\\": [\\n          \\\"${get(context, `codecov.fileURL.${resource.uri}`)}\\\"\\n        ],\\n        \\\"id\\\": \\\"codecov.link.file\\\",\\n        \\\"title\\\": \\\"View file coverage report\\\"\\n      },\\n      {\\n        \\\"category\\\": \\\"Codecov\\\",\\n        \\\"command\\\": \\\"open\\\",\\n        \\\"commandArguments\\\": [\\n          \\\"${codecov.commitURL}\\\"\\n        ],\\n        \\\"id\\\": \\\"codecov.link.commit\\\",\\n        \\\"title\\\": \\\"View commit report${codecov.commitCoverage \\\\u0026\\\\u0026 ` (${codecov.commitCoverage}% coverage)` || \\\\\\\"\\\\\\\"}\\\"\\n      },\\n      {\\n        \\\"category\\\": \\\"Codecov\\\",\\n        \\\"command\\\": \\\"open\\\",\\n        \\\"commandArguments\\\": [\\n          \\\"${codecov.repoURL}\\\"\\n        ],\\n        \\\"id\\\": \\\"codecov.link.repository\\\",\\n        \\\"title\\\": \\\"View repository coverage dashboard\\\"\\n      },\\n      {\\n        \\\"category\\\": \\\"Codecov\\\",\\n        \\\"command\\\": \\\"codecov.setAPIToken\\\",\\n        \\\"id\\\": \\\"codecov.setAPIToken\\\",\\n        \\\"title\\\": \\\"Set API token for private repositories\\\"\\n      },\\n      {\\n        \\\"category\\\": \\\"Codecov\\\",\\n        \\\"command\\\": \\\"codecov.setupEnterprise\\\",\\n        \\\"id\\\": \\\"codecov.setupEnterprise\\\",\\n        \\\"title\\\": \\\"Set up Codecov Enterprise\\\"\\n      },\\n      {\\n        \\\"category\\\": \\\"Codecov\\\",\\n        \\\"command\\\": \\\"open\\\",\\n        \\\"commandArguments\\\": [\\n          \\\"https://docs.codecov.io\\\"\\n        ],\\n        \\\"iconURL\\\": \\\"data:image/svg+xml,\\\\u003c?xml version=\\\\\\\"1.0\\\\\\\" encoding=\\\\\\\"UTF-8\\\\\\\"?\\\\u003e\\\\u003csvg width=\\\\\\\"2278\\\\\\\" height=\\\\\\\"2500\\\\\\\" viewBox=\\\\\\\"0 0 256 281\\\\\\\" xmlns=\\\\\\\"http://www.w3.org/2000/svg\\\\\\\" preserveAspectRatio=\\\\\\\"xMidYMid\\\\\\\"\\\\u003e\\\\u003cpath d=\\\\\\\"M218.551 37.419C194.416 13.289 162.33 0 128.097 0 57.537.047.091 57.527.04 128.121L0 149.813l16.859-11.49c11.468-7.814 24.75-11.944 38.417-11.944 4.079 0 8.198.373 12.24 1.11 12.742 2.32 24.165 8.089 33.414 16.758 2.12-4.67 4.614-9.209 7.56-13.536a88.081 88.081 0 0 1 3.805-5.15c-11.652-9.84-25.649-16.463-40.926-19.245a90.35 90.35 0 0 0-16.12-1.459 88.377 88.377 0 0 0-32.29 6.07c8.36-51.222 52.85-89.37 105.23-89.408 28.392 0 55.078 11.053 75.149 31.117 16.011 16.01 26.254 36.033 29.788 58.117-10.329-4.035-21.212-6.1-32.403-6.144l-1.568-.007a90.957 90.957 0 0 0-3.401.111c-1.955.1-3.898.277-5.821.5-.574.063-1.139.153-1.707.231-1.378.186-2.75.395-4.109.639-.603.11-1.203.231-1.8.351a90.517 90.517 0 0 0-4.114.937c-.492.126-.983.243-1.47.374a90.183 90.183 0 0 0-5.09 1.538c-.1.035-.204.063-.304.096a87.532 87.532 0 0 0-11.057 4.649c-.097.05-.193.101-.293.151a86.7 86.7 0 0 0-4.912 2.701l-.398.238a86.09 86.09 0 0 0-22.302 19.253c-.262.318-.524.635-.784.958-1.376 1.725-2.718 3.49-3.976 5.336a91.412 91.412 0 0 0-3.672 5.913 90.235 90.235 0 0 0-2.496 4.638c-.044.09-.089.175-.133.265a88.786 88.786 0 0 0-4.637 11.272l-.002.009v.004a88.006 88.006 0 0 0-4.509 29.313c.005.397.005.794.019 1.192.021.777.06 1.557.104 2.338a98.66 98.66 0 0 0 .289 3.834c.078.804.174 1.606.275 2.41.063.512.119 1.026.195 1.534a90.11 90.11 0 0 0 .658 4.01c4.339 22.938 17.261 42.937 36.39 56.316l2.446 1.564.02-.048a88.572 88.572 0 0 0 36.232 13.45l1.746.236 12.974-20.822-4.664-.127c-35.898-.985-65.1-31.003-65.1-66.917 0-35.348 27.624-64.702 62.876-66.829l2.23-.085c14.292-.362 28.372 3.859 40.325 11.997l16.781 11.421.036-21.58c.027-34.219-13.272-66.379-37.449-90.554\\\\\\\" fill=\\\\\\\"%23E0225C\\\\\\\"/\\\\u003e\\\\u003c/svg\\\\u003e\\\",\\n        \\\"id\\\": \\\"codecov.help\\\",\\n        \\\"title\\\": \\\"Documentation and support\\\"\\n      }\\n    ],\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"codecov.decorations.lineCoverage\\\": {\\n          \\\"default\\\": true,\\n          \\\"description\\\": \\\"Whether to decorate each line with a background color based on its coverage.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codecov.decorations.lineHitCounts\\\": {\\n          \\\"default\\\": false,\\n          \\\"description\\\": \\\"Whether to decorate the end of each covered line with the hit/branch stats.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codecov.endpoints\\\": {\\n          \\\"description\\\": \\\"An array of Codecov endpoints that are contacted to retrieve coverage data. Currently only 1 endpoint is supported.\\\\n\\\\nIf empty or not set, https://codecov.io is used.\\\",\\n          \\\"items\\\": {\\n            \\\"additionalProperties\\\": false,\\n            \\\"description\\\": \\\"A Codecov endpoint (either https://codecov.io or Codecov Enterprise).\\\",\\n            \\\"properties\\\": {\\n              \\\"token\\\": {\\n                \\\"description\\\": \\\"The Codecov API token for this endpoint (required for private repositories).\\\",\\n                \\\"type\\\": \\\"string\\\"\\n              },\\n              \\\"type\\\": {\\n                \\\"description\\\": \\\"Define hosted version control type (gh|ghe|bb|gl):\\\",\\n                \\\"enum\\\": [\\n                  \\\"gh\\\",\\n                  \\\"ghe\\\",\\n                  \\\"bb\\\",\\n                  \\\"gl\\\"\\n                ],\\n                \\\"type\\\": \\\"string\\\"\\n              },\\n              \\\"url\\\": {\\n                \\\"default\\\": \\\"https://codecov.io\\\",\\n                \\\"description\\\": \\\"The URL for this Codecov endpoint.\\\",\\n                \\\"examples\\\": [\\n                  \\\"https://codecov.io\\\",\\n                  \\\"https://codecov.example.com\\\"\\n                ],\\n                \\\"format\\\": \\\"uri\\\",\\n                \\\"type\\\": \\\"string\\\"\\n              }\\n            },\\n            \\\"type\\\": \\\"object\\\"\\n          },\\n          \\\"maxLength\\\": 1,\\n          \\\"type\\\": \\\"array\\\"\\n        },\\n        \\\"codecov.hideCoverageButton\\\": {\\n          \\\"default\\\": false,\\n          \\\"description\\\": \\\"Whether to hide the file coverage ratio item in the toolbar (in a button labeled \\\\\\\"Coverage: N%\\\\\\\").\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codecov.insight.icicle\\\": {\\n          \\\"description\\\": \\\"Show an interactive coverage icicle graph on repository pages.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codecov.insight.pie\\\": {\\n          \\\"description\\\": \\\"Show a coverage pie chart on repository and directory pages.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codecov.insight.sunburst\\\": {\\n          \\\"description\\\": \\\"Show a coverage sunburst graph on repository pages.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        },\\n        \\\"codecov.insight.tree\\\": {\\n          \\\"description\\\": \\\"Show a coverage tree map on repository pages.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Codecov settings\\\"\\n    },\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [\\n        {\\n          \\\"action\\\": \\\"codecov.decorations.toggleCoverage\\\",\\n          \\\"when\\\": \\\"resource\\\"\\n        },\\n        {\\n          \\\"action\\\": \\\"codecov.decorations.toggleHits\\\",\\n          \\\"when\\\": \\\"resource\\\"\\n        },\\n        {\\n          \\\"action\\\": \\\"codecov.button.toggle\\\",\\n          \\\"when\\\": \\\"resource \\\\u0026\\\\u0026 get(context, `codecov.coverageRatio.${resource.uri}`)\\\"\\n        },\\n        {\\n          \\\"action\\\": \\\"codecov.link.file\\\",\\n          \\\"when\\\": \\\"resource \\\\u0026\\\\u0026 get(context, `codecov.fileURL.${resource.uri}`)\\\"\\n        },\\n        {\\n          \\\"action\\\": \\\"codecov.link.commit\\\",\\n          \\\"when\\\": \\\"codecov.commitURL\\\"\\n        },\\n        {\\n          \\\"action\\\": \\\"codecov.link.repository\\\",\\n          \\\"when\\\": \\\"codecov.repoURL\\\"\\n        },\\n        {\\n          \\\"action\\\": \\\"codecov.setAPIToken\\\"\\n        },\\n        {\\n          \\\"action\\\": \\\"codecov.setupEnterprise\\\"\\n        },\\n        {\\n          \\\"action\\\": \\\"codecov.help\\\"\\n        }\\n      ],\\n      \\\"editor/title\\\": [\\n        {\\n          \\\"action\\\": \\\"codecov.decorations.toggleCoverage\\\",\\n          \\\"alt\\\": \\\"codecov.link.file\\\",\\n          \\\"when\\\": \\\"resource \\\\u0026\\\\u0026 !config.codecov.hideCoverageButton \\\\u0026\\\\u0026 get(context, `codecov.coverageRatio.${resource.uri}`)\\\"\\n        }\\n      ],\\n      \\\"help\\\": [\\n        {\\n          \\\"action\\\": \\\"codecov.help\\\"\\n        }\\n      ]\\n    },\\n    \\\"views\\\": [\\n      {\\n        \\\"id\\\": \\\"codecov.coverageGraph\\\",\\n        \\\"where\\\": \\\"directory\\\"\\n      }\\n    ]\\n  },\\n  \\\"description\\\": \\\"Shows code coverage from Codecov\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/eslint-config\\\": \\\"^0.16.2\\\",\\n    \\\"@sourcegraph/extension-api-stubs\\\": \\\"^1.1.0\\\",\\n    \\\"@types/mocha\\\": \\\"^5.2.7\\\",\\n    \\\"@types/mock-require\\\": \\\"^2.0.0\\\",\\n    \\\"@types/node\\\": \\\"^10.17.21\\\",\\n    \\\"eslint\\\": \\\"^6.8.0\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^0.5.5\\\",\\n    \\\"mocha\\\": \\\"^5.2.0\\\",\\n    \\\"mock-require\\\": \\\"^3.0.3\\\",\\n    \\\"nyc\\\": \\\"^12.0.2\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.12.4\\\",\\n    \\\"prettier\\\": \\\"^2.0.5\\\",\\n    \\\"rxjs\\\": \\\"^6.5.5\\\",\\n    \\\"source-map-support\\\": \\\"^0.5.19\\\",\\n    \\\"sourcegraph\\\": \\\"^24.4.0\\\",\\n    \\\"ts-node\\\": \\\"^8.9.1\\\",\\n    \\\"typescript\\\": \\\"^3.8.3\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/codecov\\\",\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"codecov\\\",\\n  \\\"nyc\\\": {\\n    \\\"exclude\\\": [\\n      \\\"**/*.test.ts?(x)\\\",\\n      \\\"**/*.d.ts\\\",\\n      \\\"**/*.js\\\"\\n    ],\\n    \\\"extension\\\": [\\n      \\\".tsx\\\",\\n      \\\".ts\\\"\\n    ],\\n    \\\"include\\\": [\\n      \\\"src/**/*.ts?(x)\\\"\\n    ]\\n  },\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Codecov Sourcegraph extension\\\\n\\\\n[![Build Status](https://travis-ci.org/codecov/sourcegraph-codecov.svg?branch=master)](https://travis-ci.org/codecov/sourcegraph-codecov)\\\\n[![codecov](https://codecov.io/gh/codecov/sourcegraph-codecov/branch/master/graph/badge.svg)](https://codecov.io/gh/codecov/sourcegraph-codecov)\\\\n\\\\nA [Sourcegraph extension](https://docs.sourcegraph.com/extensions) for showing code coverage information from [Codecov](https://codecov.io) on GitHub, Sourcegraph, and other tools.\\\\n\\\\n[**🎥 Demo video**](https://www.youtube.com/watch?v=j1eWBa3rWH8)\\\\n\\\\n[**🗃️ Source code**](https://github.com/codecov/sourcegraph-codecov)\\\\n\\\\n[**➕ Add to Sourcegraph**](https://sourcegraph.com/extensions/sourcegraph/codecov)\\\\n\\\\n## Features\\\\n\\\\n-   Support for GitHub.com and Sourcegraph.com\\\\n-   Line coverage overlays on files (with green/yellow/red background colors)\\\\n-   Line branches/hits annotations on files\\\\n-   File coverage ratio indicator (`Coverage: N%`) and toggle button\\\\n-   Support for using a Codecov API token to see coverage for private repositories\\\\n\\\\n## Usage\\\\n\\\\n### On GitHub using the Chrome extension\\\\n\\\\n1.  Install [Sourcegraph for Chrome](https://chrome.google.com/webstore/detail/sourcegraph/dgjhfomjieaadpoljlnidmbgkdffpack) or [Sourcegraph for Firefox](https://docs.sourcegraph.com/integration/browser_extension)\\\\n1.  [Enable the Codecov extension on Sourcegraph](https://sourcegraph.com/extensions/sourcegraph/codecov)\\\\n1.  Visit [tuf_store.go in theupdateframework/notary on GitHub](https://github.com/theupdateframework/notary/blob/fb795b0bc868746ed2efa2cd7109346bc7ddf0a4/server/storage/tuf_store.go) (or any other file in a public repository that has Codecov code coverage)\\\\n1.  Click the `Coverage: N%` button to toggle Codecov test coverage background colors on the file (scroll down if they aren't immediately visible)\\\\n\\\\n![Screenshot](https://user-images.githubusercontent.com/1976/45107396-53d56880-b0ee-11e8-96e9-ca83e991101c.png)\\\\n\\\\n#### With private GitHub.com repositories\\\\n\\\\nYou can use the Codecov extension for private repositories on GitHub.com. Your code is never sent to Sourcegraph.\\\\n\\\\n1.  Follow the [Codecov extension usage instructions](https://github.com/codecov/sourcegraph-codecov#usage) above to install Sourcegraph for Chrome/Firefox\\\\n2.  Go to the command palette on GitHub (added by the Sourcegraph browser extension, see screenshot below) and choose \\\\\\\"Codecov: Set API token for private repositories\\\\\\\"\\\\n3.  Enter your Codecov API token\\\\n4.  Visit any file in a GitHub.com private repository that has Codecov coverage data\\\\n\\\\n![image](https://user-images.githubusercontent.com/1976/45338265-04a19480-b541-11e8-9b35-517f3bbff530.png)\\\\n\\\\nYour code is never sent to Sourcegraph. The Codecov extension runs on the client side in a Web Worker and communicates with Codecov directly to retrieve code coverage data.\\\\n\\\\n#### With Codecov Enterprise and GitHub Enterprise\\\\n\\\\nYou can use this extension to overlay coverage information from your Codecov Enterprise install into GitHub Enterprise.\\\\n\\\\n1.  Follow the [Codecov extension usage instructions](https://github.com/codecov/sourcegraph-codecov#usage) above to install Sourcegraph for Chrome/Firefox\\\\n2.  From the command palette (added by the Sourcegraph browser extension, see screenshot above) on GitHub Enterprise click, \\\\\\\"Codecov: Setup up Codecov Enterprise\\\\\\\"\\\\n3.  From the pop up that appears, set your Version control type to: `ghe`\\\\n4.  From the next pop up that appears, set your Codecov endpoint, this is just the root level of your Codecov Enterprise domain, e.g., `https://codecov.mycompany.com`.\\\\n5.  Go to the command palette on GitHub and choose \\\\\\\"Codecov: Set API token for private repositories\\\\\\\"\\\\n6.  Enter your Codecov Enterprise API token.\\\\n7.  Visit any file in your Github Enterprise install with coverage data uploaded to Codecov Enterprise to see coverage data.\\\\n\\\\nNote: Additional documentation, if needed, can be found in [Codecov's official documentation](https://docs.codecov.io/docs/browser-extension#section-additional-steps-for-on-premises-codecov-customers).\\\\n\\\\n### On Sourcegraph.com\\\\n\\\\n1.  Visit [tuf_store.go in theupdateframework/notary](https://sourcegraph.com/github.com/theupdateframework/notary@fb795b0bc868746ed2efa2cd7109346bc7ddf0a4/-/blob/server/storage/tuf_store.go) on Sourcegraph.com (or any other file that has Codecov code coverage)\\\\n2.  Click the `Coverage: N%` button to toggle Codecov test coverage background colors on the file (sign-in required)\\\\n\\\\n\\\\u003e The Codecov extension is enabled by default on Sourcegraph.com, so you don't need to add it from its [extension registry listing](https://sourcegraph.com/extensions/sourcegraph/codecov).\\\\n\\\\n#### With a self-hosted Sourcegraph instance and the browser extension\\\\n\\\\nIf you're using a self-hosted Sourcegraph instance (not required), you need to explicitly enable Sourcegraph extensions.\\\\n\\\\n1.  Open the Sourcegraph for Chrome/Firefox extension options page (by clicking the Sourcegraph icon in the browser toolbar)\\\\n1.  Check the box labeled **Use Sourcegraph extensions**\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/codecov/sourcegraph-codecov.git\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"cover\\\": \\\"TS_NODE_COMPILER_OPTIONS='{\\\\\\\"module\\\\\\\":\\\\\\\"commonjs\\\\\\\"}' nyc --require ts-node/register --require source-map-support/register --all mocha --opts mocha.opts --timeout 10000\\\",\\n    \\\"eslint\\\": \\\"eslint './src/**/*.ts'\\\",\\n    \\\"eslint:fix\\\": \\\"npm run eslint -- --fix\\\",\\n    \\\"prettier\\\": \\\"prettier 'src/**/*.{js?(on),ts}' --write --list-different\\\",\\n    \\\"prettier:check\\\": \\\"npm run prettier -- --write=false\\\",\\n    \\\"serve\\\": \\\"npm run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --no-source-maps --out-file extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run build\\\",\\n    \\\"symlink-package\\\": \\\"mkdirp dist \\\\u0026\\\\u0026 lnfs ./package.json ./dist/package.json\\\",\\n    \\\"test\\\": \\\"TS_NODE_COMPILER_OPTIONS='{\\\\\\\"module\\\\\\\":\\\\\\\"commonjs\\\\\\\"}' mocha --require ts-node/register --require source-map-support/register --opts mocha.opts\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:test\\\": \\\"npm run test -- -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"tags\\\": [\\n    \\\"codecov\\\",\\n    \\\"coverage\\\",\\n    \\\"code coverage\\\",\\n    \\\"testing\\\"\\n  ],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/6904-sourcegraph-codecov.js?c3m1b1oidm2g--sourcegraph-codecov\\\",\\n  \\\"version\\\": \\\"0.0.0-development\\\"\\n}\",\"description\":\"Shows code coverage from Codecov\"},\"createdAt\":\"2018-06-30T08:24:21Z\",\"updatedAt\":\"2018-08-21T08:56:52Z\",\"url\":\"/extensions/sourcegraph/codecov\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjozMX0=\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjoyMTIw\",\"username\":\"chris\",\"displayName\":\"Chris Wendt\",\"url\":\"/users/chris\"},\"extensionID\":\"chris/token-highlights\",\"extensionIDWithoutRegistry\":\"chris/token-highlights\",\"name\":\"token-highlights\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"description\\\": \\\"Highlights lines matching the variable under the mouse.\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"parcel-bundler\\\": \\\"^1.10.3\\\",\\n    \\\"sourcegraph\\\": \\\"^20.1.0\\\",\\n    \\\"typescript\\\": \\\"^3.2.1\\\"\\n  },\\n  \\\"extensionID\\\": \\\"chris/token-highlights\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"token-highlights\\\",\\n  \\\"publisher\\\": \\\"chris\\\",\\n  \\\"readme\\\": \\\"# Token Highlights Sourcegraph Extension\\\\n\\\\nA [Sourcegraph extension](https://docs.sourcegraph.com/extensions) for highlighting lines matching the currently hovered token on GitHub, Sourcegraph, and other tools.\\\\n\\\\n[**➕ Add to Sourcegraph**](https://sourcegraph.com/extensions/chris/token-highlights)\\\\n\\\\n**Note:** Using this extension on private code in the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension) requires a [self-hosted Sourcegraph instance](https://docs.sourcegraph.com/#quickstart) (because it needs access to the contents of the current file).\\\\n\\\\nSource code on GitHub: https://github.com/sourcegraph/sourcegraph-extension-samples/tree/master/token-highlights\\\\n\\\\n![demo](https://user-images.githubusercontent.com/1387653/45539771-86065a80-b7bf-11e8-8d44-d9878cbae054.gif)\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"token-highlights\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/sourcegraph/sourcegraph-extension-samples\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"sourcegraph:prepublish\\\": \\\"parcel build src/extension.ts\\\"\\n  },\\n  \\\"title\\\": \\\"Token highlights\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/2253-chris-token-highlights.js?bro8o7o26hc8--chris-token-highlights\\\"\\n}\",\"description\":\"Highlights lines matching the variable under the mouse.\"},\"createdAt\":\"2018-09-14T08:31:24Z\",\"updatedAt\":\"2018-09-14T08:31:24Z\",\"url\":\"/extensions/chris/token-highlights\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo0MH0=\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjoyMTIw\",\"username\":\"chris\",\"displayName\":\"Chris Wendt\",\"url\":\"/users/chris\"},\"extensionID\":\"chris/sourcegraph-npm-import-stats\",\"extensionIDWithoutRegistry\":\"chris/sourcegraph-npm-import-stats\",\"name\":\"sourcegraph-npm-import-stats\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"dependencies\\\": {\\n    \\\"rxjs\\\": \\\"^6.3.3\\\",\\n    \\\"xmlhttprequest\\\": \\\"^1.8.0\\\"\\n  },\\n  \\\"description\\\": \\\"Displays stats about npm packages next to import statements.\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^3.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^12.1.0\\\",\\n    \\\"@types/lru-cache\\\": \\\"^4.1.1\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.10.3\\\",\\n    \\\"sourcegraph\\\": \\\"^19.2.0\\\",\\n    \\\"typescript\\\": \\\"^3.2.1\\\"\\n  },\\n  \\\"extensionID\\\": \\\"chris/sourcegraph-npm-import-stats\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"sourcegraph-npm-import-stats\\\",\\n  \\\"publisher\\\": \\\"chris\\\",\\n  \\\"readme\\\": \\\"# npm import stats [Sourcegraph extension](https://docs.sourcegraph.com/extensions)\\\\n\\\\nThis example extension will display a link to the npm package next to import statements in JavaScript/TypeScript.\\\\n\\\\n![demo](https://user-images.githubusercontent.com/1387653/46236952-54040500-c336-11e8-885a-a68c3fff4ba4.gif)\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"url\\\": \\\"https://github.com/sourcegraph/sourcegraph-extension-samples.git\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"sourcegraph:prepublish\\\": \\\"parcel build --no-minify src/extension.ts\\\"\\n  },\\n  \\\"title\\\": \\\"npm import stats\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/1250-chris-sourcegraph-npm-import-stats.js?bq9jwt2pxbyo--chris-sourcegraph-npm-import-stats\\\"\\n}\",\"description\":\"Displays stats about npm packages next to import statements.\"},\"createdAt\":\"2018-09-28T18:47:44Z\",\"updatedAt\":\"2018-09-28T18:47:44Z\",\"url\":\"/extensions/chris/sourcegraph-npm-import-stats\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo0N30=\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjoyNjYy\",\"username\":\"prestonvanloon\",\"displayName\":null,\"url\":\"/users/prestonvanloon\"},\"extensionID\":\"prestonvanloon/sourcegraph-godocs\",\"extensionIDWithoutRegistry\":\"prestonvanloon/sourcegraph-godocs\",\"name\":\"sourcegraph-godocs\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"author\\\": \\\"Preston Van Loon\\\",\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [\\n      {\\n        \\\"actionItem\\\": {\\n          \\\"description\\\": \\\"View this package on godocs.org\\\",\\n          \\\"iconURL\\\": \\\"data:image/svg+xml;base64,\\\",\\n          \\\"label\\\": \\\"Godocs\\\"\\n        },\\n        \\\"category\\\": \\\"godocs\\\",\\n        \\\"command\\\": \\\"open\\\",\\n        \\\"commandArguments\\\": [\\n          \\\"https://godoc.org/${get(context, 'godoc.path')}\\\"\\n        ],\\n        \\\"id\\\": \\\"godocs.open\\\",\\n        \\\"title\\\": \\\"Godocs link\\\"\\n      }\\n    ],\\n    \\\"menus\\\": {\\n      \\\"editor/title\\\": [\\n        {\\n          \\\"action\\\": \\\"godocs.open\\\",\\n          \\\"when\\\": \\\"0 == 0\\\"\\n        }\\n      ]\\n    }\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"parcel-bundler\\\": \\\"^1.10.3\\\",\\n    \\\"sourcegraph\\\": \\\"^18.0.0\\\",\\n    \\\"typescript\\\": \\\"^3.1.3\\\"\\n  },\\n  \\\"description\\\": \\\"Sourcegraph extension for viewing Godocs.\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"gts\\\": \\\"^0.8.0\\\",\\n    \\\"typescript\\\": \\\"~2.8.0\\\"\\n  },\\n  \\\"extensionID\\\": \\\"prestonvanloon/sourcegraph-godocs\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"sourcegraph-godocs\\\",\\n  \\\"publisher\\\": \\\"prestonvanloon\\\",\\n  \\\"readme\\\": \\\"# Sourcegraph Godocs Extension\\\\n\\\\n**WORK IN PROGRESS**\\\\n\\\\nThis extension adds a convenience link to godocs.org for the current package.\\\\n\\\\n## Known Issues\\\\nFile issues at [github.com/prestonvanloon/sourcegraph-godocs/issues](https://github.com/prestonvanloon/sourcegraph-godocs/issues).\\\\n\\\\n- The godoc link does not update when navigating from file to some other directory. This seems to be lacking subscribable event in sourcegraph API.\\\\n\\\",\\n  \\\"scripts\\\": {\\n    \\\"check\\\": \\\"gts check\\\",\\n    \\\"clean\\\": \\\"gts clean\\\",\\n    \\\"compile\\\": \\\"tsc -p .\\\",\\n    \\\"fix\\\": \\\"gts fix\\\",\\n    \\\"posttest\\\": \\\"npm run check\\\",\\n    \\\"prepare\\\": \\\"npm run compile\\\",\\n    \\\"pretest\\\": \\\"npm run compile\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"parcel build src/extension.ts\\\"\\n  },\\n  \\\"title\\\": \\\"GoDocs\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/730-prestonvanloon-sourcegraph-godocs.js?bpi0d0boyfp4--prestonvanloon-sourcegraph-godocs\\\",\\n  \\\"version\\\": \\\"1.0.1\\\"\\n}\",\"description\":\"Sourcegraph extension for viewing Godocs.\"},\"createdAt\":\"2018-10-16T00:52:12Z\",\"updatedAt\":\"2018-11-01T11:30:30Z\",\"url\":\"/extensions/prestonvanloon/sourcegraph-godocs\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo1Nn0=\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjozNDEy\",\"username\":\"p-adams\",\"displayName\":null,\"url\":\"/users/p-adams\"},\"extensionID\":\"p-adams/broken-url-locater\",\"extensionIDWithoutRegistry\":\"p-adams/broken-url-locater\",\"name\":\"broken-url-locater\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"author\\\": \\\"Paul Adams\\\",\\n  \\\"bugs\\\": {\\n    \\\"url\\\": \\\"https://github.com/p-adams/broken-url-locater/issues\\\"\\n  },\\n  \\\"description\\\": \\\"A Sourcegraph extension that locates broken URLs in code\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"jest\\\": \\\"^23.6.0\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.9.7\\\",\\n    \\\"sourcegraph\\\": \\\"^16.0.0\\\",\\n    \\\"typescript\\\": \\\"^3.0.3\\\"\\n  },\\n  \\\"extensionID\\\": \\\"p-adams/broken-url-locater\\\",\\n  \\\"homepage\\\": \\\"https://github.com/p-adams/broken-url-locater#readme\\\",\\n  \\\"license\\\": \\\"ISC\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"broken-url-locater\\\",\\n  \\\"publisher\\\": \\\"p-adams\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/p-adams/broken-url-locater\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"sourcegraph:prepublish\\\": \\\"parcel build src/extension.ts\\\",\\n    \\\"test\\\": \\\"test\\\"\\n  },\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/320-p-adams-broken-url-locater.js?bp9q7hrc9688--p-adams-broken-url-locater\\\",\\n  \\\"version\\\": \\\"1.0.0\\\"\\n}\",\"description\":\"A Sourcegraph extension that locates broken URLs in code\"},\"createdAt\":\"2018-10-22T17:49:20Z\",\"updatedAt\":\"2018-10-22T17:49:20Z\",\"url\":\"/extensions/p-adams/broken-url-locater\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo1OX0=\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjozMzI3\",\"username\":\"lguychard\",\"displayName\":null,\"url\":\"/users/lguychard\"},\"extensionID\":\"lguychard/string-references\",\"extensionIDWithoutRegistry\":\"lguychard/string-references\",\"name\":\"string-references\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"author\\\": \\\"l.guychard@gmail.com\\\",\\n  \\\"commitlint\\\": {\\n    \\\"extends\\\": [\\n      \\\"@commitlint/config-conventional\\\"\\n    ]\\n  },\\n  \\\"dependencies\\\": {},\\n  \\\"description\\\": \\\"A Sourcegraph extension allowing to find references to a string literal\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@commitlint/cli\\\": \\\"^7.2.1\\\",\\n    \\\"@commitlint/config-conventional\\\": \\\"^7.1.2\\\",\\n    \\\"@sourcegraph/prettierrc\\\": \\\"^2.2.0\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^3.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^12.0.0\\\",\\n    \\\"@types/assert\\\": \\\"^1.4.0\\\",\\n    \\\"@types/mocha\\\": \\\"^5.2.5\\\",\\n    \\\"@types/sinon\\\": \\\"^5.0.5\\\",\\n    \\\"assert\\\": \\\"^1.4.1\\\",\\n    \\\"intercept-require\\\": \\\"^1.1.0\\\",\\n    \\\"mocha\\\": \\\"^5.2.0\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.10.3\\\",\\n    \\\"prettier\\\": \\\"^1.14.3\\\",\\n    \\\"semantic-release\\\": \\\"^15.10.5\\\",\\n    \\\"sinon\\\": \\\"^7.0.0\\\",\\n    \\\"sourcegraph\\\": \\\"^18.0.0\\\",\\n    \\\"ts-node\\\": \\\"^7.0.1\\\",\\n    \\\"tslint\\\": \\\"^5.11.0\\\",\\n    \\\"typescript\\\": \\\"^3.1.3\\\"\\n  },\\n  \\\"extensionID\\\": \\\"lguychard/string-references\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"sourcegraph-string-references\\\",\\n  \\\"publisher\\\": \\\"lguychard\\\",\\n  \\\"readme\\\": \\\"# Sourcegraph String References Extension\\\\n\\\\n[![travis][travis-image]][travis-url] [![npm][npm-image]][npm-url]\\\\n\\\\n[travis-image]: https://img.shields.io/travis/lguychard/sourcegraph-string-references/master.svg\\\\n[travis-url]: https://travis-ci.org/lguychard/sourcegraph-string-references\\\\n[npm-image]: https://img.shields.io/npm/v/sourcegraph-string-references.svg\\\\n[npm-url]: https://npmjs.org/package/sourcegraph-string-references\\\\n\\\\nA [Sourcegraph](https://sourcegraph.com) extension allowing to find references to a string literal using the Sourcegraph code search.\\\\n\\\\n![example](demo.gif)\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/lguychard/sourcegraph-string-references\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"prettier\\\": \\\"prettier '**/*.{js?(on),ts}' --write --list-different\\\",\\n    \\\"publish\\\": \\\"src extensions publish -extension-id lguychard/string-references\\\",\\n    \\\"semantic-release\\\": \\\"semantic-release\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"parcel build --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"test\\\": \\\"mocha --require ts-node/register --inline-diffs --reporter spec --recursive ./src/**/*.test.ts\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json -c tslint.json src/**/*.ts\\\"\\n  },\\n  \\\"title\\\": \\\"String Reference Finder\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/380-lguychard-string-references.js?bpbnqkp74gkw--lguychard-string-references\\\",\\n  \\\"version\\\": \\\"1.0.30\\\"\\n}\",\"description\":\"A Sourcegraph extension allowing to find references to a string literal\"},\"createdAt\":\"2018-10-23T19:57:35Z\",\"updatedAt\":\"2018-10-23T19:57:35Z\",\"url\":\"/extensions/lguychard/string-references\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo2NX0=\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjozNDY4\",\"username\":\"danielevan\",\"displayName\":\"Daniel E Fineman\",\"url\":\"/users/danielevan\"},\"extensionID\":\"danielevan/sourcegraph-hey-everyone\",\"extensionIDWithoutRegistry\":\"danielevan/sourcegraph-hey-everyone\",\"name\":\"sourcegraph-hey-everyone\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"description\\\": \\\"Shows a friendly 'Hey, everyone! 🎉🎉🎉' message when you hover over code.\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"parcel-bundler\\\": \\\"^1.9.7\\\",\\n    \\\"sourcegraph\\\": \\\"^16.0.0\\\",\\n    \\\"typescript\\\": \\\"^3.0.3\\\"\\n  },\\n  \\\"extensionID\\\": \\\"danielevan/sourcegraph-hey-everyone\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"sourcegraph-hey-everyone\\\",\\n  \\\"publisher\\\": \\\"danielevan\\\",\\n  \\\"readme\\\": \\\"# Hey Everyone\\\\n\\\\nShows a friendly 'Hey, everyone! 🎉🎉🎉' message when you hover over code, powered by the [Sourcegraph extension API](https://github.com/sourcegraph/sourcegraph-extension-api).\\\\n\\\\nWorks on GitHub when you install the browser extension for [Chrome](https://chrome.google.com/webstore/detail/sourcegraph/dgjhfomjieaadpoljlnidmbgkdffpack) or [Firefox](https://addons.mozilla.org/en-US/firefox/addon/sourcegraph/).\\\",\\n  \\\"scripts\\\": {\\n    \\\"sourcegraph:prepublish\\\": \\\"parcel build src/extension.ts\\\"\\n  },\\n  \\\"title\\\": \\\"Hey, Everyone!\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/377-danielevan-sourcegraph-hey-everyone.js?bpbgh0wphqk0--danielevan-sourcegraph-hey-everyone\\\"\\n}\",\"description\":\"Shows a friendly 'Hey, everyone! 🎉🎉🎉' message when you hover over code.\"},\"createdAt\":\"2018-10-24T18:23:20Z\",\"updatedAt\":\"2018-10-24T18:23:20Z\",\"url\":\"/extensions/danielevan/sourcegraph-hey-everyone\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo3MH0=\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjozNDY4\",\"username\":\"danielevan\",\"displayName\":\"Daniel E Fineman\",\"url\":\"/users/danielevan\"},\"extensionID\":\"danielevan/sourcegraph-lionize\",\"extensionIDWithoutRegistry\":\"danielevan/sourcegraph-lionize\",\"name\":\"sourcegraph-lionize\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"dependencies\\\": {\\n    \\\"rxjs\\\": \\\"^6.3.3\\\",\\n    \\\"sourcegraph\\\": \\\"^18.4.1\\\"\\n  },\\n  \\\"description\\\": \\\"Sourcegraph extension to translate code comments from English to Spanish\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"parcel-bundler\\\": \\\"^1.9.7\\\",\\n    \\\"typescript\\\": \\\"^3.0.3\\\"\\n  },\\n  \\\"extensionID\\\": \\\"danielevan/sourcegraph-lionize\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"sourcegraph-lionize\\\",\\n  \\\"publisher\\\": \\\"danielevan\\\",\\n  \\\"readme\\\": \\\"# Lionize - comment translation\\\\n\\\\nThis extension translates code comments from English to Spanish, employing the \\\\n[Merriam-Webster Dictionary API](https://dictionaryapi.com/) for single words, and \\\\n[Google Cloud Translation API](https://cloud.google.com/translate/docs/quickstart-client-libraries#client-libraries-install-nodejs)\\\\nfor phrases. \\\\n\\\\nPowered by the [Sourcegraph extension API](https://github.com/sourcegraph/sourcegraph-extension-api).\\\\n\\\\nWorks on GitHub and sourcegraph.com when you install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension) for [Chrome](https://chrome.google.com/webstore/detail/sourcegraph/dgjhfomjieaadpoljlnidmbgkdffpack) or [Firefox](https://addons.mozilla.org/en-US/firefox/addon/sourcegraph/).\\\",\\n  \\\"scripts\\\": {\\n    \\\"sourcegraph:prepublish\\\": \\\"parcel build --no-minify src/extension.ts\\\"\\n  },\\n  \\\"title\\\": \\\"Translate code comments from English to Spanish\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/755-danielevan-sourcegraph-lionize.js?bpljxpo0cyr4--danielevan-sourcegraph-lionize\\\"\\n}\",\"description\":\"Sourcegraph extension to translate code comments from English to Spanish\"},\"createdAt\":\"2018-10-25T22:13:49Z\",\"updatedAt\":\"2018-10-25T22:13:49Z\",\"url\":\"/extensions/danielevan/sourcegraph-lionize\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo3Mn0=\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/go-imports-search\",\"extensionIDWithoutRegistry\":\"sourcegraph/go-imports-search\",\"name\":\"go-imports-search\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [],\\n    \\\"configuration\\\": {},\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [],\\n      \\\"editor/title\\\": []\\n    }\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"rxjs\\\": \\\"^6.3.3\\\"\\n  },\\n  \\\"description\\\": \\\"Lets you easily search for all files using a Go package. Adds a new operator `go.imports:` for all import statements of the package passed to the operator. This extension also adds a \\\\\\\"See all usages\\\\\\\" link at the end of import statement lines, which will execute the `go.imports` search for the relevant package.\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^3.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^12.0.0\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^0.5.1\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.10.3\\\",\\n    \\\"sourcegraph\\\": \\\"^18.1.0\\\",\\n    \\\"tslint\\\": \\\"^5.11.0\\\",\\n    \\\"typescript\\\": \\\"^3.1.3\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/go-imports-search\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/go-imports-search.js\\\",\\n  \\\"name\\\": \\\"go-imports-search\\\",\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Go imports search\\\\n\\\\nLets you easily search for all files using a Go package. Adds a new operator `go.imports:` for all import statements of the package passed to the operator.\\\\n\\\\nThis extension also adds a \\\\\\\"See all usages\\\\\\\" link at the end of import statement lines, which will execute the `go.imports` search for the relevant package. To enable \\\\\\\"See all usages\\\\\\\" links, add `\\\\\\\"goImports.showAllUsagesLinks\\\\\\\": true` in your user settings.\\\\n\\\\n## Prerequisites\\\\n\\\\nSourcegraph extensions are written in TypeScript and are distributed as bundled JavaScript files that run on the client. For creation, publishing, and viewing, you need:\\\\n\\\\n- **Creation**: Install [Node.js](https://nodejs.org).\\\\n- **Publishing**: Install the [Sourcegraph CLI (`src`)](https://github.com/sourcegraph/src-cli#installation) and create a [Sourcegraph.com account](https://sourcegraph.com/sign-up).\\\\n- **Viewing**: Install the Sourcegraph extension for [Chrome](https://chrome.google.com/webstore/detail/sourcegraph/dgjhfomjieaadpoljlnidmbgkdffpack) or [Firefox](https://addons.mozilla.org/en-US/firefox/addon/sourcegraph/).\\\\n\\\\n## Set up\\\\n\\\\n```\\\\nnpm install\\\\n```\\\\n\\\\n## Lint and type check\\\\n\\\\n```\\\\nnpm run tslint\\\\nnpm run typecheck\\\\n```\\\\n\\\\n## Publish\\\\n\\\\n```\\\\nsrc extensions publish\\\\n```\\\\n\\\\n## Sourecgraph extension API\\\\n\\\\nVisit the [Sourcegraph extension documentation](https://github.com/sourcegraph/sourcegraph-extension-docs) and check out some [Sourcegraph extension samples](https://github.com/sourcegraph/sourcegraph-extension-samples).\\\\n\\\",\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/go-imports-search.js src/go-imports-search.ts\\\",\\n    \\\"serve\\\": \\\"npm run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --out-file dist/go-imports-search.js src/go-imports-search.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run build\\\",\\n    \\\"symlink-package\\\": \\\"mkdirp dist \\\\u0026\\\\u0026 lnfs ./package.json ./dist/package.json\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"title\\\": \\\"Go imports search\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/3056-sourcegraph-go-imports-search.js?bxaym3u5wu7s--sourcegraph-go-imports-search\\\",\\n  \\\"version\\\": \\\"0.0.1-DEVELOPMENT\\\"\\n}\",\"description\":\"Lets you easily search for all files using a Go package. Adds a new operator `go.imports:` for all import statements of the package passed to the operator. This extension also adds a \\\"See all usages\\\" link at the end of import statement lines, which will execute the `go.imports` search for the relevant package.\"},\"createdAt\":\"2018-10-26T23:16:14Z\",\"updatedAt\":\"2018-10-26T23:16:14Z\",\"url\":\"/extensions/sourcegraph/go-imports-search\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo3M30=\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjozNTE5\",\"username\":\"mhewett99\",\"displayName\":null,\"url\":\"/users/mhewett99\"},\"extensionID\":\"mhewett99/coding-examples\",\"extensionIDWithoutRegistry\":\"mhewett99/coding-examples\",\"name\":\"coding-examples\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [],\\n    \\\"configuration\\\": {},\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [],\\n      \\\"editor/title\\\": []\\n    }\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"@sourcegraph/prettierrc\\\": \\\"^2.2.0\\\",\\n    \\\"rxjs\\\": \\\"^6.3.2\\\",\\n    \\\"vscode-ws-jsonrpc\\\": \\\"^0.0.1-alpha.5\\\"\\n  },\\n  \\\"description\\\": \\\"Provides canonical examples of class and function usage.\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^3.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^12.0.0\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.10.3\\\",\\n    \\\"sourcegraph\\\": \\\"^18.0.0\\\",\\n    \\\"tslint\\\": \\\"^5.11.0\\\",\\n    \\\"typescript\\\": \\\"^3.1.3\\\"\\n  },\\n  \\\"extensionID\\\": \\\"mhewett99/coding-examples\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/coding-examples.js\\\",\\n  \\\"name\\\": \\\"coding-examples\\\",\\n  \\\"publisher\\\": \\\"mhewett99\\\",\\n  \\\"readme\\\": \\\"# Coding Examples\\\\n\\\\nThis is a Sourcegraph extension that provides canonical examples of class and function usage in a Hover provider.\\\\n\\\\nIt currently only works for Go code, but can be extended to other languages.\\\\n\\\\nThis extension needs access to a Go examples provider.  One option is to run [mhewett/go-example-server](https://github.com/mhewett/go-example-server) on your local machine.\\\\n\\\\n## Prerequisites\\\\n\\\\nSourcegraph extensions are written in TypeScript and are distributed as bundled JavaScript files that run on the client. For creation, publishing, and viewing, you need:\\\\n\\\\n- **Creation**: Install [Node.js](https://nodejs.org).\\\\n- **Publishing**: Install the [Sourcegraph CLI (`src`)](https://github.com/sourcegraph/src-cli#installation) and create a [Sourcegraph.com account](https://sourcegraph.com/sign-up).\\\\n- **Viewing**: Install the Sourcegraph extension for [Chrome](https://chrome.google.com/webstore/detail/sourcegraph/dgjhfomjieaadpoljlnidmbgkdffpack) or [Firefox](https://addons.mozilla.org/en-US/firefox/addon/sourcegraph/).\\\\n\\\\n## Set up\\\\n\\\\n```\\\\nnpm install\\\\n```\\\\n\\\\n## Lint and type check\\\\n\\\\n```\\\\nnpm run tslint\\\\nnpm run typecheck\\\\n```\\\\n\\\\n## Publish\\\\n\\\\n```\\\\nsrc extensions publish\\\\n```\\\\n\\\\n## Sourcegraph extension API\\\\n\\\\nVisit the [Sourcegraph extension documentation](https://github.com/sourcegraph/sourcegraph-extension-docs) and check out some [Sourcegraph extension samples](https://github.com/sourcegraph/sourcegraph-extension-samples).\\\\n\\\",\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/coding-examples.js src/coding-examples.ts\\\",\\n    \\\"serve\\\": \\\"parcel serve --no-hmr --out-file dist/coding-examples.js src/coding-examples.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run build\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"title\\\": \\\"Coding Examples\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/521-mhewett99-coding-examples.js?bpew7z3txwko--mhewett99-coding-examples\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Provides canonical examples of class and function usage.\"},\"createdAt\":\"2018-10-28T01:04:00Z\",\"updatedAt\":\"2018-10-28T01:04:00Z\",\"url\":\"/extensions/mhewett99/coding-examples\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo3NX0=\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjo2\",\"username\":\"sqs\",\"displayName\":\"Quinn Slack\",\"url\":\"/users/sqs\"},\"extensionID\":\"sqs/word-count\",\"extensionIDWithoutRegistry\":\"sqs/word-count\",\"name\":\"word-count\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [\\n      {\\n        \\\"actionItem\\\": {\\n          \\\"description\\\": \\\"Count words in this file\\\",\\n          \\\"label\\\": \\\"Word count\\\"\\n        },\\n        \\\"category\\\": \\\"Word count\\\",\\n        \\\"command\\\": \\\"openPanel\\\",\\n        \\\"commandArguments\\\": [\\n          \\\"wordCount.panel\\\"\\n        ],\\n        \\\"id\\\": \\\"wordCount.openPanel\\\",\\n        \\\"title\\\": \\\"Show panel\\\"\\n      }\\n    ],\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"showInEditorTitle\\\": {\\n          \\\"default\\\": false,\\n          \\\"description\\\": \\\"Show a button to show the word count panel in the editor title.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Word count configuration\\\"\\n    },\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [\\n        {\\n          \\\"action\\\": \\\"wordCount.openPanel\\\",\\n          \\\"when\\\": \\\"resource\\\"\\n        }\\n      ],\\n      \\\"directory/page\\\": [\\n        {\\n          \\\"action\\\": \\\"wordCount.openPanel\\\",\\n          \\\"when\\\": \\\"resource\\\"\\n        }\\n      ],\\n      \\\"editor/title\\\": [\\n        {\\n          \\\"action\\\": \\\"wordCount.openPanel\\\",\\n          \\\"when\\\": \\\"resource \\\\u0026\\\\u0026 config.wordCount.showInEditorTitle\\\"\\n        }\\n      ]\\n    },\\n    \\\"views\\\": {\\n      \\\"window/panel\\\": [\\n        {\\n          \\\"id\\\": \\\"wordCount.panel\\\"\\n        }\\n      ]\\n    }\\n  },\\n  \\\"description\\\": \\\"Counts the number of words in a file.\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^3.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^12.0.0\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.10.3\\\",\\n    \\\"sourcegraph\\\": \\\"^18.1.0\\\",\\n    \\\"tslint\\\": \\\"^5.11.0\\\",\\n    \\\"typescript\\\": \\\"^3.1.3\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sqs/word-count\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/word-count.js\\\",\\n  \\\"name\\\": \\\"word-count\\\",\\n  \\\"publisher\\\": \\\"sqs\\\",\\n  \\\"readme\\\": \\\"# Word count (Sourcegraph extension)\\\\n\\\\nA sample [Sourcegraph extension](https://github.com/sourcegraph/sourcegraph-extension-api) for counting the number of words in a file.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sqs/sourcegraph-word-count)\\\\n\\\\n[**➕ Add to Sourcegraph**](https://sourcegraph.com/extensions/sqs/word-count)\\\\n\\\\n![screenshot](https://user-images.githubusercontent.com/1976/47622329-1fb06f80-dac1-11e8-8c4e-189ed9731895.png)\\\\n\\\",\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/word-count.js src/word-count.ts\\\",\\n    \\\"serve\\\": \\\"parcel serve --no-hmr --out-file dist/word-count.js src/word-count.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run build\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"title\\\": \\\"Word count\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/593-sqs-word-count.js?bpf75c0smaeg--sqs-word-count\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Counts the number of words in a file.\"},\"createdAt\":\"2018-10-28T22:33:08Z\",\"updatedAt\":\"2018-10-28T22:33:08Z\",\"url\":\"/extensions/sqs/word-count\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo4MH0=\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjozMzI3\",\"username\":\"lguychard\",\"displayName\":null,\"url\":\"/users/lguychard\"},\"extensionID\":\"lguychard/configurable-references\",\"extensionIDWithoutRegistry\":\"lguychard/configurable-references\",\"name\":\"configurable-references\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"author\\\": \\\"l.guychard@gmail.com\\\",\\n  \\\"commitlint\\\": {\\n    \\\"extends\\\": [\\n      \\\"@commitlint/config-conventional\\\"\\n    ]\\n  },\\n  \\\"dependencies\\\": {},\\n  \\\"description\\\": \\\"Lets you configure reference finding using regular expressions\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@commitlint/cli\\\": \\\"^7.2.1\\\",\\n    \\\"@commitlint/config-conventional\\\": \\\"^7.1.2\\\",\\n    \\\"@sourcegraph/prettierrc\\\": \\\"^2.2.0\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^3.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^12.0.0\\\",\\n    \\\"@types/assert\\\": \\\"^1.4.0\\\",\\n    \\\"@types/mocha\\\": \\\"^5.2.5\\\",\\n    \\\"@types/sinon\\\": \\\"^5.0.5\\\",\\n    \\\"assert\\\": \\\"^1.4.1\\\",\\n    \\\"intercept-require\\\": \\\"^1.1.0\\\",\\n    \\\"mocha\\\": \\\"^5.2.0\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.10.3\\\",\\n    \\\"prettier\\\": \\\"^1.14.3\\\",\\n    \\\"semantic-release\\\": \\\"^15.10.5\\\",\\n    \\\"sinon\\\": \\\"^7.0.0\\\",\\n    \\\"sourcegraph\\\": \\\"^18.0.0\\\",\\n    \\\"ts-node\\\": \\\"^7.0.1\\\",\\n    \\\"tslint\\\": \\\"^5.11.0\\\",\\n    \\\"typescript\\\": \\\"^3.1.3\\\"\\n  },\\n  \\\"extensionID\\\": \\\"lguychard/configurable-references\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"sourcegraph-configurable-references\\\",\\n  \\\"publisher\\\": \\\"lguychard\\\",\\n  \\\"readme\\\": \\\"# Sourcegraph Configurable References\\\\n\\\\n[![travis][travis-image]][travis-url] [![npm][npm-image]][npm-url]\\\\n\\\\n[travis-image]: https://img.shields.io/travis/lguychard/sourcegraph-configurable-references/master.svg\\\\n[travis-url]: https://travis-ci.org/lguychard/sourcegraph-configurable-references\\\\n[npm-image]: https://img.shields.io/npm/v/sourcegraph-configurable-references.svg\\\\n[npm-url]: https://npmjs.org/package/sourcegraph-configurable-references\\\\n\\\\nA Sourcegraph extension allowing you to add and configure reference finding for custom entities (for instance HTTP routes, build tasks, string literals...) using regular expressions.\\\\n\\\\n## Configuration\\\\n\\\\nCustom references can be added through the `\\\\\\\"customReferences\\\\\\\"` property of the Sourcegraph client settings. Here is an example configuration to add reference finding for HTTP routes in go:\\\\n\\\\n```\\\\n\\\\\\\"customReferences\\\\\\\": [\\\\n    {\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"HTTP Route\\\\\\\",\\\\n      \\\\\\\"preview\\\\\\\": \\\\\\\": `\\\\\\\\\\\\\\\"/$1\\\\\\\\\\\\\\\"`\\\\\\\",\\\\n      \\\\\\\"definitions\\\\\\\": [{\\\\n          \\\\\\\"search\\\\\\\": \\\\\\\"/httpPost\\\\\\\\\\\\\\\\(ctx, req.Repo, \\\\\\\\\\\\\\\"$1/\\\\\\\",\\\\n          \\\\\\\"capture\\\\\\\": \\\\\\\"httpPost\\\\\\\\\\\\\\\\(ctx, req\\\\\\\\\\\\\\\\.Repo, \\\\\\\\\\\\\\\"/?([^\\\\\\\\\\\\\\\"]+)\\\\\\\\\\\\\\\"\\\\\\\"\\\\n        }],\\\\n      \\\\\\\"references\\\\\\\": [{\\\\n          \\\\\\\"search\\\\\\\": \\\\\\\"mux.HandleFunc\\\\\\\\\\\\\\\\(\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\/$1\\\\\\\",\\\\n          \\\\\\\"capture\\\\\\\": \\\\\\\"mux.HandleFunc\\\\\\\\\\\\\\\\(\\\\\\\\\\\\\\\"/([^\\\\\\\\\\\\\\\"]+)\\\\\\\"\\\\n      }],\\\\n      \\\\\\\"implementations\\\\\\\": [],\\\\n    }\\\\n  ]\\\\n```\\\\n\\\\nWith this configuration, hovering HTTP route definitions will trigger a tooltip a tooltip allowing to find references:\\\\n\\\\n![example](./example.png)\\\\n\\\\n## Defaults\\\\n\\\\nIf your Sourcegraph configuration does not have a `\\\\\\\"customReferences\\\\\\\"` field, the extension will create it, and include by default the configuration for string literal references\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/lguychard/sourcegraph-configurable-references\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"prettier\\\": \\\"prettier '**/*.{js?(on),ts}' --write --list-different\\\",\\n    \\\"publish\\\": \\\"src extensions publish -extension-id lguychard/configurable-references\\\",\\n    \\\"semantic-release\\\": \\\"semantic-release\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"parcel build --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"test\\\": \\\"mocha --require ts-node/register --inline-diffs --reporter spec --recursive ./src/**/*.test.ts\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json -c tslint.json src/**/*.ts\\\"\\n  },\\n  \\\"title\\\": \\\"Configurable References\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/616-lguychard-configurable-references.js?bpfoz57uvuqg--lguychard-configurable-references\\\",\\n  \\\"version\\\": \\\"1.0.1\\\"\\n}\",\"description\":\"Lets you configure reference finding using regular expressions\"},\"createdAt\":\"2018-10-29T18:09:23Z\",\"updatedAt\":\"2018-10-29T18:09:23Z\",\"url\":\"/extensions/lguychard/configurable-references\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo4MX0=\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/js-dependency-search\",\"extensionIDWithoutRegistry\":\"sourcegraph/js-dependency-search\",\"name\":\"js-dependency-search\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [],\\n    \\\"configuration\\\": {},\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [],\\n      \\\"editor/title\\\": []\\n    }\\n  },\\n  \\\"description\\\": \\\"Lets you easily search for all files using a JS package. Adds a new operator `js.depends:` for all import statements of the package passed to the operator. This extension also adds a \\\\\\\\\\\\\\\"See all usages\\\\\\\\\\\\\\\" link at the end of import statement lines, which will execute the `js.depends` search for the relevant package.\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^3.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^12.0.0\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.10.3\\\",\\n    \\\"sourcegraph\\\": \\\"^18.4.0\\\",\\n    \\\"tslint\\\": \\\"^5.11.0\\\",\\n    \\\"typescript\\\": \\\"^3.1.3\\\"\\n  },\\n  \\\"extensionID\\\": \\\"farhan/js-dependency-search\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/js-dependency-search.js\\\",\\n  \\\"name\\\": \\\"js-dependency-search\\\",\\n  \\\"publisher\\\": \\\"farhan\\\",\\n  \\\"readme\\\": \\\"# JavaScript dependency search\\\\n\\\\nLets you easily search for all files using a JS package. Adds a new operator `js.depends:` for all import statements of the package passed to the operator. This extension also adds a \\\\\\\\\\\\\\\"See all usages\\\\\\\\\\\\\\\" link at the end of import statement lines, which will execute the `js.depends` search for the relevant package.\\\\n\\\\n## Prerequisites\\\\n\\\\nSourcegraph extensions are written in TypeScript and are distributed as bundled JavaScript files that run on the client. For creation, publishing, and viewing, you need:\\\\n\\\\n- **Creation**: Install [Node.js](https://nodejs.org).\\\\n- **Publishing**: Install the [Sourcegraph CLI (`src`)](https://github.com/sourcegraph/src-cli#installation) and create a [Sourcegraph.com account](https://sourcegraph.com/sign-up).\\\\n- **Viewing**: Install the Sourcegraph extension for [Chrome](https://chrome.google.com/webstore/detail/sourcegraph/dgjhfomjieaadpoljlnidmbgkdffpack) or [Firefox](https://addons.mozilla.org/en-US/firefox/addon/sourcegraph/).\\\\n\\\\n## Set up\\\\n\\\\n```\\\\nnpm install\\\\n```\\\\n\\\\n## Lint and type check\\\\n\\\\n```\\\\nnpm run tslint\\\\nnpm run typecheck\\\\n```\\\\n\\\\n## Publish\\\\n\\\\n```\\\\nsrc extensions publish\\\\n```\\\\n\\\\n## Sourecgraph extension API\\\\n\\\\nVisit the [Sourcegraph extension documentation](https://github.com/sourcegraph/sourcegraph-extension-docs) and check out some [Sourcegraph extension samples](https://github.com/sourcegraph/sourcegraph-extension-samples).\\\\n\\\",\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/js-dependency-search.js src/js-dependency-search.ts\\\",\\n    \\\"serve\\\": \\\"parcel serve --no-hmr --out-file dist/js-dependency-search.js src/js-dependency-search.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run build\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"title\\\": \\\"JavaScript dependency search\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/714-sourcegraph-js-dependency-search.js?bphe95nk2xi8--sourcegraph-js-dependency-search\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Lets you easily search for all files using a JS package. Adds a new operator `js.depends:` for all import statements of the package passed to the operator. This extension also adds a \\\\\\\"See all usages\\\\\\\" link at the end of import statement lines, which will execute the `js.depends` search for the relevant package.\"},\"createdAt\":\"2018-10-29T21:24:45Z\",\"updatedAt\":\"2018-10-29T21:24:45Z\",\"url\":\"/extensions/sourcegraph/js-dependency-search\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo4M30=\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/java-imports-search\",\"extensionIDWithoutRegistry\":\"sourcegraph/java-imports-search\",\"name\":\"java-imports-search\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [],\\n    \\\"configuration\\\": {},\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [],\\n      \\\"editor/title\\\": []\\n    }\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"@sourcegraph/prettierrc\\\": \\\"^3.0.1\\\",\\n    \\\"rxjs\\\": \\\"^6.5.3\\\"\\n  },\\n  \\\"description\\\": \\\"Lets you easily search for all files using a Java package. Adds a new operator `java.imports:` for all import statements of the package passed to the operator. This extension also adds a \\\\\\\"See all usages\\\\\\\" link at the end of import statement lines, which will execute the `java.imports` search for the relevant module.\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^4.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^13.4.0\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^0.5.1\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.10.3\\\",\\n    \\\"sourcegraph\\\": \\\"^23.0.1\\\",\\n    \\\"tslint\\\": \\\"^5.11.0\\\",\\n    \\\"typescript\\\": \\\"^3.7.3\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/java-imports-search\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/java-imports-search.js\\\",\\n  \\\"name\\\": \\\"java-imports-search\\\",\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Java imports search\\\\n\\\\nLets you easily search for all files using a Java package. Adds a new operator `java.imports:` for all import statements of the package passed to the operator.\\\\n\\\\nNOTE: regular expression search mode is required for the `java.imports` keyword to work. The extension automatically appends `patternType:regexp` to queries containing `java.imports`.\\\\n\\\\nThis extension also adds a \\\\\\\"See all usages\\\\\\\" link at the end of import statement lines, which will execute the `java.imports` search for the relevant module. To enable \\\\\\\"See all usages\\\\\\\" links, add `\\\\\\\"javaImports.showAllUsagesLinks\\\\\\\": true` to your user settings.\\\\n\\\\n## Prerequisites\\\\n\\\\nSourcegraph extensions are written in TypeScript and are distributed as bundled JavaScript files that run on the client. For creation, publishing, and viewing, you need:\\\\n\\\\n- **Creation**: Install [Node.js](https://nodejs.org).\\\\n- **Publishing**: Install the [Sourcegraph CLI (`src`)](https://github.com/sourcegraph/src-cli#installation) and create a [Sourcegraph.com account](https://sourcegraph.com/sign-up).\\\\n- **Viewing**: Install the Sourcegraph extension for [Chrome](https://chrome.google.com/webstore/detail/sourcegraph/dgjhfomjieaadpoljlnidmbgkdffpack) or [Firefox](https://addons.mozilla.org/en-US/firefox/addon/sourcegraph/).\\\\n\\\\n## Set up\\\\n\\\\n```\\\\nnpm install\\\\n```\\\\n\\\\n## Lint and type check\\\\n\\\\n```\\\\nnpm run tslint\\\\nnpm run typecheck\\\\n```\\\\n\\\\n## Publish\\\\n\\\\n```\\\\nsrc extensions publish\\\\n```\\\\n\\\\n## Sourecgraph extension API\\\\n\\\\nVisit the [Sourcegraph extension documentation](https://github.com/sourcegraph/sourcegraph-extension-docs) and check out some [Sourcegraph extension samples](https://github.com/sourcegraph/sourcegraph-extension-samples).\\\\n\\\",\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/java-imports-search.js src/java-imports-search.ts\\\",\\n    \\\"serve\\\": \\\"npm run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --out-file dist/java-imports-search.js src/java-imports-search.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run build\\\",\\n    \\\"symlink-package\\\": \\\"mkdirp dist \\\\u0026\\\\u0026 lnfs ./package.json ./dist/package.json\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"title\\\": \\\"Java imports search\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/3222-sourcegraph-java-imports-search.js?bz9mh1218itc--sourcegraph-java-imports-search\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Lets you easily search for all files using a Java package. Adds a new operator `java.imports:` for all import statements of the package passed to the operator. This extension also adds a \\\"See all usages\\\" link at the end of import statement lines, which will execute the `java.imports` search for the relevant module.\"},\"createdAt\":\"2018-10-30T00:32:18Z\",\"updatedAt\":\"2018-10-30T00:32:18Z\",\"url\":\"/extensions/sourcegraph/java-imports-search\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo4NH0=\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/php-imports-search\",\"extensionIDWithoutRegistry\":\"sourcegraph/php-imports-search\",\"name\":\"php-imports-search\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [],\\n    \\\"configuration\\\": {},\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [],\\n      \\\"editor/title\\\": []\\n    }\\n  },\\n  \\\"description\\\": \\\"Lets you easily search for all files using a PHP package. Adds a new operator `php.imports:` for all import statements of the package passed to the operator. This extension also adds a \\\\\\\"See all usages\\\\\\\" link at the end of import statement lines, which will execute the `php.imports` search for the relevant package.\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^3.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^12.0.0\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.10.3\\\",\\n    \\\"sourcegraph\\\": \\\"^18.4.0\\\",\\n    \\\"tslint\\\": \\\"^5.11.0\\\",\\n    \\\"typescript\\\": \\\"^3.1.4\\\"\\n  },\\n  \\\"extensionID\\\": \\\"farhan/php-imports-search\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/php-imports-search.js\\\",\\n  \\\"name\\\": \\\"php-imports-search\\\",\\n  \\\"publisher\\\": \\\"farhan\\\",\\n  \\\"readme\\\": \\\"# PHP imports search\\\\n\\\\nLets you easily search for all files using a PHP package. Adds a new operator `php.imports:` for all import statements of the package passed to the operator. This extension also adds a \\\\\\\"See all usages\\\\\\\" link at the end of import statement lines, which will execute the `php.imports` search for the relevant package.\\\\n\\\\n## Prerequisites\\\\n\\\\nSourcegraph extensions are written in TypeScript and are distributed as bundled JavaScript files that run on the client. For creation, publishing, and viewing, you need:\\\\n\\\\n- **Creation**: Install [Node.js](https://nodejs.org).\\\\n- **Publishing**: Install the [Sourcegraph CLI (`src`)](https://github.com/sourcegraph/src-cli#installation) and create a [Sourcegraph.com account](https://sourcegraph.com/sign-up).\\\\n- **Viewing**: Install the Sourcegraph extension for [Chrome](https://chrome.google.com/webstore/detail/sourcegraph/dgjhfomjieaadpoljlnidmbgkdffpack) or [Firefox](https://addons.mozilla.org/en-US/firefox/addon/sourcegraph/).\\\\n\\\\n## Set up\\\\n\\\\n```\\\\nnpm install\\\\n```\\\\n\\\\n## Lint and type check\\\\n\\\\n```\\\\nnpm run tslint\\\\nnpm run typecheck\\\\n```\\\\n\\\\n## Publish\\\\n\\\\n```\\\\nsrc extensions publish\\\\n```\\\\n\\\\n## Sourecgraph extension API\\\\n\\\\nVisit the [Sourcegraph extension documentation](https://github.com/sourcegraph/sourcegraph-extension-docs) and check out some [Sourcegraph extension samples](https://github.com/sourcegraph/sourcegraph-extension-samples).\\\\n\\\",\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/php-imports-search.js src/php-imports-search.ts\\\",\\n    \\\"serve\\\": \\\"parcel serve --no-hmr --out-file dist/php-imports-search.js src/php-imports-search.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run build\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"title\\\": \\\"PHP imports search\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/710-sourcegraph-php-imports-search.js?bphe757k27a0--sourcegraph-php-imports-search\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Lets you easily search for all files using a PHP package. Adds a new operator `php.imports:` for all import statements of the package passed to the operator. This extension also adds a \\\"See all usages\\\" link at the end of import statement lines, which will execute the `php.imports` search for the relevant package.\"},\"createdAt\":\"2018-10-30T01:59:40Z\",\"updatedAt\":\"2018-10-30T01:59:40Z\",\"url\":\"/extensions/sourcegraph/php-imports-search\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo4NX0=\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/github-extras\",\"extensionIDWithoutRegistry\":\"sourcegraph/github-extras\",\"name\":\"github-extras\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"commitlint\\\": {\\n    \\\"extends\\\": [\\n      \\\"@commitlint/config-conventional\\\"\\n    ]\\n  },\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [\\n      {\\n        \\\"actionItem\\\": {\\n          \\\"description\\\": \\\"Show GitHub pull requests\\\",\\n          \\\"label\\\": \\\"Pull requests\\\"\\n        },\\n        \\\"category\\\": \\\"GitHub\\\",\\n        \\\"command\\\": \\\"openPanel\\\",\\n        \\\"commandArguments\\\": [\\n          \\\"github.pullRequests\\\"\\n        ],\\n        \\\"id\\\": \\\"github.openPanel\\\",\\n        \\\"title\\\": \\\"Pull requests\\\"\\n      }\\n    ],\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"github.explore.repositories\\\": {\\n          \\\"default\\\": [\\n            \\\"sourcegraph/sourcegraph\\\"\\n          ],\\n          \\\"description\\\": \\\"A list of repositories (in `owner/name` format) to display in the Explore area.\\\",\\n          \\\"examples\\\": [\\n            [\\n              \\\"facebook/react\\\",\\n              \\\"twbs/bootstrap\\\",\\n              \\\"sourcegraph/sourcegraph\\\"\\n            ]\\n          ],\\n          \\\"items\\\": {\\n            \\\"pattern\\\": \\\"^[^/]+/[^/]+$\\\",\\n            \\\"type\\\": \\\"string\\\"\\n          },\\n          \\\"type\\\": \\\"array\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"GitHub extras\\\"\\n    },\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [\\n        {\\n          \\\"action\\\": \\\"github.openPanel\\\",\\n          \\\"when\\\": \\\"resource\\\"\\n        }\\n      ],\\n      \\\"directory/page\\\": [\\n        {\\n          \\\"action\\\": \\\"github.openPanel\\\"\\n        }\\n      ]\\n    },\\n    \\\"searchFilters\\\": [\\n      {\\n        \\\"name\\\": \\\"type:issue\\\",\\n        \\\"value\\\": \\\"type:issue\\\"\\n      }\\n    ]\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"date-fns\\\": \\\"^2.0.0-alpha.25\\\",\\n    \\\"rxjs\\\": \\\"^6.3.2\\\"\\n  },\\n  \\\"description\\\": \\\"WIP: Adds more GitHub integration features to Sourcegraph.\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@commitlint/cli\\\": \\\"^7.0.0\\\",\\n    \\\"@commitlint/config-conventional\\\": \\\"^7.0.1\\\",\\n    \\\"@sourcegraph/prettierrc\\\": \\\"^2.2.0\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^3.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^12.0.0\\\",\\n    \\\"@types/mocha\\\": \\\"^5.2.5\\\",\\n    \\\"@types/node\\\": \\\"^10.7.1\\\",\\n    \\\"husky\\\": \\\"^1.1.2\\\",\\n    \\\"mocha\\\": \\\"^5.2.0\\\",\\n    \\\"nyc\\\": \\\"^13.1.0\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.9.7\\\",\\n    \\\"prettier\\\": \\\"^1.14.2\\\",\\n    \\\"source-map-support\\\": \\\"^0.5.9\\\",\\n    \\\"sourcegraph\\\": \\\"^18.4.0\\\",\\n    \\\"ts-node\\\": \\\"^7.0.1\\\",\\n    \\\"tslint\\\": \\\"^5.11.0\\\",\\n    \\\"typescript\\\": \\\"^3.0.1\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/github-extras\\\",\\n  \\\"files\\\": [\\n    \\\"dist\\\"\\n  ],\\n  \\\"husky\\\": {\\n    \\\"hooks\\\": {\\n      \\\"commit-msg\\\": \\\"commitlint -e $HUSKY_GIT_PARAMS\\\"\\n    }\\n  },\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/sourcegraph-github-extras.js\\\",\\n  \\\"name\\\": \\\"github-extras\\\",\\n  \\\"nyc\\\": {\\n    \\\"exclude\\\": [\\n      \\\"**/*.test.ts?(x)\\\"\\n    ],\\n    \\\"extension\\\": [\\n      \\\".tsx\\\",\\n      \\\".ts\\\"\\n    ],\\n    \\\"include\\\": [\\n      \\\"src/**/*.ts?(x)\\\"\\n    ]\\n  },\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# sourcegraph-github-extras\\\\n\\\\n[![build](https://travis-ci.org/sourcegraph/sourcegraph-github-extras.svg?branch=master)](https://travis-ci.org/sourcegraph/sourcegraph-github-extras)\\\\n[![codecov](https://codecov.io/gh/sourcegraph/sourcegraph-github-extras/branch/master/graph/badge.svg?token=c3KpMf1MaY)](https://codecov.io/gh/sourcegraph/sourcegraph-github-extras)\\\\n[![code style: prettier](https://img.shields.io/badge/code_style-prettier-ff69b4.svg)](https://github.com/prettier/prettier)\\\\n\\\\nA [Sourcegraph extension](https://docs.sourcegraph.com/extensions) that adds more GitHub integration features to [Sourcegraph](https://sourcegraph.com).\\\\n\\\\n- **GitHub: Pull requests**: see a table of GitHub pull requests for the current repository\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/sourcegraph-github-extras)\\\\n\\\\n[**➕ Add to Sourcegraph**](https://sourcegraph.com/extensions/sourcegraph/github-extras)\\\\n\\\\n## Known issues\\\\n\\\\nThis extension is experimental.\\\\n\\\\n- The GitHub API request is sent each time the page loads. This is likely to cause you to hit the GitHub API rate limit (for unauthenticated users, it's 60 requests per minute).\\\\n- When you navigate to a different repository, the pull requests panel still shows the list from the first repository you viewed. Reload your browser to refresh the list.\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/sourcegraph/sourcegraph-github-extras.git\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --no-minify --out-file sourcegraph-github-extras.js src/extension.ts\\\",\\n    \\\"cover\\\": \\\"TS_NODE_COMPILER_OPTIONS='{\\\\\\\"module\\\\\\\":\\\\\\\"commonjs\\\\\\\"}' nyc --require ts-node/register --require source-map-support/register --all mocha --opts mocha.opts --timeout 10000\\\",\\n    \\\"prettier\\\": \\\"prettier '**/{*.{js?(on),ts?(x),scss},.*.js?(on)}' --write --list-different\\\",\\n    \\\"serve\\\": \\\"parcel serve --no-hmr --out-file sourcegraph-github-extras.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"test\\\": \\\"TS_NODE_COMPILER_OPTIONS='{\\\\\\\"module\\\\\\\":\\\\\\\"commonjs\\\\\\\"}' mocha --require ts-node/register --require source-map-support/register --opts mocha.opts\\\",\\n    \\\"tslint\\\": \\\"tslint -c tslint.json -p tsconfig.json './src/*.ts?(x)' './*.ts?(x)'\\\"\\n  },\\n  \\\"title\\\": \\\"GitHub extras\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/1380-sourcegraph-github-extras.js?bqd249v5qzcg--sourcegraph-github-extras\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"WIP: Adds more GitHub integration features to Sourcegraph.\"},\"createdAt\":\"2018-10-30T09:23:19Z\",\"updatedAt\":\"2018-10-30T09:23:19Z\",\"url\":\"/extensions/sourcegraph/github-extras\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo4N30=\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/org-search\",\"extensionIDWithoutRegistry\":\"sourcegraph/org-search\",\"name\":\"org-search\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [],\\n    \\\"configuration\\\": {},\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [],\\n      \\\"editor/title\\\": []\\n    }\\n  },\\n  \\\"description\\\": \\\"Adds an `org:` search operator that allows you to scope searches to a particular organization.\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^3.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^12.0.0\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.10.3\\\",\\n    \\\"sourcegraph\\\": \\\"^18.4.0\\\",\\n    \\\"tslint\\\": \\\"^5.11.0\\\",\\n    \\\"typescript\\\": \\\"^3.1.4\\\"\\n  },\\n  \\\"extensionID\\\": \\\"farhan/org-search\\\",\\n  \\\"icon\\\": \\\"https://images.ctfassets.net/le3mxztn6yoo/t4Qpcq5kA0AYM24Ws4mOk/4edf5502a936bbec90c262fa00355aed/sourcegraph-mark.png\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"org-search\\\",\\n  \\\"publisher\\\": \\\"farhan\\\",\\n  \\\"readme\\\": \\\"# Search extension\\\\n\\\\nReplaces `org:sourcegraph` with `r:sourcegraph/` in Sourcegraph search queries. Example of a Soucegraph extension using the search API.\\\\n\\\\n## Prerequisites\\\\n\\\\nSourcegraph extensions are written in TypeScript are distributed as bundled JavaScript files that run on the client. For creation, publishing, and viewing, you need:\\\\n\\\\n- **Creation**: Install [Node.js](https://nodejs.org) and [npm](https://npmjs.com)\\\\n- **Publishing**: Install the [Sourcegraph CLI (`src`)](https://github.com/sourcegraph/src-cli#installation) and create a [Sourcegraph.com account](https://sourcegraph.com/sign-up)\\\\n- **Viewing**: Install Sourcegraph extension for [Chrome](https://chrome.google.com/webstore/detail/sourcegraph/dgjhfomjieaadpoljlnidmbgkdffpack) or [Firefox](https://addons.mozilla.org/en-US/firefox/addon/sourcegraph/).\\\\n\\\\n## Setup\\\\n```\\\\nnpm install\\\\n```\\\\n\\\\n## Check check and lint\\\\n```\\\\nnpm run tslint\\\\nnpm run typecheck\\\\n```\\\\n\\\\n## Publish\\\\n```\\\\nsrc extensions publish\\\\n```\\\\n\\\",\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --experimental-scope-hoisting --out-file org-search.js src/org-search.ts\\\",\\n    \\\"serve\\\": \\\"parcel serve --no-hmr --no-source-maps --out-file org-search.js src/org-search.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run build\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"title\\\": \\\"Organization search filter\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/662-sourcegraph-org-search.js?bpgjubuh1cyo--sourcegraph-org-search\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Adds an `org:` search operator that allows you to scope searches to a particular organization.\"},\"createdAt\":\"2018-10-30T18:08:35Z\",\"updatedAt\":\"2018-10-30T18:08:35Z\",\"url\":\"/extensions/sourcegraph/org-search\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo5Mn0=\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/php-alias-search\",\"extensionIDWithoutRegistry\":\"sourcegraph/php-alias-search\",\"name\":\"php-alias-search\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [],\\n    \\\"configuration\\\": {},\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [],\\n      \\\"editor/title\\\": []\\n    }\\n  },\\n  \\\"description\\\": \\\"This extension lets you search for use statements of PHP aliases. It adds a new operator, `php.uses:`, which searches for all use statements of the alias passed to the operator. This extension also adds a \\\\\\\"See all usages\\\\\\\" link at the end of use statements, which will execute the `php.uses` search for the relevant alias.\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^3.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^12.0.0\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.10.3\\\",\\n    \\\"sourcegraph\\\": \\\"^18.4.0\\\",\\n    \\\"tslint\\\": \\\"^5.11.0\\\",\\n    \\\"typescript\\\": \\\"^3.1.4\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/php-alias-search\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/php-alias-search.js\\\",\\n  \\\"name\\\": \\\"php-alias-search\\\",\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# PHP alias search\\\\n\\\\nThis extension lets you search for use statements of PHP alises. It adds a new operator, `php.uses:`, which searches for all use statements of the alias passed to the operator. This extension also adds a \\\\\\\"See all usages\\\\\\\" link at the end of use statements, which will execute the `php.uses` search for the relevant alias.\\\\n\\\\n## Prerequisites\\\\n\\\\nSourcegraph extensions are written in TypeScript and are distributed as bundled JavaScript files that run on the client. For creation, publishing, and viewing, you need:\\\\n\\\\n- **Creation**: Install [Node.js](https://nodejs.org).\\\\n- **Publishing**: Install the [Sourcegraph CLI (`src`)](https://github.com/sourcegraph/src-cli#installation) and create a [Sourcegraph.com account](https://sourcegraph.com/sign-up).\\\\n- **Viewing**: Install the Sourcegraph extension for [Chrome](https://chrome.google.com/webstore/detail/sourcegraph/dgjhfomjieaadpoljlnidmbgkdffpack) or [Firefox](https://addons.mozilla.org/en-US/firefox/addon/sourcegraph/).\\\\n\\\\n## Set up\\\\n\\\\n```\\\\nnpm install\\\\n```\\\\n\\\\n## Lint and type check\\\\n\\\\n```\\\\nnpm run tslint\\\\nnpm run typecheck\\\\n```\\\\n\\\\n## Publish\\\\n\\\\n```\\\\nsrc extensions publish\\\\n```\\\\n\\\\n## Sourecgraph extension API\\\\n\\\\nVisit the [Sourcegraph extension documentation](https://github.com/sourcegraph/sourcegraph-extension-docs) and check out some [Sourcegraph extension samples](https://github.com/sourcegraph/sourcegraph-extension-samples).\\\\n\\\",\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/php-alias-search.js src/php-alias-search.ts\\\",\\n    \\\"serve\\\": \\\"parcel serve --no-hmr --out-file dist/php-alias-search.js src/php-alias-search.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run build\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"title\\\": \\\"PHP alias search\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/761-sourcegraph-php-alias-search.js?bpmgyekvswy8--sourcegraph-php-alias-search\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"This extension lets you search for use statements of PHP aliases. It adds a new operator, `php.uses:`, which searches for all use statements of the alias passed to the operator. This extension also adds a \\\"See all usages\\\" link at the end of use statements, which will execute the `php.uses` search for the relevant alias.\"},\"createdAt\":\"2018-11-06T17:13:07Z\",\"updatedAt\":\"2018-11-06T17:13:07Z\",\"url\":\"/extensions/sourcegraph/php-alias-search\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjo5NH0=\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjoz\",\"username\":\"farhan\",\"displayName\":\"Farhan\",\"url\":\"/users/farhan\"},\"extensionID\":\"farhan/github-issue-search\",\"extensionIDWithoutRegistry\":\"farhan/github-issue-search\",\"name\":\"github-issue-search\",\"manifest\":{\"raw\":\"{\\\"url\\\": \\\"http://localhost:1234/github-issue-search.js\\\", \\\"main\\\": \\\"dist/github-issue-search.js\\\", \\\"name\\\": \\\"github-issue-search\\\", \\\"title\\\": \\\"GitHub issue search\\\", \\\"readme\\\": \\\"# GitHub issue search\\\\n\\\\nAllows you to search GitHub issues from Sourcegraph.\\\\n\\\\n## Prerequisites\\\\n\\\\nSourcegraph extensions are written in TypeScript and are distributed as bundled JavaScript files that run on the client. For creation, publishing, and viewing, you need:\\\\n\\\\n- **Creation**: Install [Node.js](https://nodejs.org).\\\\n- **Publishing**: Install the [Sourcegraph CLI (`src`)](https://github.com/sourcegraph/src-cli#installation) and create a [Sourcegraph.com account](https://sourcegraph.com/sign-up).\\\\n- **Viewing**: Install the Sourcegraph extension for [Chrome](https://chrome.google.com/webstore/detail/sourcegraph/dgjhfomjieaadpoljlnidmbgkdffpack) or [Firefox](https://addons.mozilla.org/en-US/firefox/addon/sourcegraph/).\\\\n\\\\n## Set up\\\\n\\\\n```\\\\nnpm install\\\\n```\\\\n\\\\n## Lint and type check\\\\n\\\\n```\\\\nnpm run tslint\\\\nnpm run typecheck\\\\n```\\\\n\\\\n## Publish\\\\n\\\\n```\\\\nsrc extensions publish\\\\n```\\\\n\\\\n## Sourecgraph extension API\\\\n\\\\nVisit the [Sourcegraph extension documentation](https://github.com/sourcegraph/sourcegraph-extension-docs) and check out some [Sourcegraph extension samples](https://github.com/sourcegraph/sourcegraph-extension-samples).\\\\n\\\", \\\"license\\\": \\\"MIT\\\", \\\"scripts\\\": {\\\"build\\\": \\\"parcel build --out-file dist/github-issue-search.js src/github-issue-search.ts\\\", \\\"serve\\\": \\\"parcel serve --no-hmr --out-file dist/github-issue-search.js src/github-issue-search.ts\\\", \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\", \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\", \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\", \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\", \\\"sourcegraph:prepublish\\\": \\\"npm run build\\\"}, \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\", \\\"publisher\\\": \\\"farhan\\\", \\\"contributes\\\": {\\\"menus\\\": {\\\"editor/title\\\": [], \\\"commandPalette\\\": []}, \\\"actions\\\": [], \\\"configuration\\\": {}}, \\\"description\\\": \\\"Allows you to search GitHub issues from Sourcegraph.\\\", \\\"extensionID\\\": \\\"farhan/github-issue-search\\\", \\\"browserslist\\\": [\\\"last 1 Chrome versions\\\", \\\"last 1 Firefox versions\\\", \\\"last 1 Edge versions\\\", \\\"last 1 Safari versions\\\"], \\\"devDependencies\\\": {\\\"tslint\\\": \\\"^5.11.0\\\", \\\"typescript\\\": \\\"^3.1.6\\\", \\\"sourcegraph\\\": \\\"^18.4.1\\\", \\\"parcel-bundler\\\": \\\"^1.10.3\\\", \\\"@sourcegraph/tsconfig\\\": \\\"^3.0.0\\\", \\\"@sourcegraph/tslint-config\\\": \\\"^12.0.0\\\"}, \\\"activationEvents\\\": [\\\"*\\\"]}\",\"description\":\"Allows you to search GitHub issues from Sourcegraph.\"},\"createdAt\":\"2018-11-08T22:59:31Z\",\"updatedAt\":\"2018-11-08T22:59:31Z\",\"url\":\"/extensions/farhan/github-issue-search\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxMDZ9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjoxNDM0\",\"username\":\"isaac\",\"displayName\":\"Isaac Snow\",\"url\":\"/users/isaac\"},\"extensionID\":\"isaac/debug-extension\",\"extensionIDWithoutRegistry\":\"isaac/debug-extension\",\"name\":\"debug-extension\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [\\n      {\\n        \\\"actionItem\\\": {\\n          \\\"description\\\": \\\"Throw an error in the debug extension.\\\",\\n          \\\"label\\\": \\\"Throw error\\\"\\n        },\\n        \\\"command\\\": \\\"debugext.throwError\\\",\\n        \\\"id\\\": \\\"debugext.throwErrorAction\\\"\\n      }\\n    ],\\n    \\\"configuration\\\": {},\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [],\\n      \\\"editor/title\\\": [\\n        {\\n          \\\"action\\\": \\\"debugext.throwErrorAction\\\",\\n          \\\"when\\\": \\\"resource\\\"\\n        }\\n      ]\\n    }\\n  },\\n  \\\"description\\\": \\\"Helps debug Sourcegraph extensions\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/prettierrc\\\": \\\"^2.2.0\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^3.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^12.1.0\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^0.5.1\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.10.3\\\",\\n    \\\"sourcegraph\\\": \\\"^19.2.0\\\",\\n    \\\"tslint\\\": \\\"^5.11.0\\\",\\n    \\\"typescript\\\": \\\"^3.1.6\\\"\\n  },\\n  \\\"extensionID\\\": \\\"isaac/debug-extension\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/debug-extension.js\\\",\\n  \\\"name\\\": \\\"debug-extension\\\",\\n  \\\"publisher\\\": \\\"isaac\\\",\\n  \\\"readme\\\": \\\"# Debug extension\\\\n\\\\nHelps debug Sourcegraph extensions.\\\\n\\\\n## Why?\\\\n\\\\nUse this extension to determine whether a bug is coming from the extensions you\\\\nare using or Sourcegraph's code.\\\\n\\\\n## What?\\\\n\\\\nThis extension simply displays the version of Sourcegraph you are connected to\\\\nin the hover tooltip and after the line you are hovering. This allows us to test\\\\nnetwork request, adding hover tooltip information and adding decorations to the\\\\nDOM.\\\\n\\\",\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/debug-extension.js src/debug-extension.ts\\\",\\n    \\\"serve\\\": \\\"npm run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --out-file dist/debug-extension.js src/debug-extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run build\\\",\\n    \\\"symlink-package\\\": \\\"mkdirp dist \\\\u0026\\\\u0026 lnfs ./package.json ./dist/package.json\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"title\\\": \\\"Debug extension\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/2202-isaac-debug-extension.js?brn1gkm7my5c--isaac-debug-extension\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Helps debug Sourcegraph extensions\"},\"createdAt\":\"2018-11-21T18:49:23Z\",\"updatedAt\":\"2018-11-21T18:49:23Z\",\"url\":\"/extensions/isaac/debug-extension\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxMjV9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjo0MzU3\",\"username\":\"yevbar\",\"displayName\":\"Yev Barkalov\",\"url\":\"/users/yevbar\"},\"extensionID\":\"yevbar/line-counter\",\"extensionIDWithoutRegistry\":\"yevbar/line-counter\",\"name\":\"line-counter\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [\\n      {\\n        \\\"actionItem\\\": {\\n          \\\"description\\\": \\\"The line count for this file\\\",\\n          \\\"label\\\": \\\"Random label\\\"\\n        },\\n        \\\"command\\\": \\\"linecounter.displayLineCount\\\",\\n        \\\"id\\\": \\\"linecounter.displayLineCountAction\\\",\\n        \\\"title\\\": \\\"LaunchDarkly: Set client side ID for visibility checks\\\"\\n      }\\n    ],\\n    \\\"configuration\\\": {},\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [\\n        {\\n          \\\"action\\\": \\\"linecounter.displayLineCountAction\\\",\\n          \\\"when\\\": \\\"resource\\\"\\n        }\\n      ],\\n      \\\"editor/title\\\": [\\n        {\\n          \\\"action\\\": \\\"linecounter.displayLineCountAction\\\",\\n          \\\"when\\\": \\\"resource\\\"\\n        }\\n      ]\\n    }\\n  },\\n  \\\"description\\\": \\\"This extension follows the line counter example\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^3.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^12.1.0\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.10.3\\\",\\n    \\\"sourcegraph\\\": \\\"^19.2.0\\\",\\n    \\\"tslint\\\": \\\"^5.11.0\\\",\\n    \\\"typescript\\\": \\\"^3.2.1\\\"\\n  },\\n  \\\"extensionID\\\": \\\"yevbar/line-counter\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/line-counter.js\\\",\\n  \\\"name\\\": \\\"line-counter\\\",\\n  \\\"publisher\\\": \\\"yevbar\\\",\\n  \\\"readme\\\": \\\"# This is a line counter Sourcegraph extension\\\\n\\\\nThis extension follows the line counter example.\\\\n\\\",\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/line-counter.js src/line-counter.ts\\\",\\n    \\\"serve\\\": \\\"parcel serve --no-hmr --out-file dist/line-counter.js src/line-counter.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run build\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"title\\\": \\\"This is a line counter\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/1314-yevbar-line-counter.js?bqbgkkz579v4--yevbar-line-counter\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"This extension follows the line counter example\"},\"createdAt\":\"2018-12-05T06:21:17Z\",\"updatedAt\":\"2018-12-05T06:24:27Z\",\"url\":\"/extensions/yevbar/line-counter\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxMzJ9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/datadog-metrics\",\"extensionIDWithoutRegistry\":\"sourcegraph/datadog-metrics\",\"name\":\"datadog-metrics\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"External services\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [],\\n    \\\"configuration\\\": {},\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [],\\n      \\\"editor/title\\\": []\\n    }\\n  },\\n  \\\"description\\\": \\\"Jump to Datadog metrics from statsd calls in code\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/prettierrc\\\": \\\"^2.2.0\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^4.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^12.3.1\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.11.0\\\",\\n    \\\"rxjs\\\": \\\"^6.4.0\\\",\\n    \\\"sourcegraph\\\": \\\"^23.0.0\\\",\\n    \\\"tslint\\\": \\\"^5.13.1\\\",\\n    \\\"typescript\\\": \\\"^3.3.3\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/datadog-metrics\\\",\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"iconDark\\\": \\\"data:image/svg+xml;base64,\\\",\\n  \\\"license\\\": \\\"Apache-2.0\\\",\\n  \\\"main\\\": \\\"dist/datadog-metrics.js\\\",\\n  \\\"name\\\": \\\"datadog-metrics\\\",\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Datadog metrics Sourcegraph extension\\\\n\\\\nA [Sourcegraph extension](https://docs.sourcegraph.com/extensions) that allows jumps to the Datadog page for a metrics/instrumentation call in the code files.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/sourcegraph-datadog-metrics)\\\\n\\\\n[**➕ Add to Sourcegraph**](https://sourcegraph.com/extensions/sourcegraph/datadog-metrics) (see [usage instructions](#usage) for self-hosted Sourcegraph instances)\\\\n\\\\n## Features\\\\n\\\\nWorks on [Sourcegraph.com](https://sourcegraph.com), [self-hosted Sourcegraph instances](https://docs.sourcegraph.com/#quickstart), and on code hosts (via the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension)).\\\\n\\\\n- **Jump to graph on Datadog page** for standard metric/instrumentation calls\\\\n\\\\n![Datadog extension screenshot](https://d2ddoduugvun08.cloudfront.net/items/3p1H2N301P2W030c0l2m/Image%202019-06-06%20at%2011.49.51%20AM.png \\\\\\\"Datadog extension example\\\\\\\")\\\\n\\\\n![Datadog metric](https://d2ddoduugvun08.cloudfront.net/items/260v052e0i470D2S1I2K/Image%202019-06-06%20at%2011.51.06%20AM.png \\\\\\\"Datadog metric example\\\\\\\")\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph-datadog-metrics` extension:\\\\n   - On Sourcegraph.com, visit [https://sourcegraph.com/extensions/sourcegraph/datadog-metrics](https://sourcegraph.com/extensions/sourcegraph/datadog-metrics) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/datadog-metrics`, and enable it.\\\\n2. Visit any code file containing datadog statsd metric/instrumentation calls on Sourcegraph.\\\\n3. Click on the Datadog link that appears at the end of the line of each Datadog metric/instrumentation call to open the associated graph in the Datadog page.\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/sourcegraph/sourcegraph-datadog-metrics\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/datadog-metrics.js src/datadog-metrics.ts\\\",\\n    \\\"serve\\\": \\\"parcel serve --no-hmr --out-file dist/datadog-metrics.js src/datadog-metrics.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run build\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"tags\\\": [\\n    \\\"datadog\\\",\\n    \\\"metrics\\\",\\n    \\\"statsd\\\"\\n  ],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/8624-sourcegraph-datadog-metrics.js?c5zzknj57nds--sourcegraph-datadog-metrics\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Jump to Datadog metrics from statsd calls in code\"},\"createdAt\":\"2018-12-08T01:09:30Z\",\"updatedAt\":\"2020-09-14T00:40:01Z\",\"url\":\"/extensions/sourcegraph/datadog-metrics\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxNTl9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/skeleton-language-extension\",\"extensionIDWithoutRegistry\":\"sourcegraph/skeleton-language-extension\",\"name\":\"skeleton-language-extension\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [],\\n    \\\"configuration\\\": {},\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [],\\n      \\\"editor/title\\\": []\\n    }\\n  },\\n  \\\"description\\\": \\\"Minimal example of a language extension\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^3.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^12.3.1\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^0.5.1\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.11.0\\\",\\n    \\\"sourcegraph\\\": \\\"^20.1.0\\\",\\n    \\\"tslint\\\": \\\"^5.12.0\\\",\\n    \\\"typescript\\\": \\\"^3.2.2\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/skeleton-language-extension\\\",\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/skeleton-language-extension.js\\\",\\n  \\\"name\\\": \\\"skeleton-language-extension\\\",\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Skeleton language extension\\\\n\\\\nMinimal example of a language extension.\\\\n\\\\n![](https://user-images.githubusercontent.com/1387653/50319884-86795600-047e-11e9-8535-aaa8b3bc8e54.png)\\\\n\\\\n## Prerequisites\\\\n\\\\nSourcegraph extensions are written in TypeScript and are distributed as bundled JavaScript files that run on the client. For creation, publishing, and viewing, you need:\\\\n\\\\n- **Creation**: Install [Node.js](https://nodejs.org).\\\\n- **Publishing**: Install the [Sourcegraph CLI (`src`)](https://github.com/sourcegraph/src-cli#installation) and create a [Sourcegraph.com account](https://sourcegraph.com/sign-up).\\\\n- **Viewing**: Install the Sourcegraph extension for [Chrome](https://chrome.google.com/webstore/detail/sourcegraph/dgjhfomjieaadpoljlnidmbgkdffpack) or [Firefox](https://addons.mozilla.org/en-US/firefox/addon/sourcegraph/).\\\\n\\\\n## Set up\\\\n\\\\n```\\\\nnpm install\\\\n```\\\\n\\\\n## Lint and type check\\\\n\\\\n```\\\\nnpm run tslint\\\\nnpm run typecheck\\\\n```\\\\n\\\\n## Publish\\\\n\\\\n```\\\\nsrc extensions publish\\\\n```\\\\n\\\\n## Sourecgraph extension API\\\\n\\\\nVisit the [Sourcegraph extension documentation](https://github.com/sourcegraph/sourcegraph-extension-docs) and check out some [Sourcegraph extension samples](https://github.com/sourcegraph/sourcegraph-extension-samples).\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"skeleton-language-extension\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/sourcegraph/sourcegraph-extension-samples\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/skeleton-language-extension.js src/skeleton-language-extension.ts\\\",\\n    \\\"serve\\\": \\\"npm run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --out-file dist/skeleton-language-extension.js src/skeleton-language-extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run build\\\",\\n    \\\"symlink-package\\\": \\\"mkdirp dist \\\\u0026\\\\u0026 lnfs ./package.json ./dist/package.json\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"title\\\": \\\"Skeleton language extension\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/3022-sourcegraph-skeleton-language-extension.js?bwqlvdghrl8w--sourcegraph-skeleton-language-extension\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Minimal example of a language extension\"},\"createdAt\":\"2018-12-21T01:10:32Z\",\"updatedAt\":\"2018-12-21T01:10:32Z\",\"url\":\"/extensions/sourcegraph/skeleton-language-extension\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxOTh9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/lightstep\",\"extensionIDWithoutRegistry\":\"sourcegraph/lightstep\",\"name\":\"lightstep\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"External services\\\"\\n  ],\\n  \\\"commitlint\\\": {\\n    \\\"extends\\\": [\\n      \\\"@commitlint/config-conventional\\\"\\n    ]\\n  },\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [\\n      {\\n        \\\"category\\\": \\\"LightStep\\\",\\n        \\\"command\\\": \\\"updateConfiguration\\\",\\n        \\\"commandArguments\\\": [\\n          [\\n            \\\"lightstep.hideSpanReferences\\\"\\n          ],\\n          \\\"${!config.lightstep.hideSpanReferences}\\\",\\n          null,\\n          \\\"json\\\"\\n        ],\\n        \\\"id\\\": \\\"lightstep.toggleSpanReferences\\\",\\n        \\\"title\\\": \\\"${config.lightstep.hideSpanReferences \\\\u0026\\\\u0026 \\\\\\\"Show\\\\\\\" || \\\\\\\"Hide\\\\\\\"} trace links\\\"\\n      },\\n      {\\n        \\\"actionItem\\\": {\\n          \\\"description\\\": \\\"Set your LightStep project name to view links to LightStep live traces.\\\",\\n          \\\"label\\\": \\\"⚠️ Set LightStep project\\\"\\n        },\\n        \\\"category\\\": \\\"LightStep\\\",\\n        \\\"command\\\": \\\"lightstep.setProjectName\\\",\\n        \\\"id\\\": \\\"lightstep.setProjectName\\\",\\n        \\\"title\\\": \\\"Set project name\\\"\\n      }\\n    ],\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"lightstep.projectName\\\": {\\n          \\\"description\\\": \\\"The name of the LightStep project in which to view live traces (e.g., my-project in https://app.lightstep.com/my-project).\\\",\\n          \\\"minLength\\\": 1,\\n          \\\"type\\\": \\\"string\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"LightStep configuration\\\"\\n    },\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [\\n        {\\n          \\\"action\\\": \\\"lightstep.toggleSpanReferences\\\"\\n        },\\n        {\\n          \\\"action\\\": \\\"lightstep.setProjectName\\\"\\n        }\\n      ],\\n      \\\"editor/title\\\": [\\n        {\\n          \\\"action\\\": \\\"lightstep.setProjectName\\\",\\n          \\\"when\\\": \\\"!config.lightstep.projectName \\\\u0026\\\\u0026 lightstep.needsProjectName\\\"\\n        }\\n      ]\\n    }\\n  },\\n  \\\"dependencies\\\": {},\\n  \\\"description\\\": \\\"View live traces on LightStep for OpenTracing spans in your code\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@commitlint/cli\\\": \\\"^7.0.0\\\",\\n    \\\"@commitlint/config-conventional\\\": \\\"^7.0.1\\\",\\n    \\\"@sourcegraph/prettierrc\\\": \\\"^2.2.0\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^3.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^12.1.0\\\",\\n    \\\"@types/expect\\\": \\\"^1.20.4\\\",\\n    \\\"@types/mocha\\\": \\\"^5.2.6\\\",\\n    \\\"@types/sinon\\\": \\\"^7.0.8\\\",\\n    \\\"expect\\\": \\\"^24.1.0\\\",\\n    \\\"husky\\\": \\\"^1.3.1\\\",\\n    \\\"mocha\\\": \\\"^6.0.2\\\",\\n    \\\"nyc\\\": \\\"^13.3.0\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.11.0\\\",\\n    \\\"prettier\\\": \\\"^1.16.4\\\",\\n    \\\"sinon\\\": \\\"^7.2.6\\\",\\n    \\\"source-map-support\\\": \\\"^0.5.10\\\",\\n    \\\"sourcegraph\\\": \\\"^22.0.0\\\",\\n    \\\"ts-node\\\": \\\"^8.0.2\\\",\\n    \\\"tslint\\\": \\\"^5.13.1\\\",\\n    \\\"typescript\\\": \\\"^3.3.3333\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/lightstep\\\",\\n  \\\"husky\\\": {\\n    \\\"hooks\\\": {\\n      \\\"commit-msg\\\": \\\"commitlint -e $HUSKY_GIT_PARAMS\\\"\\n    }\\n  },\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"license\\\": \\\"Apache\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"lightstep\\\",\\n  \\\"nyc\\\": {\\n    \\\"exclude\\\": [\\n      \\\"**/*.test.ts\\\"\\n    ],\\n    \\\"extension\\\": [\\n      \\\".ts\\\"\\n    ],\\n    \\\"include\\\": [\\n      \\\"src/**/*.ts\\\"\\n    ]\\n  },\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# LightStep for Sourcegraph\\\\n\\\\nA [Sourcegraph extension](https://docs.sourcegraph.com/extensions) that lets you view live traces on [LightStep](https://lightstep.com) for [OpenTracing](https://opentracing.io) spans in your code.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/sourcegraph-lightstep)\\\\n\\\\n[**➕ Add to Sourcegraph**](https://sourcegraph.com/extensions/sourcegraph/lightstep) (see [usage instructions](#usage) for self-hosted Sourcegraph instances)\\\\n\\\\n## Features\\\\n\\\\nWorks on [Sourcegraph.com](https://sourcegraph.com) and [self-hosted Sourcegraph instances](https://docs.sourcegraph.com/#quickstart).\\\\n\\\\n- **Live traces on LightStep** link decoration on lines containing OpenTracing start span calls\\\\n\\\\n![Screenshot](https://storage.googleapis.com/sourcegraph-assets/LightStep_Sourcegraph.png)\\\\n\\\\n## Usage\\\\n\\\\n1. Enable the `sourcegraph/lightstep` extension:\\\\n   - On Sourcegraph.com, visit [https://sourcegraph.com/extensions/sourcegraph/lightstep](https://sourcegraph.com/extensions/sourcegraph/lightstep) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/lightstep`, and enable it.\\\\n1. Visit any code file containing an OpenTracing start span call. (If the extension needs configuration, it will say so on lines containing OpenTracing calls and in the file header.)\\\\n1. Click on the **Live traces (LightStep)** link that appears at the end of the line of each OpenTracing start span call to open the LightStep live traces page for that operation.\\\\n\\\\n## Roadmap\\\\n\\\\n- Support more patterns for OpenTracing span starts. The current regexp for matching these is quite simple.\\\\n- Add at-a-glance summary about a span in a hover message.\\\\n- Display all spans in the current file, tree, and repository.\\\\n- Support usage in the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n- Link to LightStep queries for tags and other properties of a span.\\\\n- Show all recent tag values for a span (for all tags, and for each tag defined in a call).\\\\n- Show spans that contain a given span.\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/sourcegraph/sourcegraph-lightstep\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --no-minify --out-file extension.js src/extension.ts\\\",\\n    \\\"cover\\\": \\\"TS_NODE_COMPILER_OPTIONS='{\\\\\\\"module\\\\\\\":\\\\\\\"commonjs\\\\\\\"}' nyc --require ts-node/register --require source-map-support/register --all mocha --opts mocha.opts --timeout 10000\\\",\\n    \\\"serve\\\": \\\"parcel serve --no-hmr --out-file extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn typecheck \\\\u0026\\\\u0026 yarn test \\\\u0026\\\\u0026 yarn build\\\",\\n    \\\"test\\\": \\\"TS_NODE_COMPILER_OPTIONS='{\\\\\\\"module\\\\\\\":\\\\\\\"commonjs\\\\\\\"}' mocha --require ts-node/register --require source-map-support/register --opts mocha.opts\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"tags\\\": [\\n    \\\"lightstep\\\",\\n    \\\"opentracing\\\",\\n    \\\"tracing\\\",\\n    \\\"perf\\\"\\n  ],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/3053-sourcegraph-lightstep.js?bx49kd1qs55k--sourcegraph-lightstep\\\"\\n}\",\"description\":\"View live traces on LightStep for OpenTracing spans in your code\"},\"createdAt\":\"2019-03-04T00:56:49Z\",\"updatedAt\":\"2019-03-04T00:56:49Z\",\"url\":\"/extensions/sourcegraph/lightstep\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxOTl9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/code-ownership\",\"extensionIDWithoutRegistry\":\"sourcegraph/code-ownership\",\"name\":\"code-ownership\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Reports and stats\\\"\\n  ],\\n  \\\"commitlint\\\": {\\n    \\\"extends\\\": [\\n      \\\"@commitlint/config-conventional\\\"\\n    ]\\n  },\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [\\n      {\\n        \\\"category\\\": \\\"Code ownership\\\",\\n        \\\"command\\\": \\\"updateConfiguration\\\",\\n        \\\"commandArguments\\\": [\\n          [\\n            \\\"codeOwnership.hide\\\"\\n          ],\\n          \\\"${!config.codeOwnership.hide}\\\",\\n          null,\\n          \\\"json\\\"\\n        ],\\n        \\\"id\\\": \\\"codeOwnership.toggle\\\",\\n        \\\"title\\\": \\\"${config.codeOwnership.hide \\\\u0026\\\\u0026 \\\\\\\"Show\\\\\\\" || \\\\\\\"Hide\\\\\\\"}\\\"\\n      },\\n      {\\n        \\\"actionItem\\\": {\\n          \\\"description\\\": \\\"${get(context, `codeOwnership.file.${resource.uri}.description`)}\\\",\\n          \\\"label\\\": \\\"${get(context, `codeOwnership.file.${resource.uri}.label`)}\\\"\\n        },\\n        \\\"command\\\": \\\"open\\\",\\n        \\\"commandArguments\\\": [\\n          \\\"${get(context, `codeOwnership.file.${resource.uri}.url`)}\\\"\\n        ],\\n        \\\"id\\\": \\\"codeOwnership.file\\\"\\n      }\\n    ],\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"codeOwnership.hide\\\": {\\n          \\\"default\\\": false,\\n          \\\"description\\\": \\\"Hide the current file's code owner (do not show it in the file header).\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Code ownership configuration\\\"\\n    },\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [\\n        {\\n          \\\"action\\\": \\\"codeOwnership.toggle\\\"\\n        }\\n      ],\\n      \\\"editor/title\\\": [\\n        {\\n          \\\"action\\\": \\\"codeOwnership.file\\\",\\n          \\\"when\\\": \\\"!config.codeOwnership.hide \\\\u0026\\\\u0026 get(context, `codeOwnership.file.${resource.uri}.label`)\\\"\\n        }\\n      ]\\n    }\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"ignore\\\": \\\"^5.0.5\\\",\\n    \\\"rxjs\\\": \\\"^6.5.5\\\",\\n    \\\"tagged-template-noop\\\": \\\"^2.1.1\\\"\\n  },\\n  \\\"description\\\": \\\"See code owners of the current file\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@commitlint/cli\\\": \\\"^9.1.2\\\",\\n    \\\"@commitlint/config-conventional\\\": \\\"^9.1.2\\\",\\n    \\\"@sourcegraph/eslint-config\\\": \\\"^0.20.8\\\",\\n    \\\"@sourcegraph/prettierrc\\\": \\\"^3.0.3\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^3.0.0\\\",\\n    \\\"@types/mocha\\\": \\\"7.0.2\\\",\\n    \\\"@types/node\\\": \\\"12.7.3\\\",\\n    \\\"@types/sinon\\\": \\\"9.0.4\\\",\\n    \\\"eslint\\\": \\\"^7.8.1\\\",\\n    \\\"husky\\\": \\\"^4.2.5\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^1.0.3\\\",\\n    \\\"mocha\\\": \\\"^7.1.1\\\",\\n    \\\"nyc\\\": \\\"^13.3.0\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.11.0\\\",\\n    \\\"prettier\\\": \\\"^2.1.1\\\",\\n    \\\"sinon\\\": \\\"^9.0.2\\\",\\n    \\\"source-map-support\\\": \\\"^0.5.10\\\",\\n    \\\"sourcegraph\\\": \\\"^24.7.0\\\",\\n    \\\"ts-node\\\": \\\"^8.0.2\\\",\\n    \\\"typescript\\\": \\\"^3.9.5\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/code-ownership\\\",\\n  \\\"husky\\\": {\\n    \\\"hooks\\\": {\\n      \\\"commit-msg\\\": \\\"commitlint -e $HUSKY_GIT_PARAMS\\\"\\n    }\\n  },\\n  \\\"icon\\\": \\\"data:image/svg+xml,\\\\u003csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22\\\\u003e\\\\u003ctext y=%22.9em%22 font-size=%2290%22\\\\u003e🔐\\\\u003c/text\\\\u003e\\\\u003c/svg\\\\u003e\\\",\\n  \\\"license\\\": \\\"Apache\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"code-ownership\\\",\\n  \\\"nyc\\\": {\\n    \\\"exclude\\\": [\\n      \\\"**/*.test.ts\\\"\\n    ],\\n    \\\"extension\\\": [\\n      \\\".ts\\\"\\n    ],\\n    \\\"include\\\": [\\n      \\\"src/**/*.ts\\\"\\n    ]\\n  },\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code ownership extension for Sourcegraph\\\\n\\\\n[![Build Status](https://travis-ci.org/sourcegraph/sourcegraph-code-ownership.svg?branch=master)](https://travis-ci.org/sourcegraph/sourcegraph-code-ownership)\\\\n\\\\nA [Sourcegraph extension](https://docs.sourcegraph.com/extensions) that shows code owners of the current file.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/sourcegraph-code-ownership)\\\\n\\\\n[**➕ Add to Sourcegraph**](https://sourcegraph.com/extensions/sourcegraph/code-ownership) (see [usage instructions](#usage) for self-hosted Sourcegraph instances)\\\\n\\\\n## Features\\\\n\\\\nWorks on [Sourcegraph.com](https://sourcegraph.com), [self-hosted Sourcegraph instances](https://docs.sourcegraph.com/#quickstart), and on code hosts (via the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension)).\\\\n\\\\n- **Code owner of current file** displayed in the file header\\\\n\\\\nOnly [`CODEOWNERS` and `.github/CODEOWNERS` files](https://help.github.com/en/articles/about-code-owners) are supported right now. [File an issue](https://github.com/sourcegraph/sourcegraph-code-ownership/issues) if you want need support for another code ownership scheme.\\\\n\\\\n![Screenshot](https://storage.googleapis.com/sourcegraph-assets/code-ownership-extension-0.png)\\\\n\\\\n## Usage\\\\n\\\\n**Note:** Using this extension on private code in the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension) requires a [self-hosted Sourcegraph instance](https://docs.sourcegraph.com/#quickstart) (because it needs access to the repository's files that define code owners).\\\\n\\\\n1. Enable the `sourcegraph/code-ownership` extension:\\\\n   - On Sourcegraph.com, visit [https://sourcegraph.com/extensions/sourcegraph/code-ownership](https://sourcegraph.com/extensions/sourcegraph/code-ownership) to enable it.\\\\n   - On a self-hosted Sourcegraph instance, select **User menu \\\\u003e Extensions**, search for `sourcegraph/code-ownership`, and enable it.\\\\n1. Visit any code file in a repository containing a `CODEOWNERS` or `.github/CODEOWNERS` file.\\\\n1. Look in the file header to see the current file's code owner(s).\\\\n\\\\n### On your code host\\\\n\\\\nThis extension adds the same features on your code host if you're using the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension). To use it on your code host:\\\\n\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - If you're using it with a self-hosted Sourcegraph instance, enter the Sourcegraph instance URL into the Sourcegraph browser extension options menu.\\\\n1. Follow the [usage steps](#usage) above to enable the `sourcegraph/code-ownership` extension.\\\\n1. Visit any code file (on your code host) in a repository containing a `CODEOWNERS` or `.github/CODEOWNERS` file.\\\\n1. Look in the file header to see the current file's code owner(s).\\\\n\\\\n![Screenshot on GitHub](https://storage.googleapis.com/sourcegraph-assets/code-ownership-extension-github-0.png)\\\\n\\\\n## Roadmap\\\\n\\\\n- More ways to define code owners (such as by directory-specific CODEOWNERS files, from an external code owners service, etc.)\\\\n- Per-repository configuration of how code owners are defined\\\\n- Search by code owner (e.g., `codeowner:alice` in a Sourcegraph search query)\\\\n- Directory ownership\\\\n- Filter a code review to only diffs to files you own\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/sourcegraph/sourcegraph-code-ownership\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --no-minify --out-file extension.js src/extension.ts\\\",\\n    \\\"cover\\\": \\\"TS_NODE_COMPILER_OPTIONS='{\\\\\\\"module\\\\\\\":\\\\\\\"commonjs\\\\\\\"}' nyc --require ts-node/register --require source-map-support/register --all mocha --opts mocha.opts --timeout 10000\\\",\\n    \\\"eslint\\\": \\\"eslint './src/**/*.ts'\\\",\\n    \\\"prettier\\\": \\\"prettier '**/{*.{js?(on),ts?(x),md,yml},.*.js?(on),.*.yml}' --write --list-different\\\",\\n    \\\"prettier-check\\\": \\\"yarn run prettier --write=false\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --out-file extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn typecheck \\\\u0026\\\\u0026 yarn test \\\\u0026\\\\u0026 yarn build\\\",\\n    \\\"symlink-package\\\": \\\"mkdirp dist \\\\u0026\\\\u0026 lnfs ./package.json ./dist/package.json\\\",\\n    \\\"test\\\": \\\"TS_NODE_COMPILER_OPTIONS='{\\\\\\\"module\\\\\\\":\\\\\\\"commonjs\\\\\\\"}' mocha --require ts-node/register --require source-map-support/register --opts mocha.opts\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"tags\\\": [\\n    \\\"codeowners\\\",\\n    \\\"owners\\\",\\n    \\\"team\\\"\\n  ],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/8613-sourcegraph-code-ownership.js?c5v15ut08nbk--sourcegraph-code-ownership\\\"\\n}\",\"description\":\"See code owners of the current file\"},\"createdAt\":\"2019-03-04T17:36:36Z\",\"updatedAt\":\"2019-03-04T17:36:36Z\",\"url\":\"/extensions/sourcegraph/code-ownership\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyMDB9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjo2NTQ2\",\"username\":\"tobias\",\"displayName\":\"Tobiasz Cudnik\",\"url\":\"/users/tobias\"},\"extensionID\":\"tobias/token-highlights\",\"extensionIDWithoutRegistry\":\"tobias/token-highlights\",\"name\":\"token-highlights\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [],\\n    \\\"configuration\\\": {},\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [],\\n      \\\"editor/title\\\": []\\n    }\\n  },\\n  \\\"description\\\": \\\"Highlights token references when hovering over one.\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^4.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^12.3.1\\\",\\n    \\\"@types/jest\\\": \\\"23.3.12\\\",\\n    \\\"@types/node\\\": \\\"^11.11.3\\\",\\n    \\\"@types/sinon\\\": \\\"^7.0.10\\\",\\n    \\\"jest\\\": \\\"^24.5.0\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^0.5.1\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.12.2\\\",\\n    \\\"sinon\\\": \\\"^7.2.7\\\",\\n    \\\"sourcegraph\\\": \\\"^23.0.0\\\",\\n    \\\"ts-jest\\\": \\\"^24.0.0\\\",\\n    \\\"tslint\\\": \\\"^5.14.0\\\",\\n    \\\"typescript\\\": \\\"^3.3.3333\\\"\\n  },\\n  \\\"extensionID\\\": \\\"tobias/token-highlights\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/token-highlights.js\\\",\\n  \\\"name\\\": \\\"token-highlights\\\",\\n  \\\"publisher\\\": \\\"tobias\\\",\\n  \\\"readme\\\": \\\"# Token Highlights\\\\n\\\\n[SourceGraph](https://github.com/sourcegraph/sourcegraph) extension to highlight token references when hovering over one.\\\\n\\\\nForked from the [samples repo](https://github.com/sourcegraph/sourcegraph-extension-samples/tree/master/token-highlights) by Chris.\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/TobiaszCudnik/sourcegraph-token-highlights\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/token-highlights.js src/token-highlights.ts\\\",\\n    \\\"serve\\\": \\\"npm run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --out-file dist/token-highlights.js src/token-highlights.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run build\\\",\\n    \\\"symlink-package\\\": \\\"mkdirp dist \\\\u0026\\\\u0026 lnfs ./package.json ./dist/package.json\\\",\\n    \\\"test\\\": \\\"jest\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"tags\\\": [],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/2754-tobias-token-highlights.js?bsqtatmkwk94--tobias-token-highlights\\\",\\n  \\\"version\\\": \\\"0.1.0\\\"\\n}\",\"description\":\"Highlights token references when hovering over one.\"},\"createdAt\":\"2019-03-18T18:37:50Z\",\"updatedAt\":\"2019-03-18T18:37:50Z\",\"url\":\"/extensions/tobias/token-highlights\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyMDd9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/sentry\",\"extensionIDWithoutRegistry\":\"sourcegraph/sentry\",\"name\":\"sentry\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"External services\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [\\n      {\\n        \\\"actionItem\\\": {\\n          \\\"description\\\": \\\"${config.sentry.decorations.inline \\\\u0026\\\\u0026 \\\\\\\"Hide\\\\\\\" || \\\\\\\"Show\\\\\\\"} inline Sentry links\\\",\\n          \\\"iconDescription\\\": \\\"${config.sentry.decorations.inline \\\\u0026\\\\u0026 \\\\\\\"Hide\\\\\\\" || \\\\\\\"Show\\\\\\\"} inline Sentry links on file\\\",\\n          \\\"iconURL\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph-sentry/master/assets/img/sentry-glyph-${config.sentry.decorations.inline\\\\u0026\\\\u0026\\\\\\\"red\\\\\\\"||\\\\\\\"grey\\\\\\\"}.svg?sanitize=true\\\",\\n          \\\"pressed\\\": \\\"config.sentry.decorations.inline\\\"\\n        },\\n        \\\"category\\\": \\\"Sentry\\\",\\n        \\\"command\\\": \\\"updateConfiguration\\\",\\n        \\\"commandArguments\\\": [\\n          [\\n            \\\"sentry.decorations.inline\\\"\\n          ],\\n          \\\"${!config.sentry.decorations.inline}\\\",\\n          null,\\n          \\\"json\\\"\\n        ],\\n        \\\"id\\\": \\\"sentry.decorations.toggle\\\",\\n        \\\"title\\\": \\\"${config.sentry.decorations.inline \\\\u0026\\\\u0026 \\\\\\\"Hide\\\\\\\" || \\\\\\\"Show\\\\\\\"} inline Sentry links on file\\\"\\n      }\\n    ],\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"sentry.organization\\\": {\\n          \\\"default\\\": \\\"\\\",\\n          \\\"description\\\": \\\"Name of the Sentry organization\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        },\\n        \\\"sentry.projects\\\": {\\n          \\\"items\\\": {\\n            \\\"additionalProperties\\\": {\\n              \\\"contentText\\\": {\\n                \\\"description\\\": \\\"Text shown in Sentry link, e.g. View sourcegraph/sourcegraph_dot_com errors\\\",\\n                \\\"type\\\": \\\"string\\\"\\n              },\\n              \\\"hoverMessage\\\": {\\n                \\\"description\\\": \\\"Hovertext shown on Sentry link, e.g. View errors matching '$1' in Sentry\\\",\\n                \\\"type\\\": \\\"string\\\"\\n              },\\n              \\\"query\\\": {\\n                \\\"description\\\": \\\"Query derived from error handling code $1\\\",\\n                \\\"type\\\": \\\"string\\\"\\n              }\\n            },\\n            \\\"description\\\": \\\"Sentry project receiving logs\\\",\\n            \\\"name\\\": {\\n              \\\"type\\\": \\\"string\\\"\\n            },\\n            \\\"patternProperties\\\": {\\n              \\\"fileMatches\\\": {\\n                \\\"description\\\": \\\"Regex to match files associated with this project, e.g. (web|shared)/.*\\\\\\\\.tsx?$\\\",\\n                \\\"items\\\": {\\n                  \\\"type\\\": \\\"string\\\"\\n                },\\n                \\\"type\\\": \\\"array\\\"\\n              },\\n              \\\"lineMatches\\\": {\\n                \\\"description\\\": \\\"Regex to match lines associated with this project, e.g. throw new Error\\\\\\\\([\\\\\\\"']([^'\\\\\\\"]+)[\\\\\\\"']\\\\\\\\)\\\",\\n                \\\"items\\\": {\\n                  \\\"type\\\": \\\"string\\\"\\n                },\\n                \\\"type\\\": \\\"array\\\"\\n              },\\n              \\\"repoMatches\\\": {\\n                \\\"description\\\": \\\"Regex to match repos associated to this Sentry project, e.g. github\\\\\\\\.com/sourcegraph/sourcegraph\\\",\\n                \\\"items\\\": {\\n                  \\\"type\\\": \\\"string\\\"\\n                },\\n                \\\"type\\\": \\\"array\\\"\\n              }\\n            },\\n            \\\"projectId\\\": {\\n              \\\"description\\\": \\\"Sentry project id, e.g. 12351512\\\",\\n              \\\"type\\\": \\\"string\\\"\\n            },\\n            \\\"type\\\": \\\"object\\\"\\n          },\\n          \\\"type\\\": \\\"array\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Sentry extension settings\\\"\\n    },\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [\\n        {\\n          \\\"action\\\": \\\"sentry.decorations.toggle\\\",\\n          \\\"when\\\": \\\"resource\\\"\\n        },\\n        {\\n          \\\"action\\\": \\\"sentry.link.fileList\\\",\\n          \\\"when\\\": \\\"resource \\\\u0026\\\\u0026 get(context, `sentry.fileURL.${resource.uri}`)\\\"\\n        },\\n        {\\n          \\\"action\\\": \\\"sentry.help\\\"\\n        }\\n      ],\\n      \\\"editor/title\\\": [\\n        {\\n          \\\"action\\\": \\\"sentry.decorations.toggle\\\",\\n          \\\"alt\\\": \\\"sentry.link.fileList\\\",\\n          \\\"when\\\": \\\"resource \\\\u0026\\\\u0026 !config.sentry.hideSentryButton\\\"\\n        }\\n      ],\\n      \\\"help\\\": [\\n        {\\n          \\\"action\\\": \\\"sentry.help\\\"\\n        }\\n      ]\\n    }\\n  },\\n  \\\"description\\\": \\\"Sourcegraph Sentry extension renders \\\\\\\"View logs on Sentry\\\\\\\" links next to error handling code.\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/extension-api-stubs\\\": \\\"^1.2.2\\\",\\n    \\\"@sourcegraph/prettierrc\\\": \\\"^2.2.0\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^4.0.1\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^13.4.0\\\",\\n    \\\"@types/expect\\\": \\\"1.20.4\\\",\\n    \\\"@types/lodash\\\": \\\"4.14.161\\\",\\n    \\\"@types/mocha\\\": \\\"5.2.7\\\",\\n    \\\"@types/mock-require\\\": \\\"2.0.0\\\",\\n    \\\"@types/node\\\": \\\"11.13.3\\\",\\n    \\\"@types/sinon\\\": \\\"7.0.13\\\",\\n    \\\"expect\\\": \\\"24.1.0\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"lodash\\\": \\\"^4.17.11\\\",\\n    \\\"mkdirp\\\": \\\"^0.5.1\\\",\\n    \\\"mocha\\\": \\\"^6.1.4\\\",\\n    \\\"mock-require\\\": \\\"^3.0.3\\\",\\n    \\\"nyc\\\": \\\"^14.1.1\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.12.3\\\",\\n    \\\"prettier\\\": \\\"1.19.1\\\",\\n    \\\"rxjs\\\": \\\"^6.5.2\\\",\\n    \\\"sinon\\\": \\\"^7.3.2\\\",\\n    \\\"source-map-support\\\": \\\"^0.5.12\\\",\\n    \\\"sourcegraph\\\": \\\"^24.7.0\\\",\\n    \\\"ts-node\\\": \\\"^8.3.0\\\",\\n    \\\"tslint\\\": \\\"^6.1.3\\\",\\n    \\\"typescript\\\": \\\"^3.5.2\\\"\\n  },\\n  \\\"extensionID\\\": \\\"Sourcegraph/sentry\\\",\\n  \\\"icon\\\": \\\"data:image/png;base64,\\\",\\n  \\\"iconDark\\\": \\\"data:image/svg+xml;base64,\\\",\\n  \\\"license\\\": \\\"Apache-2.0\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"mocha\\\": {\\n    \\\"spec\\\": \\\"src/test/**/*.test.ts\\\"\\n  },\\n  \\\"name\\\": \\\"sentry\\\",\\n  \\\"nyc\\\": {\\n    \\\"exclude\\\": [\\n      \\\"**/*.test.ts?(x)\\\",\\n      \\\"**/*.d.ts\\\"\\n    ],\\n    \\\"extension\\\": [\\n      \\\".tsx\\\",\\n      \\\".ts\\\"\\n    ],\\n    \\\"include\\\": [\\n      \\\"src/**/*.ts?(x)\\\"\\n    ],\\n    \\\"reporter\\\": [\\n      \\\"text\\\",\\n      \\\"json\\\"\\n    ]\\n  },\\n  \\\"publisher\\\": \\\"Sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Sentry extension\\\\n\\\\n[![build](https://travis-ci.org/sourcegraph/sourcegraph-sentry.svg?branch=master)](https://travis-ci.org/sourcegraph/sentry)\\\\n[![codecov](https://codecov.io/gh/sourcegraph/sourcegraph-sentry/branch/master/graph/badge.svg)](https://codecov.io/gh/sourcegraph/sourcegraph-sentry)\\\\n\\\\nSentry facilitates the debugging process by helping developers track, organize, and break down errors more efficiently. At Sourcegraph, we want to make it more convenient for developers to access Sentry's error tracking tools directly from the code that is doing the error handling. For example: `throw new Error(QUERY)`, `console.log(QUERY)`, and `console.error(QUERY)`.\\\\n\\\\nThe Sentry extension renders `View logs in Sentry` next to error throwing statements, and links directly to the corresponding Sentry issues stream page. Links are rendered when viewing files on [Sourcegraph](https://sourcegraph.com), GitHub, and GitLab.\\\\n\\\\n- **Sentry: Show/hide Sentry**: toggles Sentry links decorations with each matching error handling code.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/sentry)\\\\n\\\\n[**➕ Add to Sourcegraph**](https://sourcegraph.com/extensions/sourcegraph/sentry)\\\\n\\\\n![image](https://user-images.githubusercontent.com/9110008/54014672-d7b4fe00-41c0-11e9-9b92-66d851401fa0.png)\\\\n\\\\n## Language support\\\\n\\\\nThe Sentry Sourcegraph extension uses common error handling and/or exception throwing patterns specific to each language to identfy Sentry relevant lines of code. The following languages are currently supported:\\\\n\\\\n- TypeScript, JavaScript ( e.g. `throw new Error()`, `console.error()`)\\\\n- Go ( e.g. `errors.New()`)\\\\n- JavaScript ( e.g. `console.error()`)\\\\n- Python ( e.g. `raise ValueError()`)\\\\n- Java ( e.g. `logger.error()`)\\\\n\\\\nSee the [default error patterns](https://sourcegraph.com/github.com/sourcegraph/sourcegraph-sentry@master/-/blob/src/extension.ts?diff=21f9b0716040dd96f917580ec4cacd59f3f1b5be\\\\u0026utm_source=chrome-extension#L11-25).\\\\n\\\\nIf you need to match more specific patterns in your codebase, you can configure them through [line matches](#improving-error-pattern-recognition-for-your-organization).\\\\n\\\\n## Basic Setup\\\\n\\\\nIn your Sourcegraph settings (user, organization, or global), add the following configuration:\\\\n\\\\n```\\\\n\\\\\\\"sentry.decorations.inline\\\\\\\": true,\\\\n\\\\\\\"sentry.organization\\\\\\\": \\\\\\\"\\\\u003cyour_sentry_organization\\\\u003e\\\\\\\",\\\\n\\\\\\\"sentry.projects\\\\\\\": [\\\\n    {\\\\n        // All matching error statements in your sourcegraph instance will link to this project\\\\n        \\\\\\\"projectId\\\\\\\": \\\\\\\"\\\\u003cyour_sentry_project_id\\\\u003e\\\\\\\",\\\\n    }\\\\n]\\\\n```\\\\n\\\\nFor organizations, we recommend to set this once by the site admin in the org or global settings, so that individual org users do not have to configure this individually.\\\\n\\\\nWith this simple configuration, any error that matches the default patterns will link to the specified Sentry organization and project.\\\\n\\\\nTo find your Sentry organization and project ID, go to [sentry.io](http://sentry.io) and look at the URL when on your project page, e.g.:\\\\n\\\\n```\\\\nhttps://sentry.io/organizations/sourcegraph/events/?project=1251215\\\\n```\\\\n\\\\nIn the above, `sourcegraph` is the organization and `1251215` is the project ID.\\\\n\\\\n## Mapping multiple Sentry projects to various repositories\\\\n\\\\nSome organizations have multiple Sentry projects that capture errors from various repositories within their organization. Inside each Sentry project, use repository `filters` like so:\\\\n\\\\n```\\\\n\\\\\\\"sentry.decorations.inline\\\\\\\": true,\\\\n\\\\\\\"sentry.organization\\\\\\\": \\\\\\\"\\\\u003cyour_sentry_organization\\\\u003e\\\\\\\",\\\\n\\\\\\\"sentry.projects\\\\\\\": [\\\\n    {\\\\n        // All repositoryA error patterns link to Project A in Sentry\\\\n        \\\\\\\"projectId\\\\\\\": \\\\\\\"\\\\u003cproject_a\\\\u003e\\\\\\\",\\\\n        \\\\\\\"filters\\\\\\\": [\\\\n            {\\\\n                \\\\\\\"repositories\\\\\\\": [\\\\n                    \\\\\\\"myorg/repositoryA$\\\\\\\" // Regexp matching repositories that report to this Sentry project\\\\n                ]\\\\n            }\\\\n        ]\\\\n    },\\\\n    {\\\\n        // All repositoryB error patterns link to Project B in Sentry\\\\n        \\\\\\\"projectId\\\\\\\": \\\\\\\"\\\\u003cproject_b\\\\u003e\\\\\\\",\\\\n        \\\\\\\"filters\\\\\\\": [\\\\n            {\\\\n                \\\\\\\"repositories\\\\\\\": [\\\\n                    \\\\\\\"myorg/repositoryB$\\\\\\\"\\\\n                ]\\\\n            }\\\\n        ]\\\\n    }\\\\n]\\\\n```\\\\n\\\\nIn this example, errors found in `repositoryA` will link to `project_a`, and errors in `repositoryB` will link to `project_b` in Sentry.\\\\n\\\\n## Mapping a single repository to multiple Sentry projects\\\\n\\\\nSome organizations will have different parts of their code base map to different Sentry projects. For example, all frontend code is sent to one Sentry project, and all backend code is sent to another.\\\\n\\\\nYou can add multiple Sentry projects and add file `filters` to match specific files or folders, like so:\\\\n\\\\n```\\\\n\\\\\\\"sentry.decorations.inline\\\\\\\": true,\\\\n\\\\\\\"sentry.organization\\\\\\\": \\\\\\\"\\\\u003cyour_sentry_organization\\\\u003e\\\\\\\",\\\\n\\\\\\\"sentry.projects\\\\\\\": [\\\\n    {\\\\n        // All JS files link to Project A in Sentry\\\\n        \\\\\\\"projectId\\\\\\\": \\\\\\\"\\\\u003cproject_a\\\\u003e\\\\\\\",\\\\n        \\\\\\\"filters\\\\\\\": [\\\\n            {\\\\n                \\\\\\\"files\\\\\\\": [\\\\n                    \\\\\\\"\\\\\\\\\\\\\\\\.js?\\\\\\\" // RegExp that matches JavaScript files\\\\n                ]\\\\n            }\\\\n        ]\\\\n    },\\\\n    {\\\\n        // All Go files link to Project B in Sentry\\\\n        \\\\\\\"projectId\\\\\\\": \\\\\\\"\\\\u003cproject_b\\\\u003e\\\\\\\",\\\\n        \\\\\\\"filters\\\\\\\": [\\\\n            {\\\\n                \\\\\\\"files\\\\\\\": [\\\\n                    \\\\\\\"\\\\\\\\\\\\\\\\.go?\\\\\\\"\\\\n                ]\\\\n            }\\\\n        ]\\\\n    }\\\\n]\\\\n```\\\\n\\\\nNow, errors found in JS files will link to `project_a` and errors in Go files will link to `project_b` in Sentry.\\\\n\\\\nYou can also match repository subdirectories using a regex (e.g. `\\\\\\\"(?:web|node)\\\\\\\\/.*\\\\\\\\\\\\\\\\.tsx?\\\\\\\"` to match any files with the `.tsx` extension within directories named `web` or `node`).\\\\n\\\\n## Improving error pattern recognition for your organization\\\\n\\\\nBy default, the extension matches error messages from a few popular languages. However, you may need to define your own patterns to enhance matches for your specific codebase, or that we do not currently support.\\\\n\\\\nTo do this, add a regex to your Sentry project config that captures the static error message generated. For example, to match JS/TS throw statements:\\\\n\\\\n```\\\\n\\\\\\\"sentry.projects\\\\\\\": [\\\\n    {\\\\n        // Frontend errors\\\\n        \\\\\\\"projectId\\\\\\\": \\\\\\\"\\\\u003cproject_a\\\\u003e\\\\\\\",\\\\n        \\\\\\\"linePatterns\\\\\\\": [\\\\n            // Matches JS/TS throw statements:\\\\n            \\\\\\\"throw new [A-Za-z0-9]+\\\\\\\\\\\\\\\\(['\\\\\\\\\\\\\\\"]([^'\\\\\\\\\\\\\\\"]+)['\\\\\\\\\\\\\\\"]\\\\\\\\\\\\\\\\)\\\\\\\"\\\\n        ]\\\\n    }\\\\n]\\\\n```\\\\n\\\\nThe error message should always be captured by the capture group \\\\\\\\$INDEX=0. All other capture groups should be made optional with `?:`. For instance, in the above example, note how the first regex group is ignored with `?:`. It will match a variety of `throw new` error types, but doesn't need to be captured. The second regex group captures the error string, which will be used as the search when linked to Sentry.\\\\n\\\\n## Language Specific Examples\\\\n\\\\n- TypeScript\\\\n\\\\n  Configuration:\\\\n\\\\n  ```\\\\n  \\\\\\\"sentry.decorations.inline\\\\\\\": true,\\\\n  \\\\\\\"sentry.organization\\\\\\\": \\\\\\\"sourcegraph\\\\\\\",\\\\n  \\\\\\\"sentry.projects\\\\\\\": [\\\\n      {\\\\n          // Web errors\\\\n          \\\\\\\"projectId\\\\\\\": \\\\\\\"1334031\\\\\\\",\\\\n          \\\\\\\"filters\\\\\\\": [\\\\n              {\\\\n                  \\\\\\\"repositories\\\\\\\": \\\\\\\"sourcegraph/sourcegraph\\\\\\\",\\\\n                  \\\\\\\"files\\\\\\\": [\\\\\\\"web/.*\\\\\\\\\\\\\\\\.ts?\\\\\\\"]\\\\n              },\\\\n              {\\\\n                  \\\\\\\"files\\\\\\\": [\\\\\\\"sourcegraph-about/.*\\\\\\\\\\\\\\\\.tsx?\\\\\\\"]\\\\n              }\\\\n\\\\n          ],\\\\n          \\\\\\\"linePatterns\\\\\\\": [\\\\n              \\\\\\\"throw new [A-Za-z0-9]+\\\\\\\\\\\\\\\\(['\\\\\\\\\\\\\\\"]([^'\\\\\\\\\\\\\\\"]+)['\\\\\\\\\\\\\\\"]\\\\\\\\\\\\\\\\)\\\\\\\",\\\\n              \\\\\\\"console\\\\\\\\\\\\\\\\.(?:warn|debug|info|error)\\\\\\\\\\\\\\\\(['\\\\\\\\\\\\\\\"`]([^'\\\\\\\\\\\\\\\"`]+)['\\\\\\\\\\\\\\\"`]\\\\\\\\\\\\\\\\)\\\\\\\"\\\\n          ]\\\\n      }\\\\n  ]\\\\n  ```\\\\n\\\\n  - [On Sourcegraph](https://sourcegraph.com/github.com/sourcegraph/sourcegraph/-/blob/browser/src/libs/github/file_info.ts#L22)\\\\n  - [On GitHub](https://github.com/sourcegraph/sourcegraph/blob/master/browser/src/libs/github/file_info.ts#L22)\\\\n\\\\n- Go\\\\n\\\\n  Configuration:\\\\n\\\\n  ```\\\\n  \\\\\\\"sentry.decorations.inline\\\\\\\": true,\\\\n  \\\\\\\"sentry.organization\\\\\\\": \\\\\\\"sourcegraph\\\\\\\",\\\\n  \\\\\\\"sentry.projects\\\\\\\": [\\\\n      {\\\\n          // Dev environment errors\\\\n          \\\\\\\"projectId\\\\\\\": \\\\\\\"213332\\\\\\\",\\\\n          \\\\\\\"filters\\\\\\\": [\\\\n              {\\\\n                  \\\\\\\"repositories\\\\\\\": [\\\\\\\"sourcegraph/sourcegraph\\\\\\\", \\\\\\\"sourcegraph/dev-repo\\\\\\\"],\\\\n                  \\\\\\\"files\\\\\\\": [\\\\\\\"auth/.*.go?/\\\\\\\"]\\\\n              },\\\\n              {\\\\n                  \\\\\\\"repositories\\\\\\\": [\\\\\\\"/dev-env\\\\\\\"]\\\\n              }\\\\n          ],\\\\n          \\\\\\\"linePatterns\\\\\\\": [\\\\\\\"errors\\\\\\\\\\\\\\\\.New\\\\\\\\\\\\\\\\(['\\\\\\\\\\\\\\\"`](.*)['\\\\\\\\\\\\\\\"`]\\\\\\\\\\\\\\\\)\\\\\\\"]\\\\n      }\\\\n  ]\\\\n  ```\\\\n\\\\n  - [On Sourcegraph](https://sourcegraph.com/github.com/sourcegraph/sourcegraph/-/blob/cmd/frontend/auth/user_test.go#L54:19)\\\\n  - [On GitHub](https://github.com/sourcegraph/sourcegraph/blob/master/cmd/frontend/auth/user_test.go#L54)\\\\n\\\\n- JavaScript\\\\n\\\\n  - [On Sourcegraph](https://sourcegraph.com/github.com/sourcegraph/sourcegraph/-/blob/shared/.storybook/config.js#L26:15)\\\\n  - [On GitHub](https://github.com/sourcegraph/sourcegraph/blob/master/shared/.storybook/config.js#L26)\\\\n\\\\n- Python\\\\n\\\\n  - [On Sourcegraph](https://sourcegraph.com/github.com/reddit-archive/reddit/-/blob/r2/r2/lib/contrib/ipaddress.py#L279:15)\\\\n  - [On GitHub](https://github.com/reddit-archive/reddit/blob/master/r2/r2/lib/contrib/ipaddress.py#L279)\\\\n\\\\n- Java\\\\n  - [On Sourcegraph](https://sourcegraph.com/github.com/sourcegraph/sourcegraph-jetbrains/-/blob/src/Open.java#L69:13)\\\\n  - [On GitHub](https://github.com/sourcegraph/sourcegraph-jetbrains/blob/master/src/Open.java#L69)\\\\n\\\\nSupport for other languages is coming in future versions.\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/sourcegraph/sourcegraph-sentry.git\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"cover\\\": \\\"TS_NODE_COMPILER_OPTIONS='{\\\\\\\"module\\\\\\\":\\\\\\\"commonjs\\\\\\\"}' nyc --require ts-node/register --require source-map-support/register --all mocha --opts mocha.opts --timeout 10000\\\",\\n    \\\"prettier\\\": \\\"prettier \\\\\\\"**/*.{ts,js,json,md}\\\\\\\" --list-different --write\\\",\\n    \\\"prettier-check\\\": \\\"npm run prettier -- --write=false\\\",\\n    \\\"serve\\\": \\\"npm run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run typecheck \\\\u0026\\\\u0026 npm run test \\\\u0026\\\\u0026 npm run build\\\",\\n    \\\"symlink-package\\\": \\\"mkdirp dist \\\\u0026\\\\u0026 lnfs ./package.json ./dist/package.json\\\",\\n    \\\"test\\\": \\\"TS_NODE_COMPILER_OPTIONS='{\\\\\\\"module\\\\\\\":\\\\\\\"commonjs\\\\\\\"}' mocha --require ts-node/register --require source-map-support/register --opts mocha.opts\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"tags\\\": [\\n    \\\"sentry\\\",\\n    \\\"error tracking\\\",\\n    \\\"errors\\\",\\n    \\\"logs\\\"\\n  ],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/8625-sourcegraph-sentry.js?c600mxruzo0g--sourcegraph-sentry\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\",\\n  \\\"wip\\\": false\\n}\",\"description\":\"Sourcegraph Sentry extension renders \\\"View logs on Sentry\\\" links next to error handling code.\"},\"createdAt\":\"2019-04-29T15:37:22Z\",\"updatedAt\":\"2020-09-29T16:07:55Z\",\"url\":\"/extensions/sourcegraph/sentry\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyMTR9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjo5MTk0\",\"username\":\"xingx-xx\",\"displayName\":\"xin.xing\",\"url\":\"/users/xingx-xx\"},\"extensionID\":\"xingx-xx/hello-world\",\"extensionIDWithoutRegistry\":\"xingx-xx/hello-world\",\"name\":\"hello-world\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"description\\\": \\\"Shows a friendly 'Hello, world!' message when you hover over code.\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^0.5.1\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.10.3\\\",\\n    \\\"sourcegraph\\\": \\\"^20.1.0\\\",\\n    \\\"typescript\\\": \\\"^3.2.1\\\"\\n  },\\n  \\\"extensionID\\\": \\\"xingx-xx/hello-world\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"sourcegraph-hello-world\\\",\\n  \\\"publisher\\\": \\\"xingx-xx\\\",\\n  \\\"readme\\\": \\\"# Example \\\\\\\"Hello, world!\\\\\\\" [Sourcegraph extension](https://docs.sourcegraph.com/extensions)\\\\n\\\\nThis example extension will be featured in an upcoming tutorial on how to write [Sourcegraph extensions](https://docs.sourcegraph.com/extensions). Stay tuned!\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"directory\\\": \\\"hello-world\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/sourcegraph/sourcegraph-extension-samples\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"serve\\\": \\\"npm run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"parcel build src/extension.ts\\\",\\n    \\\"symlink-package\\\": \\\"mkdirp dist \\\\u0026\\\\u0026 lnfs ./package.json ./dist/package.json\\\"\\n  },\\n  \\\"title\\\": \\\"Hello, world!\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/2854-xingx-xx-hello-world.js?bukvrqwchiq0--xingx-xx-hello-world\\\"\\n}\",\"description\":\"Shows a friendly 'Hello, world!' message when you hover over code.\"},\"createdAt\":\"2019-06-04T10:20:30Z\",\"updatedAt\":\"2019-06-04T10:20:30Z\",\"url\":\"/extensions/xingx-xx/hello-world\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyNDF9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/search-export\",\"extensionIDWithoutRegistry\":\"sourcegraph/search-export\",\"name\":\"search-export\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"bugs\\\": {\\n    \\\"url\\\": \\\"https://github.com/sourcegraph/sourcegraph-search-export/issues\\\"\\n  },\\n  \\\"categories\\\": [\\n    \\\"Reports and stats\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [\\n      {\\n        \\\"actionItem\\\": {\\n          \\\"description\\\": \\\"Prints to the browser devtools console\\\",\\n          \\\"label\\\": \\\"Export to CSV\\\"\\n        },\\n        \\\"category\\\": \\\"Sourcegraph\\\",\\n        \\\"command\\\": \\\"searchExport.exportSearchResultsToCSV\\\",\\n        \\\"commandArguments\\\": [\\n          \\\"${get(context, 'searchQuery')}\\\"\\n        ],\\n        \\\"id\\\": \\\"searchExport.export\\\",\\n        \\\"title\\\": \\\"Export search results\\\"\\n      }\\n    ],\\n    \\\"menus\\\": {\\n      \\\"search/results/toolbar\\\": [\\n        {\\n          \\\"action\\\": \\\"searchExport.export\\\"\\n        }\\n      ]\\n    }\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"js-base64\\\": \\\"^2.5.2\\\"\\n  },\\n  \\\"description\\\": \\\"Export search results as CSV\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/extension-api-stubs\\\": \\\"^0.2.2\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^13.3.0\\\",\\n    \\\"@types/js-base64\\\": \\\"^2.3.1\\\",\\n    \\\"@types/mocha\\\": \\\"^5.2.7\\\",\\n    \\\"@types/node\\\": \\\"^10.14.10\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^0.5.1\\\",\\n    \\\"mocha\\\": \\\"^5.2.0\\\",\\n    \\\"nyc\\\": \\\"^15.0.0\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.12.3\\\",\\n    \\\"prettier\\\": \\\"^1.18.2\\\",\\n    \\\"source-map-support\\\": \\\"^0.5.12\\\",\\n    \\\"sourcegraph\\\": \\\"^23.0.1\\\",\\n    \\\"ts-node\\\": \\\"^7.0.1\\\",\\n    \\\"tslint\\\": \\\"^5.18.0\\\",\\n    \\\"tslint-language-service\\\": \\\"^0.9.9\\\",\\n    \\\"typescript\\\": \\\"^3.5.2\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/search-export\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"search-export\\\",\\n  \\\"nyc\\\": {\\n    \\\"exclude\\\": [\\n      \\\"**/*.test.ts?(x)\\\",\\n      \\\"**/*.d.ts\\\",\\n      \\\"**/*.js\\\"\\n    ],\\n    \\\"extension\\\": [\\n      \\\".tsx\\\",\\n      \\\".ts\\\"\\n    ],\\n    \\\"include\\\": [\\n      \\\"src/**/*.ts?(x)\\\"\\n    ]\\n  },\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Sourcegraph search results CSV export extension\\\\n\\\\n[![Build Status](https://travis-ci.org/sourcegraph/sourcegraph-search-export.svg?branch=master)](https://travis-ci.org/sourcegraph/sourcegraph-search-export)\\\\n[![codecov](https://codecov.io/gh/sourcegraph/sourcegraph-search-export/branch/master/graph/badge.svg)](https://codecov.io/gh/sourcegraph/sourcegraph-search-export)\\\\n\\\\nA [Sourcegraph extension](https://docs.sourcegraph.com/extensions) to export a list of search results to CSV.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/sourcegraph-search-export)\\\\n\\\\n[**➕ Add to Sourcegraph**](https://sourcegraph.com/extensions/sourcegraph/search-export) (for self-hosted instances: visit the **Extensions** page)\\\\n\\\\n## Features\\\\n\\\\n-   Adds an **Export to CSV** button to Sourcegraph search results pages\\\\n\\\\n## Usage\\\\n\\\\n1. Add the extension at https://sourcegraph.com/extensions/sourcegraph/search-export or on the **Extensions** page of your self-hosted instance.\\\\n1. Perform a search query on Sourcegraph.\\\\n1. Press the **Export to CSV** button above the list of search results. (Note: This may take a while for large result sets. The extension is not optimized for streaming or paginating results.)\\\\n\\\\n## Development\\\\n\\\\n1. Run `yarn \\\\u0026\\\\u0026 yarn run serve` and keep the Parcel bundler process running.\\\\n1. [Sideload the extension](https://docs.sourcegraph.com/extensions/authoring/local_development) (at the URL http://localhost:1234 by default) on your Sourcegraph instance or Sourcegraph.com.\\\\n\\\\nWhen you edit a source file in your editor, Parcel will recompile the extension. Reload the Sourcegraph web page to use run the updated extension.\\\\n\\\\n## Release\\\\n\\\\nRun `src extension publish` using the [Sourcegraph `src` CLI](https://github.com/sourcegraph/src-cli).\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/sourcegraph/sourcegraph-search-export.git\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file extension.js src/extension.ts\\\",\\n    \\\"cover\\\": \\\"TS_NODE_COMPILER_OPTIONS='{\\\\\\\"module\\\\\\\":\\\\\\\"commonjs\\\\\\\"}' nyc --require ts-node/register --require source-map-support/register --all mocha --opts mocha.opts --timeout 10000\\\",\\n    \\\"prettier\\\": \\\"prettier 'src/**/*.{js?(on),ts}' --write --list-different\\\",\\n    \\\"prettier:check\\\": \\\"yarn run prettier -- --write=false\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --no-source-maps --out-file extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"mkdirp dist \\\\u0026\\\\u0026 lnfs ./package.json ./dist/package.json\\\",\\n    \\\"test\\\": \\\"TS_NODE_COMPILER_OPTIONS='{\\\\\\\"module\\\\\\\":\\\\\\\"commonjs\\\\\\\"}' mocha --require ts-node/register --require source-map-support/register --opts mocha.opts\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"tslint:fix\\\": \\\"yarn run tslint -- --fix\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:test\\\": \\\"yarn run test -- -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"tags\\\": [\\n    \\\"search\\\",\\n    \\\"results\\\",\\n    \\\"export\\\"\\n  ],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/9212-sourcegraph-search-export.js?c71j5g3s5pvs--sourcegraph-search-export\\\",\\n  \\\"version\\\": \\\"0.0.0-development\\\"\\n}\",\"description\":\"Export search results as CSV\"},\"createdAt\":\"2020-02-19T14:08:35Z\",\"updatedAt\":\"2020-02-19T14:08:35Z\",\"url\":\"/extensions/sourcegraph/search-export\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyNDR9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjoxMzM5NQ==\",\"username\":\"juliosueiras\",\"displayName\":\"Julio Sueiras\",\"url\":\"/users/juliosueiras\"},\"extensionID\":\"juliosueiras/terraform-extension\",\"extensionIDWithoutRegistry\":\"juliosueiras/terraform-extension\",\"name\":\"terraform-extension\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [],\\n    \\\"configuration\\\": {},\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [],\\n      \\\"editor/title\\\": []\\n    }\\n  },\\n  \\\"description\\\": \\\"Language extension for Terraform\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/basic-code-intel\\\": \\\"10.0.0\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^3.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^12.3.1\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^0.5.1\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.11.0\\\",\\n    \\\"sourcegraph\\\": \\\"^20.1.0\\\",\\n    \\\"tslint\\\": \\\"^5.12.0\\\",\\n    \\\"typescript\\\": \\\"^3.2.2\\\"\\n  },\\n  \\\"extensionID\\\": \\\"juliosueiras/terraform-extension\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/terraform-extension.js\\\",\\n  \\\"name\\\": \\\"terraform-extension\\\",\\n  \\\"publisher\\\": \\\"juliosueiras\\\",\\n  \\\"readme\\\": \\\"# Terraform Extension\\\\n\\\\nMinimal extension to allow usage of lsif-terraform with sourcegraph\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/juliosueiras/sourcegraph-terraform\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/terraform-extension.js src/terraform-extension.ts\\\",\\n    \\\"serve\\\": \\\"npm run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --out-file dist/terraform-extension.js src/terraform-extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run build\\\",\\n    \\\"symlink-package\\\": \\\"mkdirp dist \\\\u0026\\\\u0026 lnfs ./package.json ./dist/package.json\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"title\\\": \\\"Terraform language extension\\\",\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/3451-juliosueiras-terraform-extension.js?c0rfmlhxt4go--juliosueiras-terraform-extension\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"Language extension for Terraform\"},\"createdAt\":\"2020-02-21T00:10:30Z\",\"updatedAt\":\"2020-02-21T00:10:30Z\",\"url\":\"/extensions/juliosueiras/terraform-extension\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyNTV9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/vscode-extras\",\"extensionIDWithoutRegistry\":\"sourcegraph/vscode-extras\",\"name\":\"vscode-extras\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/main/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Code editors\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [\\n      {\\n        \\\"actionItem\\\": {\\n          \\\"description\\\": \\\"Open file in VS Code\\\",\\n          \\\"iconURL\\\": \\\"https://upload.wikimedia.org/wikipedia/commons/9/9a/Visual_Studio_Code_1.35_icon.svg\\\"\\n        },\\n        \\\"category\\\": \\\"VS Code\\\",\\n        \\\"command\\\": \\\"vscode.open.file\\\",\\n        \\\"commandArguments\\\": [\\n          \\\"${resource.uri}\\\"\\n        ],\\n        \\\"id\\\": \\\"vscode.open.file\\\",\\n        \\\"title\\\": \\\"Open file in VS Code\\\"\\n      }\\n    ],\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"vscode.open.basePath\\\": {\\n          \\\"description\\\": \\\"The file path on the machine to the folder that is expected to contain all repositories.\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        }\\n      }\\n    },\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [\\n        {\\n          \\\"action\\\": \\\"vscode.open.file\\\",\\n          \\\"when\\\": \\\"resource\\\"\\n        }\\n      ],\\n      \\\"editor/title\\\": [\\n        {\\n          \\\"action\\\": \\\"vscode.open.file\\\",\\n          \\\"when\\\": \\\"resource\\\"\\n        }\\n      ]\\n    }\\n  },\\n  \\\"dependencies\\\": {},\\n  \\\"description\\\": \\\"Integrates Sourcegraph with your local VS Code\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/eslint-config\\\": \\\"^0.16.0\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^4.0.1\\\",\\n    \\\"@types/node\\\": \\\"^13.13.2\\\",\\n    \\\"eslint\\\": \\\"^6.8.0\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^1.0.4\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.12.4\\\",\\n    \\\"sourcegraph\\\": \\\"^24.1.0\\\",\\n    \\\"typescript\\\": \\\"^3.8.3\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/vscode-extras\\\",\\n  \\\"icon\\\": \\\"data:image/svg+xml;base64,\\\",\\n  \\\"license\\\": \\\"Apache-2.0\\\",\\n  \\\"main\\\": \\\"dist/vscode-extras.js\\\",\\n  \\\"name\\\": \\\"vscode-extras\\\",\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# VS Code Sourcegraph extension\\\\n\\\\nIntegrates Sourcegraph with your local VS Code.\\\\n\\\\n![image](https://user-images.githubusercontent.com/10532611/79975469-550e0180-849b-11ea-83cb-54e9e25225d6.png)\\\\n\\\\n## Configuration\\\\n\\\\nSet `vscode.open.basePath` in your user settings to a local folder that contains your Git repositories.\\\\nThe extension will try to open the file in a clone named by the last segment of the repository name in that folder.\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/sourcegraph/sourcegraph-vscode-extras\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/vscode-extras.js src/vscode-extras.ts\\\",\\n    \\\"eslint\\\": \\\"eslint 'src/**/*.ts'\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --out-file dist/vscode-extras.