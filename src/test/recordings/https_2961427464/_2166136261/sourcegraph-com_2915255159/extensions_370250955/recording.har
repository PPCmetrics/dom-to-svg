\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyMjh9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/automation-preview\",\"extensionIDWithoutRegistry\":\"sourcegraph/automation-preview\",\"name\":\"automation-preview\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"contributes\\\": {},\\n  \\\"description\\\": \\\"Campaign automation for dependency upgrades, npm credential leaks, etc.\\\",\\n  \\\"eslintConfig\\\": {\\n    \\\"extends\\\": \\\"../../../.eslintrc.js\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/automation-preview\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"automation-preview\\\",\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Automation preview\\\\n\\\\nThis extension provides automation campaigns for dependency upgrades, npm credentials leaks, etc.\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"dir\\\": \\\"extensions/enterprise/sandbox\\\",\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/sourcegraph/sourcegraph\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"../../../node_modules/.bin/parcel build --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"serve\\\": \\\"../../../node_modules/.bin/parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run build\\\",\\n    \\\"test\\\": \\\"jest\\\",\\n    \\\"tslint\\\": \\\"../../../node_modules/.bin/tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"../../../node_modules/.bin/tsc -p tsco