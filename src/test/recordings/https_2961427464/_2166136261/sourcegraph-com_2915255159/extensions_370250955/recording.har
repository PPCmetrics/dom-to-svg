se},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyNzV9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjoyMzg0OA==\",\"username\":\"bountyplz\",\"displayName\":null,\"url\":\"/users/bountyplz\"},\"extensionID\":\"bountyplz/hh.hh.haaa\",\"extensionIDWithoutRegistry\":\"bountyplz/hh.hh.haaa\",\"name\":\"hh.hh.haaa\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/7856-bountyplz-hh-hh-haaa.js?c4qjmno3fr6o--bountyplz-hh-hh-haaa\\\"\\n}\",\"description\":null},\"createdAt\":\"2020-08-07T05:51:24Z\",\"updatedAt\":\"2020-08-07T06:29:58Z\",\"url\":\"/extensions/bountyplz/hh.hh.haaa\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyNzZ9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/open-in-editor\",\"extensionIDWithoutRegistry\":\"sourcegraph/open-in-editor\",\"name\":\"open-in-editor\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/main/client/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"Code editors\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [\\n      {\\n        \\\"actionItem\\\": {\\n          \\\"description\\\": \\\"Open file in editor\\\",\\n          \\\"iconURL\\\": \\\"data:image/svg+xml;base64,\\\"\\n        },\\n        \\\"category\\\": \\\"Open in editor\\\",\\n        \\\"command\\\": \\\"openineditor.open.file\\\",\\n        \\\"commandArguments\\\": [\\n          \\\"${resource.uri}\\\"\\n        ],\\n        \\\"id\\\": \\\"openineditor.open.file\\\",\\n        \\\"title\\\": \\\"Open file in editor\\\"\\n      }\\n    ],\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"openineditor.basePath\\\": {\\n          \\\"description\\\": \\\"The file path on the machine to the folder that is expected to contain all repositories.\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        },\\n        \\\"openineditor.customUrlPattern\\\": {\\n          \\\"description\\\": \\\"The custom URL pattern for your editor of choice. Use placeholders %file, %line, %col.\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        },\\n        \\\"openineditor.editor\\\": {\\n          \\\"description\\\": \\\"Editor config to use. Supported: 'vscode', 'idea', 'sublime', 'custom'. If 'custom', also set 'openindeditor.customUrlPattern'\\\",\\n          \\\"enum\\\": [\\n            \\\"vscode\\\",\\n            \\\"idea\\\",\\n            \\\"sublime\\\",\\n            \\\"custom\\\"\\n          ],\\n          \\\"type\\\": \\\"string\\\"\\n        }\\n      }\\n    },\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [\\n        {\\n          \\\"action\\\": \\\"openineditor.open.file\\\",\\n          \\\"when\\\": \\\"resource\\\"\\n        }\\n      ],\\n      \\\"editor/title\\\": [\\n        {\\n          \\\"action\\\": \\\"openineditor.open.file\\\",\\n          \\\"when\\\": \\\"resource\\\"\\n        }\\n      ]\\n    }\\n  },\\n  \\\"description\\\": \\\"Open the current file in your editor of choice\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/eslint-config\\\": \\\"^0.20.0\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^4.0.1\\\",\\n    \\\"@types/node\\\": \\\"14.0.27\\\",\\n    \\\"eslint\\\": \\\"^7.6.0\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^1.0.4\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.12.4\\\",\\n    \\\"sourcegraph\\\": \\\"^24.7.0\\\",\\n    \\\"typescript\\\": \\\"^3.9.7\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/open-in-editor\\\",\\n  \\\"icon\\\": \\\"data:image/svg+xml;base64,\\\",\\n  \\\"license\\\": \\\"Apache-2.0\\\",\\n  \\\"main\\\": \\\"dist/open-in-editor.js\\\",\\n  \\\"name\\\": \\\"open-in-editor\\\",\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# open-in-editor (Sourcegraph extension)\\\\n\\\\nAdds a button at the top of files in both Sourcegraph app and code hosts like GitHub (when the Sourcegraph browser extension is installed) that will open the current file in your editor of choice. \\\\n\\\\n![Screenshot](https://user-images.githubusercontent.com/6304497/94799074-dcfd1d80-03e2-11eb-86fc-e55e03380154.png)\\\\n\\\\n## Settings\\\\n\\\\n- Add `openineditor.editor` to your user settings to open files in the editor. Copy one of the following lines depending on the editor you would like to use. This extension only supports opening in one editor at a time. Supported editors:\\\\n  - `vscode` (Visual Studio Code): `\\\\\\\"openineditor.editor\\\\\\\": \\\\\\\"vscode\\\\\\\"`\\\\n  - `idea` (JetBrains IntelliJ IDEA): `\\\\\\\"openineditor.editor\\\\\\\": \\\\\\\"idea\\\\\\\"`\\\\n  - `sublime` (Sublime Text, requires a URL handler installed such as [this one for macOS](https://github.com/inopinatus/sublime_url))\\\\n  - `custom` (requires also setting `openineditor.customUrlPattern`): `\\\\\\\"openineditor.editor\\\\\\\": \\\\\\\"custom\\\\\\\"`\\\\n- `openineditor.basePath`: The absolute path on your computer where your git repositories live. This extension requires all git repos to be already cloned under this path with their original names. `\\\\\\\"/Users/yourusername/src\\\\\\\"` is a valid absolute path, while `\\\\\\\"~/src\\\\\\\"` is not.\\\\n- `openineditor.customUrlPattern`: If you set `openineditor.editor` to `custom`, this must be set. Use placeholders `%file`, `%line`, and `%col` to mark where the file path, line number, and column number must be replaced. Example URL for IntelliJ IDEA: `idea://open?file=%file\\\\u0026line=%line\\\\u0026column=%col`\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/sourcegraph/open-in-editor-extension\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/open-in-editor.js src/open-in-editor.ts\\\",\\n    \\\"eslint\\\": \\\"eslint 'src/**/*.ts'\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --out-file dist/open-in-editor.js src/open-in-editor.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run typecheck \\\\u0026\\\\u0026 yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"mkdirp dist \\\\u0026\\\\u0026 lnfs ./package.json ./dist/package.json\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"tags\\\": [\\n    \\\"vscode\\\",\\n    \\\"intellij\\\",\\n    \\\"idea\\\",\\n    \\\"jetbrains\\\",\\n    \\\"sublime\\\",\\n    \\\"editor\\\",\\n    \\\"open\\\"\\n  ],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/8826-sourcegraph-open-in-editor.js?c6huemu9jdoo--sourcegraph-open-in-editor\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\",\\n  \\\"wip\\\": false\\n}\",\"description\":\"Open the current file in your editor of choice\"},\"createdAt\":\"2020-08-07T21:03:48Z\",\"updatedAt\":\"2020-08-07T21:03:48Z\",\"url\":\"/extensions/sourcegraph/open-in-editor\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyNzd9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjoyMzkxMA==\",\"username\":\"gabbieian38\",\"displayName\":null,\"url\":\"/users/gabbieian38\"},\"extensionID\":\"gabbieian38/new\",\"extensionIDWithoutRegistry\":\"gabbieian38/new\",\"name\":\"new\"