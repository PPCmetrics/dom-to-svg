' fill='%23F2F8F6'/%3E%3Cpath d='M119 129a9 9 0 1019 0 9 9 0 00-19 0' fill='%23F1F8F3'/%3E%3C/svg%3E\\\"\\n        },\\n        \\\"category\\\": \\\"Open in atom\\\",\\n        \\\"command\\\": \\\"openInAtom.open.file\\\",\\n        \\\"commandArguments\\\": [\\n          \\\"${resource.uri}\\\"\\n        ],\\n        \\\"id\\\": \\\"openInAtom.open.file\\\",\\n        \\\"title\\\": \\\"Open file in Atom\\\"\\n      }\\n    ],\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"openInAtom.basePath\\\": {\\n          \\\"description\\\": \\\"The absolute path on the machine to the folder that is expected to contain all repositories.\\\",\\n          \\\"format\\\": \\\"regex\\\",\\n          \\\"pattern\\\": \\\"^[^~]+\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        }\\n      }\\n    },\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [\\n        {\\n          \\\"action\\\": \\\"openInAtom.open.file\\\",\\n          \\\"when\\\": \\\"resource.type === 'textDocument'\\\"\\n        }\\n      ],\\n      \\\"editor/title\\\": [\\n        {\\n          \\\"action\\\": \\\"openInAtom.open.file\\\",\\n          \\\"when\\\": \\\"resource.type === 'textDocument'\\\"\\n        }\\n      ]\\n    }\\n  },\\n  \\\"description\\\": \\\"Open the current file in the Atom editor\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/eslint-config\\\": \\\"^0.20.0\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^4.0.1\\\",\\n    \\\"@types/node\\\": \\\"14.0.27\\\",\\n    \\\"eslint\\\": \\\"^7.6.0\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^1.0.4\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.12.4\\\",\\n    \\\"sourcegraph\\\": \\\"^24.7.0\\\",\\n    \\\"typescript\\\": \\\"^3.9.7\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/open-in-atom\\\",\\n  \\\"icon\\\": \\\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg' preserveAspectRatio='xMidYMid'%3E%3Cdefs/%3E%3Cdefs%3E%3ClinearGradient x1='50%25' y1='4%25' x2='50%25' y2='100%25' id='a'%3E%3Cstop stop-color='%23FDFDFD' offset='0%25'/%3E%3Cstop stop-color='%23CBCBCB' offset='100%25'/%3E%3C/linearGradient%3E%3ClinearGradient x1='50%25' y1='4%25' x2='50%25' y2='100%25' id='b'%3E%3Cstop stop-color='%23B2E198' offset='0%25'/%3E%3Cstop stop-color='%2304A171' offset='100%25'/%3E%3C/linearGradient%3E%3C/defs%3E%3Ccircle fill='url(%23a)' cx='128' cy='128' r='127.9'/%3E%3Ccircle fill='url(%23b)' cx='127.9' cy='128.1' r='116.9'/%3E%3Cpath d='M100 110l-4 6-3-11 12-1-5 6zm104 8c-5-4-10-8-18-11a172 172 0 00-64-12c17-20 32-30 41-30l5 1c5 3 6 11 4 23a4 4 0 008 2c4-20-2-29-7-32-3-2-6-3-10-3-14 1-34 16-52 39l-20 2-2-10c-2-13 0-23 5-25l3-1c4 0 11 3 18 9a4 4 0 005-7c-9-7-17-11-24-10l-5 1c-5 3-8 7-10 14v20l1 10-14 4c-18 7-22 16-22 22-1 6 2 14 18 23a4 4 0 004-8c-9-5-14-10-14-15 0-6 11-13 30-17l7 19c-7 13-12 25-14 36-2 8-3 15-2 21 1 7 4 11 8 14 2 2 5 3 9 3 6 0 13-3 23-10a4 4 0 10-5-7c-9 7-18 10-22 7-5-3-6-13-3-26l10-28 4 7c9 19 21 36 33 47 6 5 12 9 17 11 3 2 6 2 9 2l7-1c5-3 8-7 10-13l1-20c-2-15-8-33-16-51a4 4 0 00-8 3c8 18 14 35 15 49 1 13-1 22-5 24-5 3-14-1-24-11a163 163 0 01-38-56 211 211 0 0115-24 199 199 0 0168 12c12 5 19 11 19 17 0 5-6 9-16 13a4 4 0 003 8c17-6 21-15 21-21 1-5-2-10-6-14z' fill='%23F2F8F6'/%3E%3Cpath d='M119 129a9 9 0 1019 0 9 9 0 00-19 0' fill='%23F1F8F3'/%3E%3C/svg%3E\\\",\\n  \\\"license\\\": \\\"Apache-2.0\\\",\\n  \\\"main\\\": \\\"dist/open-in-atom.js\\\",\\n  \\\"name\\\": \\\"open-in-atom\\\",\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Open in Atom Sourcegraph extension\\\\n\\\\nAdds a button at the top of files in both Sourcegraph app and code hosts like GitHub (when the Sourcegraph browser extension is installed) that will open the current file in Atom. \\\\n\\\\n\\\\u003cpicture\\\\u003e\\\\n\\\\u003csource srcset=\\\\\\\"https://user-images.githubusercontent.com/37420160/96530024-856d0780-1254-11eb-968c-624aff1fd2e5.png\\\\\\\" media=\\\\\\\"(prefers-color-scheme: dark)\\\\\\\" /\\\\u003e\\\\n\\\\u003csource srcset=\\\\\\\"https://user-images.githubusercontent.com/37420160/96607497-6b6c0d00-12c6-11eb-921b-6ac6af8e90eb.png\\\\\\\" media=\\\\\\\"(prefers-color-scheme: light)\\\\\\\" /\\\\u003e\\\\n\\\\u003cimg src=\\\\\\\"https://user-images.githubusercontent.com/37420160/96607497-6b6c0d00-12c6-11eb-921b-6ac6af8e90eb.png\\\\\\\" alt=\\\\\\\"Screenshot\\\\\\\" /\\\\u003e\\\\n\\\\u003c/picture\\\\u003e\\\\n\\\\n## Settings\\\\n\\\\n- `openInAtom.basePath`: The absolute path on your computer where your git repositories live. This extension requires all git repos to be already cloned under this path with their original names. `\\\\\\\"/Users/yourusername/src\\\\\\\"` is a valid absolute path, while `\\\\\\\"~/src\\\\\\\"` is not.\\\\n\\\\nIf you're using Atom on Linux, you should [configure URI handling yourself](https://flight-manual.atom.io/hacking-atom/sections/handling-uris/#linux-support).\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/sourcegraph/sourcegraph-open-in-atom\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/open-in-atom.js src/open-in-atom.ts\\\",\\n    \\\"eslint\\\": \\\"eslint 'src/**/*.ts'\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --out-file dist/open-in-atom.js src/open-in-atom.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run typecheck \\\\u0026\\\\u0026 yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"mkdirp dist \\\\u0026\\\\u0026 lnfs ./package.json ./dist/package.json\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"tags\\\": [\\n    \\\"atom\\\",\\n    \\\"editor\\\",\\n    \\\"open\\\"\\n  ],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/8879-sourcegraph-o