02Z\",\"url\":\"/extensions/wang982222kun/Sourcegraph\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxNzB9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjo1Mjkw\",\"username\":\"skaapgif\",\"displayName\":\"Rudolf Meijering\",\"url\":\"/users/skaapgif\"},\"extensionID\":\"skaapgif/detect-secret-keys\",\"extensionIDWithoutRegistry\":\"skaapgif/detect-secret-keys\",\"name\":\"detect-secret-keys\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [],\\n    \\\"configuration\\\": {},\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [],\\n      \\\"editor/title\\\": []\\n    }\\n  },\\n  \\\"dependencies\\\": {},\\n  \\\"description\\\": \\\"Highlights secret keys in your codebase\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^3.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^12.3.1\\\",\\n    \\\"@types/tape\\\": \\\"^4.2.33\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^0.5.1\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.11.0\\\",\\n    \\\"sourcegraph\\\": \\\"^20.1.0\\\",\\n    \\\"tap-spec\\\": \\\"^5.0.0\\\",\\n    \\\"tape\\\": \\\"^4.9.2\\\",\\n    \\\"ts-node\\\": \\\"^8.0.2\\\",\\n    \\\"tslint\\\": \\\"^5.12.1\\\",\\n    \\\"typescript\\\": \\\"^3.2.4\\\"\\n  },\\n  \\\"extensionID\\\": \\\"skaapgif/detect-secret-keys\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/detect-secret-keys.js\\\",\\n  \\\"name\\\": \\\"detect-secret-keys\\\",\\n  \\\"publisher\\\": \\\"skaapgif\\\",\\n  \\\"readme\\\": \\\"# detect-secret-keys (Sourcegraph extension)\\\\n\\\\nHighlights secrets in your codebase.\\\\n\\\",\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/detect-secret-keys.js src/detect-secret-keys.ts\\\",\\n    \\\"serve\\\": \\\"npm run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --out-file dist/detect-secret-keys.js src/detect-secret-keys.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run build\\\",\\n    \\\"symlink-package\\\": \\\"mkdirp dist \\\\u0026\\\\u0026 lnfs ./package.json ./dist/package.json\\\",\\n    \\\"test\\\": \\\"ts-node $(npm bin)/tape tests/**/*.test.ts | tap-spec; echo ''\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"tags\\\": [],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/2118-skaapgif-detect-secret-keys.js?brjiu2lso60o--skaapgif-detect-secret-keys\\\",\\n  \\\"version\\\": \\\"0.0.1-DEVELOPMENT\\\",\\n  \\\"wip\\\": true\\n}\",\"description\":\"Highlights secret keys in your codebase\"},\"createdAt\":\"2019-01-26T21:23:15Z\",\"updatedAt\":\"2019-01-26T21:23:15Z\",\"url\":\"/extensions/skaapgif/detect-secret-keys\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxOTJ9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjo1MzU4\",\"username\":\"innnzzz6\",\"displayName\":null,\"url\":\"/users/innnzzz6\"},\"extensionID\":\"innnzzz6/innnzzz6\",\"extensionIDWithoutRegistry\":\"innnzzz6/innnzzz6\",\"name\":\"innnzzz6\",\"manifest\":null,\"createdAt\":\"2019-01-30T08:41:07Z\",\"updatedAt\":\"2019-01-30T08:41:07Z\",\"url\":\"/extensions/innnzzz6/innnzzz6\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxOTR9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjo1NzY3\",\"username\":\"xinsfang\",\"displayName\":null,\"url\":\"/users/xinsfang\"},\"extensionID\":\"xinsfang/cpp\",\"extensionIDWithoutRegistry\":\"xinsfang/cpp\",\"name\":\"cpp\",\"manifest\":null,\"createdAt\":\"2019-02-01T09:08:40Z\",\"updatedAt\":\"2019-02-01T09:12:40Z\",\"url\":\"/extensions/xinsfang/cpp\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxOTV9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/code-usage-stats\",\"extensionIDWithoutRegistry\":\"sourcegraph/code-usage-stats\",\"name\":\"code-usage-stats\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"codeUsageStats.repositoryQuery\\\": {\\n          \\\"default\\\": null,\\n          \\\"description\\\": \\\"Include these repositories (matched by regexp on repository name) when computing usage stats. By default, only the current repository is included.\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        }\\n      },\\n      \\\"title\\\": \\\"Code usage stats configuration\\\",\\n      \\\"type\\\": \\\"object\\\"\\n    }\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"date-fns\\\": \\\"^2.0.0-alpha.27\\\"\\n  },\\n  \\\"description\\\": \\\"See library and API usage trends over time, in your own code\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/prettierrc\\\": \\\"^2.2.0\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^4.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^12.3.1\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.11.0\\\",\\n    \\\"sourcegraph\\\": \\\"^22.0.0\\\",\\n    \\\"tslint\\\": \\\"^5.12.1\\\",\\n    \\\"typescript\\\": \\\"^3.3.3333\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/code-usage-stats\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"code-usage-stats\\\",\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Code usage stats\\\\n\\\\nSee library and API usage trends over time, in your own code.\\\\n\\\",\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"serve\\\": \\\"parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run build\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/2566-sourcegraph-code-usage-stats.js?bsakfff439iw--sourcegraph-code-usage-stats\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\",\\n  \\\"wip\\\": true\\n}\",\"description\":\"See library and API usage trends over time, in your own code\"},\"createdAt\":\"2019-02-22T16:34:19Z\",\"updatedAt\":\"2019-02-22T16:34:19Z\",\"url\":\"/extensions/sourcegraph/code-usage-stats\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoxOTd9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjo2NjUy\",\"username\":\"DizzyNDL\",\"displayName\":\"P.T. Koehler\",\"url\":\"/users/DizzyNDL\"},\"extensionID\":\"DizzyNDL/chamber\",\"extensionIDWithoutRegistry\":\"DizzyNDL/chamber\",\"name\":\"chamber\",\"manifest\":null,\"createdAt\":\"2019-03-03T21:01:21Z\",\"updatedAt\":\"2019-03-03T21:01:21Z\",\"url\":\"/extensions/DizzyNDL/chamber\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyMDV9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/hubspot\",\"extensionIDWithoutRegistry\":\"sourcegraph/hubspot\",\"name\":\"hubspot\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"External services\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"hubspot.apiKey\\\": {\\n          \\\"description\\\": \\\"HubSpot API key (HubSpot user menu \\\\u003e Integrations \\\\u003e Integrations \\\\u003e API key)\\\",\\n          \\\"examples\\\": [\\n            \\\"aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa\\\"\\n          ],\\n          \\\"type\\\": \\\"string\\\"\\n        }\\n      },\\n      \\\"required\\\": [\\n        \\\"hubspot.apiKey\\\"\\n      ],\\n      \\\"title\\\": \\\"HubSpot configuration\\\",\\n      \\\"type\\\": \\\"object\\\"\\n    }\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"localforage\\\": \\\"^1.7.3\\\",\\n    \\\"lodash\\\": \\\"^4.17.11\\\",\\n    \\\"rxjs\\\": \\\"^6.4.0\\\"\\n  },\\n  \\\"description\\\": \\\"HubSpot link previews and customer autocompletion (by name) on GitHub\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/prettierrc\\\": \\\"^2.2.0\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^4.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^13.0.0\\\",\\n    \\\"@types/lodash\\\": \\\"^4.14.123\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.11.0\\\",\\n    \\\"sourcegraph\\\": \\\"^24.7.0\\\",\\n    \\\"tslint\\\": \\\"^5.15.0\\\",\\n    \\\"typescript\\\": \\\"^3.4.2\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/hubspot\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"hubspot\\\",\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# HubSpot extension for Sourcegraph\\\\n\\\\nA [Sourcegraph extension](https://docs.sourcegraph.com/extensions) that enhances GitHub with better [HubSpot](https://www.hubspot.com) integration.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/sourcegraph-hubspot)\\\\n\\\\n[**➕ Add to Sourcegraph**](https://sourcegraph.com/extensions/sourcegraph/hubspot)\\\\n\\\\n**Status:** beta\\\\n\\\\n## Usage\\\\n\\\\nThis extension currently only works on GitHub (and GitHub Enterprise), not on Sourcegraph or other code hosts.\\\\n\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - In the Sourcegraph browser extension options menu, click the gear (⚙️) and enable **Experimental link previews** and **Experimental text field completion**.\\\\n1. [Enable the HubSpot extension](https://sourcegraph.com/extensions/sourcegraph/hubspot) in the Sourcegraph extension registry (requires sign-in to Sourcegraph).\\\\n1. Configure the HubSpot extension in [Sourcegraph user settings](https://sourcegraph.com/user/settings): `hubspot.apiKey`.\\\\n1. Visit any text area, comment, PR, or issue on GitHub and try the [features](#features) below.\\\\n\\\\nIf using GitHub Enterprise, right-click on the Sourcegraph browser extension icon when you're on a GitHub Enterprise page and select **Enable Sourcegraph on this domain**.\\\\n\\\\n## Features\\\\n\\\\n### Autocompletion of HubSpot company names\\\\n\\\\nJust start typing the name of a customer in your HubSpot contacts (like `Acme Corporation`) to complete it! Select a company to insert its HubSpot URL into the text area. It works just like GitHub's built-in autocompletion for issues, PRs, and users.\\\\n\\\\nThis makes it easy to denote which customers care about a specific issue. (If your repository is public, no fear: HubSpot company URLs don't contain the company's name, so your customer names won't be exposed.)\\\\n\\\\n![HubSpot company autocompletion](https://storage.googleapis.com/sourcegraph-assets/extensions/sourcegraph/hubspot/hubspot-autocomplete.png)\\\\n\\\\n### Link previews for HubSpot company URLs\\\\n\\\\nFor any HubSpot company link that appears on GitHub (in a comment, issue, PR, or rendered Markdown file), you'll see a preview with the company name and other stats (such as number of employees, location, etc.).\\\\n\\\\nThis makes it easy to see which customers care about a specific issue. The emoji link lets you see all _other issues_ that the same company is mentioned in, which is also very useful (to answer \\\\\\\"what are all the issues a specific customer cares about?\\\\\\\").\\\\n\\\\n![HubSpot company link previews](https://storage.googleapis.com/sourcegraph-assets/extensions/sourcegraph/hubspot/hubspot-linkpreview.png)\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/sourcegraph/sourcegraph-hubspot\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"serve\\\": \\\"parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run build\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/8621-sourcegraph-hubspot.js?c5v1zwbzkdfk--sourcegraph-hubspot\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\",\\n  \\\"wip\\\": true\\n}\",\"description\":\"HubSpot link previews and customer autocompletion (by name) on GitHub\"},\"createdAt\":\"2019-04-15T23:48:11Z\",\"updatedAt\":\"2019-04-15T23:48:11Z\",\"url\":\"/extensions/sourcegraph/hubspot\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyMDZ9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/jira\",\"extensionIDWithoutRegistry\":\"sourcegraph/jira\",\"name\":\"jira\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"External services\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"jira.apiToken\\\": {\\n          \\\"description\\\": \\\"Jira API token\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        },\\n        \\\"jira.url\\\": {\\n          \\\"description\\\": \\\"Jira URL\\\",\\n          \\\"examples\\\": [\\n            \\\"https://example.atlassian.net\\\"\\n          ],\\n          \\\"format\\\": \\\"uri\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        },\\n        \\\"jira.username\\\": {\\n          \\\"description\\\": \\\"Jira username\\\",\\n          \\\"examples\\\": [\\n            \\\"alice@example.com\\\"\\n          ],\\n          \\\"format\\\": \\\"email\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        }\\n      },\\n      \\\"required\\\": [\\n        \\\"jira.url\\\",\\n        \\\"jira.username\\\",\\n        \\\"jira.apiToken\\\"\\n      ],\\n      \\\"title\\\": \\\"Atlassian Jira configuration\\\",\\n      \\\"type\\\": \\\"object\\\"\\n    }\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"escape-html\\\": \\\"^1.0.3\\\",\\n    \\\"lodash\\\": \\\"^4.17.11\\\",\\n    \\\"rxjs\\\": \\\"^6.4.0\\\"\\n  },\\n  \\\"description\\\": \\\"Jira issue link previews and issue autocompletion on GitHub\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/prettierrc\\\": \\\"^2.2.0\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^4.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^13.0.0\\\",\\n    \\\"@types/escape-html\\\": \\\"^0.0.20\\\",\\n    \\\"@types/lodash\\\": \\\"^4.14.123\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.11.0\\\",\\n    \\\"sourcegraph\\\": \\\"^24.7.0\\\",\\n    \\\"tslint\\\": \\\"^5.15.0\\\",\\n    \\\"typescript\\\": \\\"^3.4.2\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/jira\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/extension.js\\\",\\n  \\\"name\\\": \\\"jira\\\",\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Jira extension for Sourcegraph\\\\n\\\\nA [Sourcegraph extension](https://docs.sourcegraph.com/extensions) that enhances GitHub with better [Atlassian Jira](https://www.atlassian.com/software/jira) integration.\\\\n\\\\n[**🗃️ Source code**](https://github.com/sourcegraph/sourcegraph-jira)\\\\n\\\\n[**➕ Add to Sourcegraph**](https://sourcegraph.com/extensions/sourcegraph/jira)\\\\n\\\\n**Status:** beta\\\\n\\\\n## Usage\\\\n\\\\nThis extension currently only works on GitHub (and GitHub Enterprise), not on Sourcegraph or other code hosts.\\\\n\\\\n1. Install the [Sourcegraph browser extension](https://docs.sourcegraph.com/integration/browser_extension).\\\\n   - In the Sourcegraph browser extension options menu, click the gear (⚙️) and enable **Experimental link previews** and **Experimental text field completion**.\\\\n1. [Enable the Jira extension](https://sourcegraph.com/extensions/sourcegraph/jira) in the Sourcegraph extension registry (requires sign-in to Sourcegraph).\\\\n1. Configure the Jira extension in [Sourcegraph user settings](https://sourcegraph.com/user/settings): `jira.apiToken`, `jira.url`, and `jira.username`.\\\\n1. Visit any text area, comment, PR, or issue on GitHub and try the [features](#features) below.\\\\n\\\\nIf using GitHub Enterprise, right-click on the Sourcegraph browser extension icon when you're on a GitHub Enterprise page and select **Enable Sourcegraph on this domain**.\\\\n\\\\n## Features\\\\n\\\\n### Autocompletion of Jira issues\\\\n\\\\nJust start typing a Jira issue key (like `DEMO-123`) to complete it! You can type the issue number or words that appear in the issue summary. Select an issue to insert its URL into the text area. It works just like GitHub's built-in autocompletion for issues, PRs, and users.\\\\n\\\\n![Jira issue autocompletion](https://storage.googleapis.com/sourcegraph-assets/extensions/sourcegraph/jira/jira-autocomplete.png)\\\\n\\\\n### Link previews for Jira issue links\\\\n\\\\nFor any Jira issue link that appears on GitHub (in a comment, issue, PR, or rendered Markdown file), you'll see a preview with the title and status.\\\\n\\\\n![Jira issue link previews](https://storage.googleapis.com/sourcegraph-assets/extensions/sourcegraph/jira/jira-linkpreview.png)\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/sourcegraph/sourcegraph-jira\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"serve\\\": \\\"parcel serve --no-hmr --out-file dist/extension.js src/extension.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run build\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/8622-sourcegraph-jira.js?c5v241ttwnx4--sourcegraph-jira\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\",\\n  \\\"wip\\\": true\\n}\",\"description\":\"Jira issue link previews and issue autocompletion on GitHub\"},\"createdAt\":\"2019-04-15T23:48:18Z\",\"updatedAt\":\"2019-04-15T23:48:18Z\",\"url\":\"/extensions/sourcegraph/jira\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyMTF9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjo4OTIy\",\"username\":\"hgsopen\",\"displayName\":\"CSRF POC\",\"url\":\"/users/hgsopen\"},\"extensionID\":\"hgsopen/sss\",\"extensionIDWithoutRegistry\":\"hgsopen/sss\",\"name\":\"sss\",\"manifest\":null,\"createdAt\":\"2019-05-07T12:13:31Z\",\"updatedAt\":\"2019-05-07T12:13:31Z\",\"url\":\"/extensions/hgsopen/sss\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyMTJ9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjo5MDUy\",\"username\":\"knbz\",\"displayName\":\"Ivaylo Temelkov \",\"url\":\"/users/knbz\"},\"extensionID\":\"knbz/KoreNbeatZ\",\"extensionIDWithoutRegistry\":\"knbz/KoreNbeatZ\",\"name\":\"KoreNbeatZ\",\"manifest\":null,\"createdAt\":\"2019-05-12T06:43:32Z\",\"updatedAt\":\"2019-05-12T07:09:12Z\",\"url\":\"/extensions/knbz/KoreNbeatZ\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyMTN9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjo0ODgx\",\"username\":\"lst9391\",\"displayName\":null,\"url\":\"/users/lst9391\"},\"extensionID\":\"lst9391/highlight_words\",\"extensionIDWithoutRegistry\":\"lst9391/highlight_words\",\"name\":\"highlight_words\",\"manifest\":null,\"createdAt\":\"2019-05-19T03:13:12Z\",\"updatedAt\":\"2019-05-20T08:06:02Z\",\"url\":\"/extensions/lst9391/highlight_words\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyMTV9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjo5ODE2\",\"username\":\"dhani91\",\"displayName\":null,\"url\":\"/users/dhani91\"},\"extensionID\":\"dhani91/t\",\"extensionIDWithoutRegistry\":\"dhani91/t\",\"name\":\"t\",\"manifest\":null,\"createdAt\":\"2019-06-09T22:17:22Z\",\"updatedAt\":\"2019-06-09T22:17:22Z\",\"url\":\"/extensions/dhani91/t\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyMTZ9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjo0MzU3\",\"username\":\"yevbar\",\"displayName\":\"Yev Barkalov\",\"url\":\"/users/yevbar\"},\"extensionID\":\"yevbar/launchdarkly\",\"extensionIDWithoutRegistry\":\"yevbar/launchdarkly\",\"name\":\"launchdarkly\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [],\\n    \\\"configuration\\\": {},\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [],\\n      \\\"editor/title\\\": []\\n    }\\n  },\\n  \\\"description\\\": \\\"Tells you about the feature flags you're using!\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^4.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^13.2.0\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^0.5.1\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.12.3\\\",\\n    \\\"sourcegraph\\\": \\\"^23.0.1\\\",\\n    \\\"tslint\\\": \\\"^5.17.0\\\",\\n    \\\"typescript\\\": \\\"^3.5.1\\\"\\n  },\\n  \\\"extensionID\\\": \\\"yevbar/launchdarkly\\\",\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/launchdarkly.js\\\",\\n  \\\"name\\\": \\\"launchdarkly\\\",\\n  \\\"publisher\\\": \\\"yevbar\\\",\\n  \\\"readme\\\": \\\"# launchdarkly (Sourcegraph extension)\\\\n\\\\nTells you about the feature flags you're using!.\\\\n\\\",\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/launchdarkly.js src/launchdarkly.ts\\\",\\n    \\\"serve\\\": \\\"npm run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --out-file dist/launchdarkly.js src/launchdarkly.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run typecheck \\\\u0026\\\\u0026 npm run build\\\",\\n    \\\"symlink-package\\\": \\\"mkdirp dist \\\\u0026\\\\u0026 lnfs ./package.json ./dist/package.json\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"tags\\\": [],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/2869-yevbar-launchdarkly.js?burb0s0xo7bs--yevbar-launchdarkly\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\",\\n  \\\"wip\\\": true\\n}\",\"description\":\"Tells you about the feature flags you're using!\"},\"createdAt\":\"2019-06-11T21:33:40Z\",\"updatedAt\":\"2019-06-11T21:33:40Z\",\"url\":\"/extensions/yevbar/launchdarkly\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":true,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyMTd9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/pull-request\",\"extensionIDWithoutRegistry\":\"sourcegraph/pull-request\",\"name\":\"pull-request\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/master/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [\\n      {\\n        \\\"actionItem\\\": {\\n          \\\"description\\\": \\\"Issue a Pull Request\\\",\\n          \\\"label\\\": \\\"Pull Request\\\"\\n        },\\n        \\\"command\\\": \\\"pr.issuePullRequest\\\",\\n        \\\"id\\\": \\\"pr.issuePullRequest\\\"\\n      }\\n    ],\\n    \\\"configuration\\\": {},\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [\\n        {\\n          \\\"action\\\": \\\"pr.issuePullRequest\\\",\\n          \\\"when\\\": \\\"true\\\"\\n        }\\n      ]\\n    }\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"@octokit/rest\\\": \\\"^16.26.0\\\",\\n    \\\"@types/diff\\\": \\\"^4.0.2\\\",\\n    \\\"@types/diff-match-patch\\\": \\\"^1.0.32\\\",\\n    \\\"diff\\\": \\\"^4.0.1\\\",\\n    \\\"diff-match-patch\\\": \\\"^1.0.4\\\",\\n    \\\"jest-fetch-mock\\\": \\\"^2.1.2\\\"\\n  },\\n  \\\"description\\\": \\\"Issues pull request to your code host (GitHub supported currently)\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/prettierrc\\\": \\\"^3.0.1\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^4.0.0\\\",\\n    \\\"@sourcegraph/tslint-config\\\": \\\"^13.2.0\\\",\\n    \\\"@types/jest\\\": \\\"^24.0.13\\\",\\n    \\\"jest\\\": \\\"^24.8.0\\\",\\n    \\\"jest-cli\\\": \\\"^24.8.0\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^0.5.1\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.12.3\\\",\\n    \\\"prettier\\\": \\\"^1.17.1\\\",\\n    \\\"sourcegraph\\\": \\\"^23.0.1\\\",\\n    \\\"ts-jest\\\": \\\"^24.0.2\\\",\\n    \\\"tslint\\\": \\\"^5.16.0\\\",\\n    \\\"typescript\\\": \\\"^3.4.5\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/pull-request\\\",\\n  \\\"jest\\\": {\\n    \\\"automock\\\": false,\\n    \\\"setupFiles\\\": [\\n      \\\"./setupJest.js\\\"\\n    ]\\n  },\\n  \\\"license\\\": \\\"MIT\\\",\\n  \\\"main\\\": \\\"dist/pull-request.js\\\",\\n  \\\"name\\\": \\\"pull-request\\\",\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# Issue pull requests from Sourcegraph codemod/diff views.\\\\n\\\\nThe fields below can be set in your configuration. If they are not set, and do not have a sensible default, you'll get an input prompt when issuing a PR (e.g., for a GH access token, author name, etc.). While the PR title and commit will probably differ, it's a good idea to set the things that likely won't change:\\\\n\\\\n```\\\\n  \\\\\\\"pr.gitHubAccessToken\\\\\\\": \\\\\\\"\\\\u003cGitHub token\\\\u003e\\\\\\\",\\\\n  \\\\\\\"pr.authorName\\\\\\\": \\\\\\\"Rijnard van Tonder\\\\\\\",\\\\n  \\\\\\\"pr.authorEmail\\\\\\\": \\\\\\\"rvantonder@gmail.com\\\\\\\",\\\\n  \\\\\\\"pr.description\\\\\\\": \\\\\\\"\\\\\\\",\\\\n``` \\\\n\\\\n```ts\\\\nexport interface Overrides {\\\\n    /**\\\\n     * An input box is prompted if not specified.\\\\n     */\\\\n    'pr.gitHubAccessToken': string\\\\n\\\\n    /**\\\\n     * An input box is prompted if not specified.\\\\n     */\\\\n    'pr.title': string\\\\n\\\\n    /**\\\\n     * An input box is prompted if not specified.\\\\n     */\\\\n    'pr.description': string\\\\n\\\\n    /**\\\\n     * An input box is prompted if not specified.\\\\n     */\\\\n    'pr.authorName': string\\\\n\\\\n    /**\\\\n     * An input box is prompted if not specified.\\\\n     */\\\\n    'pr.authorEmail': string\\\\n\\\\n    /**\\\\n     * E.g., my-pr-branch. An input box is prompted if not specified.\\\\n     */\\\\n    'pr.sourceBranch': string\\\\n\\\\n    /**\\\\n     * Default is 'master' if not specified.\\\\n     */\\\\n    'pr.destinationBranch': string\\\\n\\\\n    /**\\\\n     * A PR is a draft by default. Set this to false to issue real PRs.\\\\n     */\\\\n    'pr.isDraft': boolean\\\\n\\\\n    /**\\\\n     * Override sourcegraph URL (useful to for testing against Docker hosts).\\\\n     */\\\\n    'pr.sourcegraphUrl': string\\\\n}\\\\n```\\\\n\\\",\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/pull-request.js src/pull-request.ts\\\",\\n    \\\"prettier\\\": \\\"prettier '**/{*.{js?(on),ts?(x),graphql,md,scss},.*.js?(on)}' --write --list-different --config prettier.config.js\\\",\\n    \\\"prettier-check\\\": \\\"npm run prettier -- --write=false\\\",\\n    \\\"serve\\\": \\\"npm run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --out-file dist/pull-request.js src/pull-request.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"npm run build\\\",\\n    \\\"symlink-package\\\": \\\"mkdirp dist \\\\u0026\\\\u0026 lnfs ./package.json ./dist/package.json\\\",\\n    \\\"test\\\": \\\"jest\\\",\\n    \\\"test:coverage\\\": \\\"jest --coverage\\\",\\n    \\\"test:watch\\\": \\\"jest --watch\\\",\\n    \\\"tslint\\\": \\\"tslint -p tsconfig.json './src/**/*.ts'\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"tags\\\": [],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/2882-sourcegraph-pull-request.js?bvdmec6zvsx4--sourcegraph-pull-request\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\",\\n  \\\"wip\\\": true\\n}\",\"description\":\"Issues pull request to your code host (GitHub supported currently)\"},\"createdAt\":\"2019-07-08T05:18:41Z\",\"updatedAt\":\"2019-07-08T05:18:41Z\",\"url\":\"/extensio