t.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"tags\\\": [],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/8551-wolfychu-testing.js?c5myr461jf8w--wolfychu-testing\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\"\\n}\",\"description\":\"testing\"},\"createdAt\":\"2020-09-14T08:45:44Z\",\"updatedAt\":\"2020-09-14T08:45:44Z\",\"url\":\"/extensions/wolfychu/testing\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyODJ9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjIxNzU=\",\"name\":\"TurkDevOps-sourcegraph\",\"displayName\":\"TurkDevOps\",\"url\":\"/organizations/TurkDevOps-sourcegraph\"},\"extensionID\":\"TurkDevOps-sourcegraph/devturks\",\"extensionIDWithoutRegistry\":\"TurkDevOps-sourcegraph/devturks\",\"name\":\"devturks\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/8608-TurkDevOps-sourcegraph-devturks.js?c5ub06zieydc--TurkDevOps-sourcegraph-devturks\\\"\\n}\",\"description\":null},\"createdAt\":\"2020-09-22T23:56:47Z\",\"updatedAt\":\"2020-09-22T23:56:47Z\",\"url\":\"/extensions/TurkDevOps-sourcegraph/devturks\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyODN9\",\"publisher\":{\"__typename\":\"User\",\"id\":\"VXNlcjoyNDc1NQ==\",\"username\":\"suusha13409486\",\"displayName\":\"suusha13409486\",\"url\":\"/users/suusha13409486\"},\"extensionID\":\"suusha13409486/suusha\",\"extensionIDWithoutRegistry\":\"suusha13409486/suusha\",\"name\":\"suusha\",\"manifest\":{\"raw\":\"{\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/8617-suusha13409486-suusha.js?c5v19vlk9pew--suusha13409486-suusha\\\"\\n}\",\"descript