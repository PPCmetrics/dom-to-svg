\"},\"extensionID\":\"sourcegraph/sonarqube\",\"extensionIDWithoutRegistry\":\"sourcegraph/sonarqube\",\"name\":\"sonarqube\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/main/client/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [\\n    \\\"External services\\\"\\n  ],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [\\n      {\\n        \\\"actionItem\\\": {\\n          \\\"description\\\": \\\"${get(context, 'sonarqube.errorMessage') || (config.sonarqube.showIssuesOnCodeViews \\\\u0026\\\\u0026 \\\\\\\"Hide inline Sonarqube issues\\\\\\\" || \\\\\\\"Show inline Sonarqube issues\\\\\\\")}\\\",\\n          \\\"iconURL\\\": \\\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' viewBox='0 0 512 512'%3E%3Cdefs/%3E%3Crect width='512' height='512' fill='%23${get(context, 'sonarqube.errorMessage') \\\\u0026\\\\u0026 \\\\\\\"999\\\\\\\" || \\\\\\\"549dd0\\\\\\\"}'/%3E%3Cdefs%3E%3Crect id='a' y='0' width='512' height='512'/%3E%3C/defs%3E%3CclipPath id='b'%3E%3Cuse xlink:href='%23a' overflow='visible'/%3E%3C/clipPath%3E%3Cpath d='M409 448h-22c0-179-148-325-330-325v-22c194 0 352 155 352 347' clip-path='url(%23b)' fill='%23fff'/%3E%3Cg%3E%3Cdefs%3E%3Crect id='c' y='0' width='512' height='512'/%3E%3C/defs%3E%3CclipPath id='d'%3E%3Cuse xlink:href='%23c' overflow='visible'/%3E%3C/clipPath%3E%3Cpath d='M424 329A335 335 0 00192 89l5-18a354 354 0 01245 253l-18 5z' clip-path='url(%23d)' fill='%23fff'/%3E%3C/g%3E%3Cg%3E%3Cdefs%3E%3Crect id='e' y='0' width='512' height='512'/%3E%3C/defs%3E%3CclipPath id='f'%3E%3Cuse xlink:href='%23e' overflow='visible'/%3E%3C/clipPath%3E%3Cpath d='M441 223c-27-60-74-113-132-148l8-12c60 36 109 91 138 154l-14 6z' clip-path='url(%23f)' fill='%23fff'/%3E%3C/g%3E%3C/svg%3E\\\",\\n          \\\"pressed\\\": \\\"config.sonarqube.showIssuesOnCodeViews\\\"\\n        },\\n        \\\"category\\\": \\\"Sonarqube\\\",\\n        \\\"command\\\": \\\"updateConfiguration\\\",\\n        \\\"commandArguments\\\": [\\n          [\\n            \\\"sonarqube.showIssuesOnCodeViews\\\"\\n          ],\\n          \\\"${!(config.sonarqube.showIssuesOnCodeViews !== false)}\\\",\\n          null,\\n          \\\"json\\\"\\n        ],\\n        \\\"id\\\": \\\"sonarqube.showIssuesOnCodeViews.toggle\\\",\\n        \\\"title\\\": \\\"${get(context, 'sonarqube.errorMessage') || (config.sonarqube.showIssuesOnCodeViews \\\\u0026\\\\u0026 \\\\\\\"Hide inline Sonarqube issues\\\\\\\" || \\\\\\\"Show inline Sonarqube issues\\\\\\\")}\\\"\\n      }\\n    ],\\n    \\\"configuration\\\": {\\n      \\\"properties\\\": {\\n        \\\"sonarqube.apiToken\\\": {\\n          \\\"description\\\": \\\"The API authentication token for the Sonarqube instance, if needed.\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        },\\n        \\\"sonarqube.corsAnywhereUrl\\\": {\\n          \\\"default\\\": \\\"https://cors-anywhere.herokuapp.com\\\",\\n          \\\"description\\\": \\\"The URL to a CORS proxy.\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        },\\n        \\\"sonarqube.instanceUrl\\\": {\\n          \\\"default\\\": \\\"https://sonarcloud.io/\\\",\\n          \\\"description\\\": \\\"The URL to the Sonarqube instance.\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        },\\n        \\\"sonarqube.organizationKeyTemplate\\\": {\\n          \\\"default\\\": \\\"$1\\\",\\n          \\\"description\\\": \\\"Replace string to build the organization key from the repository name pattern, using $n references for capture groups. By default just uses the first capture group\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        },\\n        \\\"sonarqube.projectKeyTemplate\\\": {\\n          \\\"default\\\": \\\"$1_$2\\\",\\n          \\\"description\\\": \\\"Replace string to build the project key from the repository name pattern, using $n references for capture groups.\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        },\\n        \\\"sonarqube.repositoryNamePattern\\\": {\\n          \\\"default\\\": \\\"(?:^|/)([^/]+)/([^/]+)$\\\",\\n          \\\"description\\\": \\\"Regular expression with that is matched on the repository name to extract the capture groups for organization and project key templates.\\\",\\n          \\\"format\\\": \\\"regex\\\",\\n          \\\"type\\\": \\\"string\\\"\\n        },\\n        \\\"sonarqube.showIssuesOnCodeViews\\\": {\\n          \\\"default\\\": true,\\n          \\\"description\\\": \\\"Whether to show Sonarqube issues inline on code views.\\\",\\n          \\\"type\\\": \\\"boolean\\\"\\n        }\\n      },\\n      \\\"type\\\": \\\"object\\\"\\n    },\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [],\\n      \\\"editor/title\\\": [\\n        {\\n          \\\"action\\\": \\\"sonarqube.showIssuesOnCodeViews.toggle\\\",\\n          \\\"when\\\": \\\"resource\\\"\\n        }\\n      ]\\n    }\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"rxjs\\\": \\\"^6.6.3\\\"\\n  },\\n  \\\"description\\\": \\\"Show Sonarqube issues when browsing files on Sourcegraph\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/eslint-config\\\": \\\"^0.20.11\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^4.0.1\\\",\\n    \\\"eslint\\\": \\\"^7.11.0\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^1.0.4\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.12.4\\\",\\n    \\\"sourcegraph\\\": \\\"^24.7.0\\\",\\n    \\\"typescript\\\": \\\"^4.0.3\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/sonarqube\\\",\\n  \\\"icon\\\": \\\"data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' viewBox='0 0 512 512'%3E%3Cdefs/%3E%3Crect width='512' height='512' fill='%23549dd0'/%3E%3Cdefs%3E%3Crect id='a' y='0' width='512' height='512'/%3E%3C/defs%3E%3CclipPath id='b'%3E%3Cuse xlink:href='%23a' overflow='visible'/%3E%3C/clipPath%3E%3Cpath d='M409 448h-22c0-179-148-325-330-325v-22c194 0 352 155 352 347' clip-path='url(%23b)' fill='%23fff'/%3E%3Cg%3E%3Cdefs%3E%3Crect id='c' y='0' width='512' height='512'/%3E%3C/defs%3E%3CclipPath id='d'%3E%3Cuse xlink:href='%23c' overflow='visible'/%3E%3C/clipPath%3E%3Cpath d='M424 329A335 335 0 00192 89l5-18a354 354 0 01245 253l-18 5z' clip-path='url(%23d)' fill='%23fff'/%3E%3C/g%3E%3Cg%3E%3Cdefs%3E%3Crect id='e' y='0' width='512' height='512'/%3E%3C/defs%3E%3CclipPath id='f'%3E%3Cuse xlink:href='%23e' overflow='visible'/%3E%3C/clipPath%3E%3Cpath d='M441 223c-27-60-74-113-132-148l8-12c60 36 109 91 138 154l-14 6z' clip-path='url(%23f)' fill='%23fff'/%3E%3C/g%3E%3C/svg%3E\\\",\\n  \\\"license\\\": \\\"Apache-2.0\\\",\\n  \\\"main\\\": \\\"dist/sonarqube.js\\\",\\n  \\\"name\\\": \\\"sonarqube\\\",\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# [Sonarqube](https://www.sonarqube.org/) Sourcegraph extension\\\\n\\\\nShow Sonarqube issues when browsing files on Sourcegraph.\\\\n\\\\n\\\\u003cp\\\\u003e\\\\n\\\\u003cpicture\\\\u003e\\\\n\\\\u003csource srcset=\\\\\\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph-sonarqube/main/images/screenshot_dark.png\\\\\\\" media=\\\\\\\"(prefers-color-scheme: dark)\\\\\\\"\\\\u003e\\\\n\\\\u003csource srcset=\\\\\\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph-sonarqube/main/images/screenshot_light.png\\\\\\\" media=\\\\\\\"(prefers-color-scheme: light)\\\\\\\"\\\\u003e\\\\n\\\\u003cimg src=\\\\\\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph-sonarqube/main/images/screenshot_light.png\\\\\\\" alt=\\\\\\\"Screenshot\\\\\\\"\\\\u003e\\\\n\\\\u003c/picture\\\\u003e\\\\n\\\\u003c/p\\\\u003e\\\\n\\\\n➡️ Try it out on [github.com/apache/struts](https://sourcegraph.com/github.com/apache/struts/-/blob/apps/rest-showcase/src/main/java/org/demo/rest/example/OrdersController.java)\\\\n\\\\nYou can toggle decorations with the Sonarqube button in the action toolbar.\\\\nEach decoration links to the issue on Sonarqube.\\\\n\\\\n## Configuration\\\\n\\\\nThe extension can be configured through JSON in user, organization or global settings.\\\\n\\\\n```jsonc\\\\n{\\\\n  // Configure the extension to use a private Sonarqube instance.\\\\n  // By default, Sonarcloud is used.\\\\n  \\\\\\\"sonarqube.instanceUrl\\\\\\\": \\\\\\\"https://sonarcloud.io/\\\\\\\",\\\\n  // An API token to the Sonarqube instance, if needed.\\\\n  \\\\\\\"sonarqube.apiToken\\\\\\\": \\\\\\\"...\\\\\\\",\\\\n\\\\n  // The Sonarqube extension needs to map the repository on Sourcegraph to a project inside an organization on\\\\n  // Sonarqube. The default settings work for most projects on Sonarcloud, but if you have a custom setup, you\\\\n  // can configure the following settings.\\\\n\\\\n  // This regular expression is matched on the repository name. The values from the capture groups are\\\\n  // available in the templates below.\\\\n  \\\\\\\"sonarqube.repositoryNamePattern\\\\\\\": \\\\\\\"(?:^|/)([^/]+)/([^/]+)$\\\\\\\",\\\\n  // This template is used to form the Sonarqube organization key.\\\\n  // By default, the second-last part of the repository name (first capture group above) is used as-is.\\\\n  // E.g. \\\\\\\"apache\\\\\\\" from \\\\\\\"github.com/apache/struts\\\\\\\".\\\\n  \\\\\\\"sonarqube.organizationKeyTemplate\\\\\\\": \\\\\\\"$1\\\\\\\",\\\\n  // This template is used to form the Sonarqube project key.\\\\n  // By default, the second-last and last part of the repository name (first and second capture groups above)\\\\n  // are joined by an underscore.\\\\n  // E.g. \\\\\\\"apache_struts\\\\\\\" from \\\\\\\"github.com/apache/struts\\\\\\\".\\\\n  \\\\\\\"sonarqube.projectKeyTemplate\\\\\\\": \\\\\\\"$1_$2\\\\\\\",\\\\n\\\\n  // CORS headers are necessary for the extension to fetch data, but Sonarqube does not send them by default.\\\\n  // Here you can customize the URL to an HTTP proxy that adds CORS headers.\\\\n  // By default Sourcegraph's CORS proxy is used.\\\\n  \\\\\\\"sonarqube.corsAnywhereUrl\\\\\\\": \\\\\\\"https://cors-anywhere.herokuapp.com\\\\\\\"\\\\n}\\\\n```\\\\n\\\\n## Limitations\\\\n\\\\nThe current commit viewed on Sourcegraph may not be analyzed on Sonarqube.\\\\nIf that is the case, the extension will fallback to the latest analysis available on Sonarqube on the default branch.\\\\nThis may result in decorations being off in some files if those files differ between the commit being viewed and the one analyzed on Sonarqube.\\\\n\\\\n---\\\\n\\\\nSONARQUBE is a trademark belonging to SonarSource SA.\\\\n\\\",\\n  \\\"repository\\\": {\\n    \\\"type\\\": \\\"git\\\",\\n    \\\"url\\\": \\\"https://github.com/sourcegraph/sourcegraph-sonarqube\\\"\\n  },\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/sonarqube.js src/sonarqube.ts --no-minify\\\",\\n    \\\"eslint\\\": \\\"eslint 'src/**/*.ts'\\\",\\n    \\\"serve\\\": \\\"yarn run symlink-package \\\\u0026\\\\u0026 parcel serve --no-hmr --out-file dist/sonarqube.js src/sonarqube.ts\\\",\\n    \\\"sourcegraph:prepublish\\\": \\\"yarn run typecheck \\\\u0026\\\\u0026 yarn run build\\\",\\n    \\\"symlink-package\\\": \\\"mkdirp dist \\\\u0026\\\\u0026 lnfs ./package.json ./dist/package.json\\\",\\n    \\\"typecheck\\\": \\\"tsc -p tsconfig.json\\\",\\n    \\\"watch:build\\\": \\\"tsc -p tsconfig.dist.json -w\\\",\\n    \\\"watch:typecheck\\\": \\\"tsc -p tsconfig.json -w\\\"\\n  },\\n  \\\"tags\\\": [\\n    \\\"Sonarqube\\\"\\n  ],\\n  \\\"url\\\": \\\"https://sourcegraph.com/-/static/extension/8830-sourcegraph-sonarqube.js?c6ihtxq92siw--sourcegraph-sonarqube\\\",\\n  \\\"version\\\": \\\"0.0.0-DEVELOPMENT\\\",\\n  \\\"wip\\\": false\\n}\",\"description\":\"Show Sonarqube issues when browsing files on Sourcegraph\"},\"createdAt\":\"2020-10-16T21:55:13Z\",\"updatedAt\":\"2020-10-16T21:55:13Z\",\"url\":\"/extensions/sourcegraph/sonarqube\",\"remoteURL\":null,\"registryName\":\"\",\"isLocal\":true,\"isWorkInProgress\":false,\"viewerCanAdminister\":false},{\"id\":\"UmVnaXN0cnlFeHRlbnNpb246eyJsIjoyOTF9\",\"publisher\":{\"__typename\":\"Org\",\"id\":\"T3JnOjE=\",\"name\":\"sourcegraph\",\"displayName\":\"Sourcegraph\",\"url\":\"/organizations/sourcegraph\"},\"extensionID\":\"sourcegraph/link-preview-expander\",\"extensionIDWithoutRegistry\":\"sourcegraph/link-preview-expander\",\"name\":\"link-preview-expander\",\"manifest\":{\"raw\":\"{\\n  \\\"$schema\\\": \\\"https://raw.githubusercontent.com/sourcegraph/sourcegraph/main/client/shared/src/schema/extension.schema.json\\\",\\n  \\\"activationEvents\\\": [\\n    \\\"*\\\"\\n  ],\\n  \\\"browserslist\\\": [\\n    \\\"last 1 Chrome versions\\\",\\n    \\\"last 1 Firefox versions\\\",\\n    \\\"last 1 Edge versions\\\",\\n    \\\"last 1 Safari versions\\\"\\n  ],\\n  \\\"categories\\\": [],\\n  \\\"contributes\\\": {\\n    \\\"actions\\\": [],\\n    \\\"configuration\\\": {\\n      \\\"linkPreviewExpander.corsAnywhereUrl\\\": {\\n        \\\"default\\\": \\\"https://cors-anywhere.herokuapp.com\\\",\\n        \\\"description\\\": \\\"The URL to a CORS proxy.\\\",\\n        \\\"type\\\": \\\"string\\\"\\n      }\\n    },\\n    \\\"menus\\\": {\\n      \\\"commandPalette\\\": [],\\n      \\\"editor/title\\\": []\\n    }\\n  },\\n  \\\"dependencies\\\": {\\n    \\\"node-html-parser\\\": \\\"^1.3.1\\\"\\n  },\\n  \\\"description\\\": \\\"Hyperlinks URLs and provides hover previews\\\",\\n  \\\"devDependencies\\\": {\\n    \\\"@sourcegraph/eslint-config\\\": \\\"^0.20.11\\\",\\n    \\\"@sourcegraph/extension-api-stubs\\\": \\\"^1.2.2\\\",\\n    \\\"@sourcegraph/tsconfig\\\": \\\"^4.0.1\\\",\\n    \\\"@types/mocha\\\": \\\"^8.0.3\\\",\\n    \\\"@types/mock-require\\\": \\\"^2.0.0\\\",\\n    \\\"eslint\\\": \\\"^7.11.0\\\",\\n    \\\"lnfs-cli\\\": \\\"^2.1.0\\\",\\n    \\\"mkdirp\\\": \\\"^1.0.4\\\",\\n    \\\"mocha\\\": \\\"^5.2.0\\\",\\n    \\\"mock-require\\\": \\\"^3.0.3\\\",\\n    \\\"parcel-bundler\\\": \\\"^1.12.4\\\",\\n    \\\"sinon\\\": \\\"^9.2.0\\\",\\n    \\\"source-map-support\\\": \\\"^0.5.19\\\",\\n    \\\"sourcegraph\\\": \\\"^24.7.0\\\",\\n    \\\"ts-node\\\": \\\"^9.0.0\\\",\\n    \\\"typescript\\\": \\\"^4.0.3\\\"\\n  },\\n  \\\"extensionID\\\": \\\"sourcegraph/link-preview-expander\\\",\\n  \\\"license\\\": \\\"Apache-2.0\\\",\\n  \\\"main\\\": \\\"dist/link-preview-expander.js\\\",\\n  \\\"name\\\": \\\"link-preview-expander\\\",\\n  \\\"nyc\\\": {\\n    \\\"exclude\\\": [\\n      \\\"**/*.test.ts?(x)\\\",\\n      \\\"**/*.d.ts\\\",\\n      \\\"**/*.js\\\"\\n    ],\\n    \\\"extension\\\": [\\n      \\\".tsx\\\",\\n      \\\".ts\\\"\\n    ],\\n    \\\"include\\\": [\\n      \\\"src/**/*.ts?(x)\\\"\\n    ]\\n  },\\n  \\\"publisher\\\": \\\"sourcegraph\\\",\\n  \\\"readme\\\": \\\"# link-preview-expander (Sourcegraph extension)\\\\n\\\\nlink-preview-expander displays metadata from Open Graph and Twitter meta tags when you hover over a link in code.\\\\n\\\\n\\\\u003cp\\\\u003e\\\\n\\\\u003cpicture\\\\u003e\\\\n\\\\u003csource srcset=\\\\\\\"https://user-images.githubusercontent.com/37420160/97129290-e2653380-1714-11eb-83df-110059690c5f.png\\\\\\\" media=\\\\\\\"(prefers-color-scheme: dark)\\\\\\\"\\\\u003e\\\\n\\\\u003csource srcset=\\\\\\\"https://user-images.githubusercontent.com/37420160/97129308-e98c4180-1714-11eb-90c1-90dc134d71b1.png\\\\\\\" media=\\\\\\\"(prefers-color-scheme: light)\\\\\\\"\\\\u003e\\\\n\\\\u003cimg src=\\\\\\\"https://user-images.githubusercontent.com/37420160/97129308-e98c4180-1714-11eb-90c1-90dc134d71b1.png\\\\\\\" alt=\\\\\\\"Screenshot\\\\\\\"\\\\u003e\\\\n\\\\u003c/picture\\\\u003e\\\\n\\\\u003c/p\\\\u003e\\\\n\\\",\\n  \\\"scripts\\\": {\\n    \\\"build\\\": \\\"parcel build --out-file dist/link-preview-expander.js src/link-preview-expander.ts\\\",\\n    \\\"