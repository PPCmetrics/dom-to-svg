{
	"compilerOptions": {
		"target": "ES2019",
		"module": "NodeNext",
		"moduleResolution": "nodenext",
		"forceConsistentCasingInFileNames": true,
		"outDir": "lib",
		"rootDir": "src",
		"sourceMap": true,
		"inlineSources": true,
		"declaration": true,
		"declarationMap": true,
		"esModuleInterop": true,
		"strict": true,
		"noUnusedLocals": true,
		"skipLibCheck": true,
		"skipDefaultLibCheck": true,
		"noUncheckedIndexedAccess": true,
	},
	"include": ["src/**/*"],
}
